\def\fancyqr@drawfixed{\fancyqr@drawpatterns\fancyqr@draw@block}
% draws #1 for every pattern that stays clear of the hidden rectangle
\newif\iffancyqr@cut@
\def\fancyqr@drawpatterns#1{%
   \def\fancyqr@fixed@action##1##2##3{\fancyqr@cut@false
      \iffancy@qr@cutout@
         \ifnum##1<\@do@y@max\relax\ifnum\numexpr##1+##3\relax>\numexpr\@do@y@min+\@ne\relax
         \ifnum##2<\@do@x@max\relax\ifnum\numexpr##2+##3\relax>\numexpr\@do@x@min+\@ne\relax
            \fancyqr@cut@true\fi\fi\fi\fi
      \fi
      \iffancyqr@cut@\else#1{##1}{##2}{##3}\fi}%
   \fancyqr@fixedpatterns}
% ... and the same core on its own, for a ring the tiles keep
\def\fancyqr@draw@core#1#2#3{%
   \fancyqr@gradient@row{\the\numexpr#1+(#3-\@ne)/\tw@\relax}%
   \fancyqr@ci=\numexpr#2+(#3-\@ne)/\tw@\relax
   \put(#2,\the\numexpr\@max@y-#1-#3+\@ne\relax){%
      \iffancyqr@inalign@\expandafter\fancyqr@aligncorecolor\else\expandafter\fancyqr@corecolor\fi{%
         \fancyqr@shape\fancyqr@effective@core{2}{\fpeval{#3-2}}\fillpath}%
   }%
}
\def\fancyqr@drawcores{\fancyqr@drawpatterns\fancyqr@draw@core}

% a style that calls \FancyQrDiagonals also gets \@upleft \@upright \@downleft
% \@downright
\let\FancyQrDiagonals\fancyqr@diag@true
