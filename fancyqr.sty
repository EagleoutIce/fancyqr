   \edef\@x{\strip@pt\dimexpr\wd\@tempboxa+6\p@}\edef\@y{\strip@pt\dimexpr\ht\@tempboxa+\dp\@tempboxa+6\p@}%
   \lower\dimexpr\dp\@tempboxa+3\p@\hbox{\begin{picture}(\@x,\@y)\color{black!5}\moveto(4,0)%
      \circlearc{\fpeval{\@x-4}}44{270}{360}\circlearc{\fpeval{\@x-4}}{\fpeval{\@y-4}}4{0}{90}%
      \circlearc4{\fpeval{\@y-4}}4{90}{180}\circlearc444{180}{270}\closepath\fillpath\end{picture}}%
   \kern-\dimexpr\@x\p@-3\p@\relax\box\@tempboxa\kern3\p@}}
\def\fancyqr@gal@one#1#2{\csname fancyqr@fig@d@#2\endcsname
   \edef\@tempc{\fancyqr@gal@b\fancyqr@gal@list}\expandafter\FancyQrGalleryAnchor\expandafter{\@tempc}{\fancyqr@rbox{\begin{tabular}{@{}c@{}}$\@for\fancyqr@gal@x:=\fancyqr@gal@list\do{%
      \ifx\fancyqr@gal@x\@empty\else\edef\fancyqr@gal@y{\fancyqr@gal@x}%
      \vcenter{\hbox{\fancyqr@gal@watch\FancyQrShowFigure*[#1]{\fancyqr@gal@y}}}\hskip.25em
      \vcenter{\hbox{\FancyQrShowPattern{\fancyqr@gal@y}}}\hskip.6em\fi}\hskip-.6em$\\[.3ex]
   \scriptsize\ttfamily\fancyqr@gal@b\ \fancyqr@gal@p{#2}%
   \ifx\fancyqr@gal@rel\@empty\ \fancyqr@gal@mark\fi\fancyqr@gal@since{fancyqr@fig@v@#2}\end{tabular}}}\hskip.8em plus .4em\relax}
% the default chance of a figure (in a code of 25 modules, where it depends on the size)
\def\fancyqr@gal@p#1{{\ifdefined\@max@x\else\def\@max@x{25}\fi
