\def\fancyqr@fig@place#1#2{\fancyqr@fig@enabled{#2}%
   \if@tempswa\expandafter\fancyqr@fig@place@\else\expandafter\@gobbletwo\fi{#1}{#2}}
\def\fancyqr@fig@place@#1#2{\fancyqr@fig@chance{#2}%
   \edef\fancyqr@fig@p{\fpeval{round(100*(\fancyqr@fig@pc))}}%
   \ifnum\fancyqr@fig@p>\z@
      \csname fancyqr@fig@d@#2\endcsname
      \expandafter\let\expandafter\fancyqr@fig@test\csname fancyqr@fig@t@#2\endcsname
      \edef\fancyqr@fig@rm{\the\numexpr\@max@y-\fancyqr@fig@h+\@ne}%
      \edef\fancyqr@fig@cm{\the\numexpr\@max@x-\fancyqr@fig@w+\@ne}%
      \fancyqr@fig@r\@ne \fancyqr@fig@rows
   \fi}
\def\fancyqr@fig@rows{%
   \ifnum\fancyqr@fig@r>\fancyqr@fig@rm\relax\else
      \fancyqr@fig@c\@ne \fancyqr@fig@cols
      \advance\fancyqr@fig@r\fancyqr@fig@sr\relax
      \expandafter\fancyqr@fig@rows\fi}
\def\fancyqr@fig@cols{%
   \ifnum\fancyqr@fig@c>\fancyqr@fig@cm\relax\else
      \ifnum\fancyqr@fig@hash\fancyqr@fig@s\fancyqr@fig@r\fancyqr@fig@c<\fancyqr@fig@p\relax
         \fancyqr@fig@test\fi
      \advance\fancyqr@fig@c\fancyqr@fig@sc\relax
      \expandafter\fancyqr@fig@cols\fi}
% the tiles around a figure take its modules for white, so they end cleanly
% against its outline
\def\fancyqr@fig@sides{%
   \ifcsname fancyqr@F@\the\numexpr\i-\@ne\relax @\the\j\endcsname\def\@up{0}\fi
   \ifcsname fancyqr@F@\the\i @\the\numexpr\j-\@ne\relax\endcsname\def\@left{0}\fi
   \ifcsname fancyqr@F@\the\i @\the\numexpr\j+\@ne\relax\endcsname\def\@right{0}\fi
   \ifcsname fancyqr@F@\the\numexpr\i+\@ne\relax @\the\j\endcsname\def\@down{0}\fi}

\def\fancyqr@modules{%
   \qr@for \i=\@ne to \@max@y by \@ne{%
      \fancyqr@gradient@row\i
      \qr@for \j=\@ne to \@max@x by \@ne{%
      \iffancy@qr@cutout@\qr@fancy@updateif\i\j\fi
      \iffancy@qr@do@print@
         \ifnum\qr@matrixentry\fancyqr@currprint{\the\i}{\the\j}=\qr@black\relax
            \iffancy@qr@cutout@\iffancy@qr@roundcut@
               \qr@fancy@clear@surround\fancyqr@currprint{\the\i}{\the\j}\fi\fi
            \edef\@up{\qr@matrixentry\fancyqr@currprint{\the\numexpr\the\i-\@ne}{\the\j}}%
            \edef\@left{\qr@matrixentry\fancyqr@currprint{\the\i}{\the\numexpr\the\j-\@ne}}%
            \edef\@right{\qr@matrixentry\fancyqr@currprint{\the\i}{\the\numexpr\the\j+\@ne}}%
            \edef\@down{\qr@matrixentry\fancyqr@currprint{\the\numexpr\the\i+\@ne}{\the\j}}%
            \iffancyqr@fig@\fancyqr@fig@sides\fi
            \iffancyqr@inner@\fancyqr@setinner\fi
            \iffancyqr@diag@\fancyqr@setdiag\fi
            \fancyqr@ci=\j
            \iffancyqr@fixedshape@
               \ifcsname fancyqr@skip@\the\i @\the\j\endcsname\else
                  \fancyqr@tilecolor{\GetPattern}\fi
            \else\iffancyqr@fixedmap@
               \ifcsname fancyqr@fix@\the\i @\the\j\endcsname
                  \ifcase\csname fancyqr@fix@\the\i @\the\j\endcsname
                  \or\fancyqr@fixedcolor{\GetPattern}\or\fancyqr@corecolor{\GetPattern}%
                  \or\fancyqr@alignringcolor{\GetPattern}\or\fancyqr@aligncorecolor{\GetPattern}\fi
               \else\fancyqr@tilecolor{\GetPattern}\fi
            \else\fancyqr@tilecolor{\GetPattern}\fi\fi
      \fi\fi
   }}%
}

