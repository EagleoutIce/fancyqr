   \@tempcnta\z@\@tempcntb\z@\count@\z@
   \def\@tempb{\@tfor\@tempa:=}\expandafter\expandafter\expandafter\@tempb\csname fancyqr@fig@pat@#1\endcsname\do{%
      \if/\@tempa\advance\@tempcnta\@ne\@tempcntb\z@\else\advance\@tempcntb\@ne
         \ifnum\@tempcntb>\count@\count@\@tempcntb\fi\fi}%
   \edef\fancyqr@gal@h{\the\numexpr\@tempcnta+1}%
   \begin{picture}(\count@,\fancyqr@gal@h)\@tempcnta\z@\@tempcntb\z@
   \def\@tempb{\@tfor\@tempa:=}\expandafter\expandafter\expandafter\@tempb\csname fancyqr@fig@pat@#1\endcsname\do{%
      \if/\@tempa\advance\@tempcnta\@ne\@tempcntb\z@\else
         \put(\the\@tempcntb,\the\numexpr\fancyqr@gal@h-\@tempcnta-1){\fancyqr@gal@cell\@tempa}%
