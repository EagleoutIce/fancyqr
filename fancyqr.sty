      \edef\@tempb{\noexpand\fancyqr[extras=\fancyqr@gal@e,\ifin@\else figures=none,\fi background=,size=2.5cm,seed=4,#1]}%
      \@tempb{https://github.com/EagleoutIce/fancyqr}\\[.3ex]\scriptsize\ttfamily
      \edef\@tempc{\expandafter\fancyqr@gal@base\fancyqr@gal@e/\@nil,\fancyqr@gal@e}\expandafter\FancyQrGalleryAnchor\expandafter{\@tempc}\fancyqr@gal@e\fancyqr@gal@since{fancyqr@ex@v@\fancyqr@gal@e}\end{tabular}\hskip.8em plus .4em\relax}%
