\RequirePackage{pict2e, xfp, qrcode}

% the gradient is affine in the module coordinates: trigonometry once per code,
% the row part once per row, a multiply-add per module
\newdimen\fancyqr@grad@a \newdimen\fancyqr@grad@b \newdimen\fancyqr@grad@c
\newdimen\fancyqr@grad@row \newdimen\fancyqr@grad@t
\newcount\fancyqr@grad@n \newcount\fancyqr@ci

% g(i,j) = a*j + b*i + c for
%   ((j-hx)*cos-(i-hy)*sin+hx)/mx*50 + ((j-hx)*sin+(i-hy)*cos+hy)/my*50
\def\fancyqr@gradient@setup{%
   \edef\fancyqr@grad@cos{\fpeval{cosd(\fancyqr@gradient@angle+225)}}% 0 to the right
   \edef\fancyqr@grad@sin{\fpeval{sind(\fancyqr@gradient@angle+225)}}%
   \fancyqr@grad@a=\fpeval{50*(\fancyqr@grad@cos/\@max@x+\fancyqr@grad@sin/\@max@y)}\p@
   \fancyqr@grad@b=\fpeval{50*(\fancyqr@grad@cos/\@max@y-\fancyqr@grad@sin/\@max@x)}\p@
   \fancyqr@grad@c=\fpeval{%
      50*(\@half@max@x*(1-\fancyqr@grad@cos)+\@half@max@y*\fancyqr@grad@sin)/\@max@x
     +50*(\@half@max@y*(1-\fancyqr@grad@cos)-\@half@max@x*\fancyqr@grad@sin)/\@max@y}\p@
}
\def\fancyqr@gradient@row#1{%
   \fancyqr@grad@row=\fancyqr@grad@b \multiply\fancyqr@grad@row#1\relax
   \advance\fancyqr@grad@row\fancyqr@grad@c
}
% #1 column, result in \fancyqr@grad@n
\def\fancyqr@gradient@col#1{%
   \fancyqr@grad@t=\fancyqr@grad@a \multiply\fancyqr@grad@t#1\relax
   \advance\fancyqr@grad@t\fancyqr@grad@row \advance\fancyqr@grad@t.5\p@% round
   \fancyqr@grad@n=\fancyqr@grad@t
   \divide\fancyqr@grad@n\@cclvi \divide\fancyqr@grad@n\@cclvi
   % a rotated gradient may leave the unit square, xcolor may not
   \ifnum\fancyqr@grad@n<\z@ \fancyqr@grad@n\z@\fi
   \ifnum\fancyqr@grad@n>100 \fancyqr@grad@n=100 \fi
}

% integral percentages: 101 mixtures parsed whenever the end colors change, not
% per module
\def\fancyqr@colorkey#1{\detokenize\expandafter\expandafter\expandafter{\csname\string\color@#1\endcsname}}
\def\fancyqr@gradient@cache{%
   \edef\fancyqr@grad@key{%
      \fancyqr@colorkey{qr@fancy@gradient@br}/\fancyqr@colorkey{qr@fancy@gradient@tl}}%
   \ifx\fancyqr@grad@key\fancyqr@grad@cached\else
      \global\let\fancyqr@grad@cached\fancyqr@grad@key
      \begingroup\globalcolorstrue
      \fancyqr@grad@n\z@
      \@whilenum\fancyqr@grad@n<101 \do{%
         \colorlet{fancyqr@g@\the\fancyqr@grad@n}%
            {qr@fancy@gradient@br!\the\fancyqr@grad@n!qr@fancy@gradient@tl}%
         \advance\fancyqr@grad@n\@ne}%
      \endgroup
   \fi
}
\let\fancyqr@grad@cached\relax
\def\@@fancyqr@color@gradient#1{%
   \fancyqr@gradient@col\fancyqr@ci
   \@declaredcolor{fancyqr@g@\the\fancyqr@grad@n}{#1}%
}
% \color{#1}, kept per mixture #1 and current color as xcolor parses a mixture
% slowly (unless xcolor transforms colors on display)
\def\fancyqr@mixcolor#1{%
   \edef\fancyqr@mix@key{fancyqr@mix@#1@\detokenize\expandafter{\XC@current@color}}%
   \ifblendcolors\let\fancyqr@mix@key\relax\fi
   \ifmaskcolors\let\fancyqr@mix@key\relax\fi
   \ifconvertcolorsU\let\fancyqr@mix@key\relax\fi
   \ifx\fancyqr@mix@key\relax \color{#1}%
   \else\ifcsname\fancyqr@mix@key\endcsname
      \expandafter\let\expandafter\XC@current@color\csname\fancyqr@mix@key\endcsname
      \edef\current@color{\XC@current@color}\XC@display\iffancyqr@faint@\color{.}\fi
   \else
      \color{#1}%
      \global\expandafter\let\csname\fancyqr@mix@key\endcsname\XC@current@color
   \fi\fi}
\newif\iffancyqr@faint@
\def\@@fancyqr@color@default#1{\@declaredcolor{qr@fancy@gradient@tl}{#1}}
\def\@@fancyqr@color@random#1{\pgfmathrandomitem{\@fancyqr@random@c@l@r}{@@fancyqr@@randomcol}\@declaredcolor{\@fancyqr@random@c@l@r}{#1}}
\let\FancyQrColor\@@fancyqr@color@default

\def\fancyqr@rounding@factor{.5}
\edef\fancyqr@rounding@other{\fpeval{1-\fancyqr@rounding@factor}}
% fillet radius for a corner enclosed by two neighbours but not by the diagonal
\def\fancyqr@overlap@factor{.045}% see \qrm below
\def\fancyqr@inner@factor{.25}
% the fillet arc is tangent to both edges it bridges; its legs reach past the
% tangent points by the tile overlap, so that no seam shows
\def\fancyqr@inner@setup{%
   \edef\fancyqr@inner@neg{\fpeval{-\fancyqr@inner@factor}}%
   \edef\fancyqr@inner@plus{\fpeval{1+\fancyqr@inner@factor}}%
   \let\fancyqr@inner@radius\fancyqr@inner@factor
   \edef\fancyqr@inner@in{\fpeval{\fancyqr@overlap@factor}}%
   \edef\fancyqr@inner@out{\fpeval{1-\fancyqr@overlap@factor}}%
}
\fancyqr@inner@setup
\def\fancyqr@inner@tl{0}\def\fancyqr@inner@tr{0}% set by \fancyqr@setinner
\def\fancyqr@inner@bl{0}\def\fancyqr@inner@br{0}
\newif\iffancyqr@inner@ % styles opt in, the lookups are not free
% a style may draw the modules more than once and switch on \fancyqr@pass
\def\fancyqr@passes{1}\newcount\fancyqr@pass
% styles opt in to the diagonal neighbours and to figures, see \FancyQrFigure
\newif\iffancyqr@diag@ \newif\iffancyqr@fig@ \newcount\fancyqr@fig@n \let\fancyqr@figures\@empty
\def\fancyqr@fig@reset{\let\fancyqr@figures\@empty\fancyqr@fig@n\z@\fancyqr@diag@false\fancyqr@fig@false}

% O 1 O
% 2 X 3
% O 4 O
% uses \@up\@left\@right\@down
% an undefined combination expands to \relax, i.e. draws nothing
\def\GetPattern{\csname qcc\@up\@left\@right\@down\endcsname}

\def\fancyqr@clap#1{\hb@xt@\z@{\hss#1\hss}}
\newdimen\fancyqr@edge@compensate \fancyqr@edge@compensate=.15\p@

% tiles overlap by a fraction of a module, so renderers leave no seams
\newif\iffancyqr@abscomp@
\def\qrm{\dimexpr\qr@modulesize+\fancyqr@edge@compensate\relax}
\long\def\qr@newpattern#1#2#3#4#5{%
\expandafter\def\csname qcc#1#2#3#4\endcsname{% scaling happens implicitly by the unitlength
   \put(\the\j,\the\numexpr\@max@y-\the\i){%
      \advance\unitlength by\fancyqr@edge@compensate\relax
      #5\fancyqr@decor@tile
   }}%
}

% #1 1 rounds the corner, 0 continues into a neighbour; #2 1 adds the fillet #7
% of an inner corner; #3 to #6 are the points of both cases
\def\fancyqr@corner#1#2#3#4#5#6#7{%
   \ifnum#1=\@ne \lineto#3\circlearc#4\fancyqr@rounding@factor#5%
   \else \lineto#6%
      \ifnum#2=\@ne #7\lineto#6\fi
   \fi}
% legs #1#2 and #7#8 around the arc about (#3,#4) from #5 to #6 degrees
\def\fancyqr@fillet#1#2#3#4#5#6#7#8{%
   \lineto#1\lineto#2\circlearc{#3}{#4}\fancyqr@inner@radius{#5}{#6}%
   \lineto#7\lineto#8}
\def\fancyqr@rounded@rect#1#2#3#4{%
   \ifnum#4=\@ne\relax \moveto(\fancyqr@rounding@factor,\z@)\else\moveto(\z@,\z@)\fi
   \fancyqr@corner#1\fancyqr@inner@br
      {(\fancyqr@rounding@other,\z@)}{{\fancyqr@rounding@other}{\fancyqr@rounding@factor}}{{270}{360}}%
      {(\@ne,\z@)}{\fancyqr@fillet{(\fancyqr@inner@out,\z@)}{(\fancyqr@inner@out,\fancyqr@inner@neg)}%
         \fancyqr@inner@plus\fancyqr@inner@neg{180}{90}%
         {(\fancyqr@inner@plus,\fancyqr@inner@in)}{(\@ne,\fancyqr@inner@in)}}%
   \fancyqr@corner#2\fancyqr@inner@tr
      {(\@ne,\fancyqr@rounding@other)}{{\fancyqr@rounding@other}{\fancyqr@rounding@other}}{{0}{90}}%
      {(\@ne,\@ne)}{\fancyqr@fillet{(\@ne,\fancyqr@inner@out)}{(\fancyqr@inner@plus,\fancyqr@inner@out)}%
         \fancyqr@inner@plus\fancyqr@inner@plus{270}{180}%
         {(\fancyqr@inner@out,\fancyqr@inner@plus)}{(\fancyqr@inner@out,\@ne)}}%
   \fancyqr@corner#3\fancyqr@inner@tl
      {(\fancyqr@rounding@factor,\@ne)}{{\fancyqr@rounding@factor}{\fancyqr@rounding@other}}{{90}{180}}%
      {(\z@,\@ne)}{\fancyqr@fillet{(\fancyqr@inner@in,\@ne)}{(\fancyqr@inner@in,\fancyqr@inner@plus)}%
         \fancyqr@inner@neg\fancyqr@inner@plus{360}{270}%
         {(\fancyqr@inner@neg,\fancyqr@inner@out)}{(\z@,\fancyqr@inner@out)}}%
   \fancyqr@corner#4\fancyqr@inner@bl
      {(\z@,\fancyqr@rounding@factor)}{{\fancyqr@rounding@factor}{\fancyqr@rounding@factor}}{{180}{270}}%
      {(\z@,\z@)}{\fancyqr@fillet{(\z@,\fancyqr@inner@in)}{(\fancyqr@inner@neg,\fancyqr@inner@in)}%
         \fancyqr@inner@neg\fancyqr@inner@neg{90}{0}%
         {(\fancyqr@inner@in,\fancyqr@inner@neg)}{(\fancyqr@inner@in,\z@)}}%
   \fancyqr@rounded@rect@close
}
\def\fancyqr@rounded@rect@close{\fillpath}

% [#3][#2]  the neighbourhood-to-corner table; #1 draws a tile from its four
% [#4][#1]  corner flags, so a style can reuse the shape
\def\FancyQrRoundedPatterns#1{%
\qr@newpattern0000{#1{1}{1}{1}{1}}% .
\qr@newpattern1000{#1{1}{0}{0}{1}}% | | - -
\qr@newpattern0001{#1{0}{1}{1}{0}}%
\qr@newpattern0100{#1{1}{1}{0}{0}}%
\qr@newpattern0010{#1{0}{0}{1}{1}}%
\qr@newpattern1100{#1{1}{0}{0}{0}}% bottom right
\qr@newpattern1010{#1{0}{0}{0}{1}}% bottom left
\qr@newpattern0101{#1{0}{1}{0}{0}}% top right
\qr@newpattern0011{#1{0}{0}{1}{0}}% top left
\qr@newpattern1001{#1{0}{0}{0}{0}}% straights, enclosed and t's
\qr@newpattern0110{#1{0}{0}{0}{0}}%
\qr@newpattern1111{#1{0}{0}{0}{0}}%
\qr@newpattern0111{#1{0}{0}{0}{0}}%
\qr@newpattern1011{#1{0}{0}{0}{0}}%
\qr@newpattern1101{#1{0}{0}{0}{0}}%
\qr@newpattern1110{#1{0}{0}{0}{0}}%
}
% the same table by the four neighbours instead of by the corners
\def\FancyQrSidePatterns#1{%
\qr@newpattern0000{#1{0}{0}{0}{0}}%
\qr@newpattern1000{#1{1}{0}{0}{0}}%
\qr@newpattern0001{#1{0}{0}{0}{1}}%
\qr@newpattern0100{#1{0}{1}{0}{0}}%
\qr@newpattern0010{#1{0}{0}{1}{0}}%
\qr@newpattern1100{#1{1}{1}{0}{0}}%
\qr@newpattern1010{#1{1}{0}{1}{0}}%
\qr@newpattern0101{#1{0}{1}{0}{1}}%
\qr@newpattern0011{#1{0}{0}{1}{1}}%
\qr@newpattern1001{#1{1}{0}{0}{1}}%
\qr@newpattern0110{#1{0}{1}{1}{0}}%
\qr@newpattern1111{#1{1}{1}{1}{1}}%
\qr@newpattern0111{#1{0}{1}{1}{1}}%
\qr@newpattern1011{#1{1}{0}{1}{1}}%
\qr@newpattern1101{#1{1}{1}{0}{1}}%
\qr@newpattern1110{#1{1}{1}{1}{0}}%
}
% the decorations other styles lend (see add=)
\def\fancyqr@decor@reset{\let\fancyqr@decor@tile\relax\let\fancyqr@decor@after\@empty
   \def\fancyqr@dt@list{}\def\fancyqr@added{,}}
\fancyqr@decor@reset
\let\fancyqr@style@undo\relax % see \FancyQrStyleSet
\let\fancyqr@fixed@extra\relax % a style may draw on top of the pattern shapes
\let\fancyqr@style@begin\relax % ... and prepare every code before its modules
\def\FancyQrLoadDefault{%
   \fancyqr@style@undo \def\fancyqr@passes{1}\let\fancyqr@fixed@extra\relax\let\fancyqr@style@begin\relax\fancyqr@fig@reset\fancyqr@decor@reset
   \fancyqr@inner@true % this style knows about inner corners
   \FancyQrRoundedPatterns\fancyqr@rounded@rect
}
\FancyQrLoadDefault % allows to reset the style after other loads
\def\@fancy@qr@default@name{default}

% options set with \FancyQrStyleSet are undone by the next style
\def\FancyQrStyleSet#1{%
\colorlet{fancyqr@sv@tl}{qr@fancy@gradient@tl}\colorlet{fancyqr@sv@br}{qr@fancy@gradient@br}%
\let\fancyqr@sv@fs\fancyqr@finder@style \let\fancyqr@sv@fk\fancyqr@finder@core
\let\fancyqr@sv@fc\fancyqr@finder@color \let\fancyqr@sv@cc\fancyqr@core@color
\let\fancyqr@sv@ft\fancyqr@finder@thickness \let\fancyqr@sv@fr\fancyqr@finder@radius
\let\fancyqr@sv@ac\fancyqr@align@color \let\fancyqr@sv@ak\fancyqr@aligncore@color
\let\fancyqr@sv@bg\fancyqr@background
\def\fancyqr@style@undo{%
   \colorlet{qr@fancy@gradient@tl}{fancyqr@sv@tl}\colorlet{qr@fancy@gradient@br}{fancyqr@sv@br}%
   \let\fancyqr@finder@style\fancyqr@sv@fs \let\fancyqr@finder@core\fancyqr@sv@fk
   \let\fancyqr@finder@color\fancyqr@sv@fc \let\fancyqr@core@color\fancyqr@sv@cc
   \let\fancyqr@finder@thickness\fancyqr@sv@ft \let\fancyqr@finder@radius\fancyqr@sv@fr
   \let\fancyqr@align@color\fancyqr@sv@ac \let\fancyqr@aligncore@color\fancyqr@sv@ak
   \let\fancyqr@background\fancyqr@sv@bg
   \fancyqr@finder@update \let\fancyqr@style@undo\relax}%
\fancyqrset{#1}}
\def\FancyQrLoad#1{%
\fancyqr@style@undo
\protected@edef\fancyqr@loaded@style{#1}%
\edef\fancyqr@stylesum{\fancyqr@sum{fancyqr-style-#1.code}}\def\fancyqr@stylestate{}\def\fancyqr@extras{}\def\fancyqr@since{}\def\fancyqr@style@since{}\def\fancyqr@ex@figs{}\let\fancyqr@hl@hook\relax%
\def\fancyqr@rounded@rect@close{\fillpath}%
\fancyqr@inner@false % a style has to ask for inner roundings
\def\fancyqr@passes{1}\let\fancyqr@fixed@extra\relax\let\fancyqr@style@begin\relax\fancyqr@fig@reset\fancyqr@decor@reset
\setkeys{fancyqr}{finder=inherit,finder core=auto}% the style owns the shapes
\let\@tmp\newpattern\let\newpattern\qr@newpattern\@bsphack\def\@@tmp{#1}%
\ifx\@@tmp\@fancy@qr@default@name\FancyQrLoadDefault\else
\expandafter\edef\csname pingu@lib@#1@atcode\endcsname{\the\catcode`\@}%
\catcode`\@=11\relax
\input{fancyqr-style-#1.code}%
\catcode`\@=\csname pingu@lib@#1@atcode\endcsname
\fi\@esphack\let\newpattern\@tmp\let\@tmp\relax}
\let\FancyQrInnerRoundings\fancyqr@inner@true
\let\FancyQrNoInnerRoundings\fancyqr@inner@false
% add=name: the decorations another style lends with \FancyQrLend, on top of
% the current style; its file is read for its macros only
\newif\iffancyqr@donor@
% \FancyQrLend{begin|tile|after|extras}{code}: tile code takes the four corner
% flags of \FancyQrRoundedPatterns and runs after each tile that is no figure
\def\FancyQrLend#1#2{\iffancyqr@donor@\csname fancyqr@lend@#1\endcsname{#2}\fi}
\def\fancyqr@lend@begin#1{\ifx\fancyqr@sv@begin\relax\let\fancyqr@sv@begin\@empty\fi\expandafter\def\expandafter\fancyqr@style@begin\expandafter{\fancyqr@sv@begin#1}%
   \let\fancyqr@sv@begin\fancyqr@style@begin}
\def\fancyqr@lend@tile#1{\expandafter\def\expandafter\fancyqr@dt@list\expandafter{\fancyqr@dt@list\do#1}%
   \let\fancyqr@decor@tile\fancyqr@dt@run}
\def\fancyqr@lend@after#1{\expandafter\def\expandafter\fancyqr@decor@after\expandafter{\fancyqr@decor@after#1}}
\def\fancyqr@lend@extras#1{\edef\fancyqr@extras{\ifx\fancyqr@extras\@empty\else\fancyqr@extras,\fi#1}%
   \@for\@tempa:=#1\do{\expandafter\let\csname fancyqr@ex@v@\@tempa\endcsname\fancyqr@since}}
\def\fancyqr@dt@run{\ifnum\fancyqr@pass=\fancyqr@passes\relax\ifcsname fancyqr@F@\the\i @\the\j\endcsname\else
   \edef\@tempa{{\ifnum\@right\@down=\z@1\else0\fi}{\ifnum\@up\@right=\z@1\else0\fi}%
      {\ifnum\@up\@left=\z@1\else0\fi}{\ifnum\@left\@down=\z@1\else0\fi}}%
   \expandafter\fancyqr@dt@do\@tempa\fi\fi}
\def\fancyqr@dt@do#1#2#3#4{\def\do##1{##1{#1}{#2}{#3}{#4}}\fancyqr@dt@list}
\def\fancyqr@donor@cs{\do\FancyQrRoundedPatterns\do\FancyQrSidePatterns\do\FancyQrInnerRoundings
   \do\FancyQrNoInnerRoundings\do\FancyQrDiagonals\do\FancyQrStyleSet\do\FancyQrPasses\do\FancyQrFigure
   \do\FancyQrExtras\do\FancyQrExtraNeedsFigures\do\fancyqr@fixed@extra\do\fancyqr@hl@hook
   \do\fancyqr@style@undo\do\fancyqr@since\do\newpattern}
\def\FancyQrAdd#1{\@for\@tempb:=#1\do{\ifx\@tempb\@empty\else\expandafter\fancyqr@add@one\expandafter{\@tempb}\fi}}
\def\fancyqr@add@one#1{\def\@tempa{#1}\edef\@tempc{\noexpand\in@{,#1,}{\fancyqr@added}}\@tempc
   \ifx\@tempa\fancyqr@loaded@style\in@true\fi
   \ifin@\else\edef\fancyqr@added{\fancyqr@added#1,}%
   \edef\fancyqr@stylesum{\fancyqr@stylesum+#1\fancyqr@sum{fancyqr-style-#1.code}}%
   \def\do##1{\expandafter\let\csname fancyqr@sv@\string##1\endcsname##1}\fancyqr@donor@cs
   \let\fancyqr@sv@begin\fancyqr@style@begin
   \let\FancyQrRoundedPatterns\@gobble\let\FancyQrSidePatterns\@gobble\let\FancyQrInnerRoundings\relax
   \let\FancyQrNoInnerRoundings\relax\let\FancyQrDiagonals\relax\let\FancyQrStyleSet\@gobble
   \let\FancyQrPasses\@gobble\def\FancyQrFigure{\@ifstar\@gobblefour\@gobblefour}\let\FancyQrExtras\@gobble
   \let\FancyQrExtraNeedsFigures\@gobble\let\fancyqr@style@undo\relax\let\newpattern\@gobblefive
   \fancyqr@donor@true\@bsphack
   \expandafter\edef\csname pingu@lib@#1@atcode\endcsname{\the\catcode`\@}\catcode`\@=11\relax
   \input{fancyqr-style-#1.code}%
   \catcode`\@=\csname pingu@lib@#1@atcode\endcsname\@esphack\fancyqr@donor@false
   \let\fancyqr@style@begin\fancyqr@sv@begin
   \def\do##1{\expandafter\let\expandafter##1\csname fancyqr@sv@\string##1\endcsname}\fancyqr@donor@cs\fi}
\define@key{fancyqr}{add}{\fancyqr@add{#1}}
\let\fancyqr@add\FancyQrAdd
\def\FancyQrPasses#1{\def\fancyqr@passes{#1}}


% undefined is white
