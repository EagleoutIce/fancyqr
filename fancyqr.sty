\def\qr@white{0}\def\qr@black{1}%
% the cut-out is centered on module (\@half@max@y,\@half@max@x), whose own
% center is half a module up and right of its origin
\def\fancyqr@drawimage{{\fancyqr@rec@image
   \put(\fpeval{\@half@max@x+.5},\fpeval{\@max@y-\@half@max@y+.5}){\fancyqr@image}}}
\def\fancyqr@image{\raisebox{\dimexpr-.5\height+.5\depth\relax}{\fancyqr@clap{\usebox\fancyqr@imgbox}}}
\def\fancyqr@draw{%
   \picture(\qr@minipagewidth,\qr@minipagewidth)(\fpeval{\@ne+\@tmp@tight-\fancyqr@bg@m},\fpeval{\@tmp@tight-\fancyqr@bg@m})
   \ifx\fancyqr@background\@empty\else\fancyqr@drawbg\fi
   \fancyqr@style@begin
   \ifx\fancyqr@figures\@empty\else\fancyqr@fig@scan\fi
   \fancyqr@pass\z@
   \loop \advance\fancyqr@pass\@ne \fancyqr@modules
   \ifnum\fancyqr@pass<\fancyqr@passes\relax\repeat
   \iffancyqr@fixedshape@\fancyqr@drawfixed\fancyqr@fixed@extra
   \else\iffancyqr@coreonly@\fancyqr@drawcores\fi\fi
   \fancyqr@decor@after
   \if@fancyqr@image@\fancyqr@drawimage\fi
   \endpicture
}

% --- persistence ---------------------------------------------------------------
% a drawn code is recorded as what it puts on the page: positions (\fancyqr@P),
% pict2e's literals (\fancyqr@L), color pushes and pops (\fancyqr@C, \fancyqr@Z)
% and the image (\fancyqr@I), in a file <prefix><key>.fqr whose name hashes all
% the code depends on; a later run replays the file instead of drawing the code.
% With externalize the record also becomes a pdf of its own, and the code is
% drawn into a box that is dropped once the pdf exists, so that a document with
% many codes never holds them all
\newif\iffancyqr@rec@ \newwrite\fancyqr@out \newbox\fancyqr@recbox
\let\fancyqr@key\relax \def\fancyqr@chain{} \def\fancyqr@stylestate{} \def\fancyqr@opts{} \def\fancyqr@stylesum{}
\def\fancyqr@w#1{\iffancyqr@rec@\immediate\write\fancyqr@out{#1}\fi}
\providecommand\fancyqr@loaded@style{default}
\begingroup\catcode`\[=1 \catcode`\]=2 \catcode`\{=12 \catcode`\}=12
\gdef\fancyqr@lb[{]\gdef\fancyqr@rb[}]\endgroup
\def\fancyqr@P#1#2#3{\raise#2\hb@xt@\z@{\kern#1#3\hss}}
\def\fancyqr@L#1{\pIIe@code{#1}}
\def\fancyqr@C#1{\begingroup\def\current@color{#1}\let\aftergroup\@gobble\set@color\endgroup}
\def\fancyqr@Z{\reset@color}
\def\fancyqr@I{\fancyqr@image}
\def\fancyqr@rec@image{\iffancyqr@rec@\fancyqr@w{\noexpand\fancyqr@P{\the\dimexpr\unitlength*(\@half@max@x*2+1)/2\relax}%
   {\the\dimexpr\unitlength*(\@max@y*2-\@half@max@y*2+1)/2\relax}{\noexpand\fancyqr@I}}\fancyqr@rec@false\fi}
% while recording, the hooks write what they draw
\long\def\fancyqr@rec@put(#1,#2)#3{\@killglue
   \@defaultunitsset\@tempdimc{#2}\unitlength\@tempdimb\@tempdimc
   \@defaultunitsset\@tempdimc{#1}\unitlength
   \fancyqr@w{\noexpand\fancyqr@P{\the\@tempdimc}{\the\@tempdimb}\fancyqr@lb}%
   \raise\@tempdimb\hb@xt@\z@{\kern\@tempdimc#3\hss}\fancyqr@w\fancyqr@rb\ignorespaces}
\def\fancyqr@rec@code#1{\edef\@tempa{#1}\fancyqr@w{\noexpand\fancyqr@L{\detokenize\expandafter{\@tempa}}}\fancyqr@code{#1}}
\def\fancyqr@rec@set{\fancyqr@w{\noexpand\fancyqr@C{\detokenize\expandafter{\current@color}}}\fancyqr@set}
\def\fancyqr@rec@reset{\fancyqr@w{\noexpand\fancyqr@Z}\fancyqr@reset}
\def\fancyqr@rec@on{\fancyqr@rec@true
   \let\fancyqr@code\pIIe@code\let\pIIe@code\fancyqr@rec@code
   \let\fancyqr@set\set@color\let\set@color\fancyqr@rec@set
   \let\fancyqr@reset\reset@color\let\reset@color\fancyqr@rec@reset
   \expandafter\let\csname put \endcsname\fancyqr@rec@put}
% a record file holds \fancyqr@replay{width}{x}{y}{items}
\long\def\fancyqr@replay#1#2#3#4{\picture(#1,#1)(#2,#3)#4\endpicture}
\def\fancyqr@input#1{\begingroup\makeatletter\endlinechar=-1 \@@input#1\relax\endgroup}
\def\fancyqr@include{\includegraphics[width=\qr@minipagewidth,height=\qr@minipagewidth]{\fancyqr@file.pdf}}
\define@boolkey{fancyqr}[fancyqr@]{persist}[true]{}
\define@boolkey{fancyqr}[fancyqr@]{externalize}[true]{}
\define@key{fancyqr}{externalize prefix}{\def\fancyqr@ext@prefix{#1}}
\def\fancyqr@ext@prefix{\jobname-fqr-}
\ExplSyntaxOn
\cs_generate_variant:Nn \str_mdfive_hash:n { e }
\edef\fancyqr@pkgsum{\file_mdfive_hash:n{fancyqr.sty}}
\def\fancyqr@sum#1{\file_mdfive_hash:n{#1}}
\def\fancyqr@makekey{%
   \xdef\fancyqr@chain{\str_mdfive_hash:e{\fancyqr@chain|\detokenize\expandafter{\fancyqr@opts}|
      \detokenize\expandafter{\qr@texttoencode}|\fancyqr@loaded@style|\fancyqr@pkgsum|\fancyqr@stylesum|
      \the\qr@desiredheight|\the\fancyqr@edge@compensate|\ifqr@tight t\fi|\fancyqr@colorkey{qr@fancy@gradient@tl}|
      \fancyqr@colorkey{qr@fancy@gradient@br}|\fancyqr@gradient@angle|\if@fancyqr@gradient g\fi|
      \fancyqr@finder@style|\fancyqr@finder@core|\fancyqr@finder@color|\fancyqr@core@color|\fancyqr@content@color|
      \fancyqr@align@color|\fancyqr@aligncore@color|\fancyqr@timing@color|\fancyqr@finder@thickness|\fancyqr@finder@radius|
      \fancyqr@background|\fancyqr@bg@radius|\fancyqr@bg@margin|\fancyqr@rounding@factor|\fancyqr@inner@factor|
      \fancy@qr@donotprint@center@x|\fancy@qr@donotprint@center@y|\fancy@qr@donotprint@center@r|
      \if@fancyqr@image@\the\wd\fancyqr@imgbox/\the\ht\fancyqr@imgbox/\the\dp\fancyqr@imgbox\fi|
      \fancyqr@fig@only|\fancyqr@fig@off|\fancyqr@fig@chs|\fancyqr@fig@at@|\fancyqr@ex@only|\fancyqr@ex@off|\iffancyqr@faint@ f\fi|\fancyqr@stylestate}}%
   \let\fancyqr@key\fancyqr@chain}
% a code is drawn the same however often its record is used: the random numbers
% after it only depend on its key
\cs_generate_variant:Nn \int_from_hex:n { e }
\def\fancyqr@reseed{\FancyQrSeed{\int_from_hex:e{\str_range:Nnn\fancyqr@key{1}{7}}}}
\def\fancyqr@ext@run{\sys_if_shell_unrestricted:TF
   {\sys_shell_now:x{\c_sys_engine_format_str\space -interaction=batchmode~\fancyqr@file.tex}}
   {\PackageWarningNoLine{fancyqr}{Run~`\c_sys_engine_format_str\space\fancyqr@file.tex',~or~
      compile~with~-shell-escape,~to~externalize~a~code}}}
\ExplSyntaxOff
\def\fancyqr@persist@draw{%
   \let\fancyqr@key\relax
   \iffancyqr@persist\if@fancyqr@randomcolor@\else\fancyqr@makekey\fi\fi
   \ifx\fancyqr@key\relax\fancyqr@draw\else
      \edef\fancyqr@file{\fancyqr@ext@prefix\fancyqr@key}%
      \@tempswafalse
      \iffancyqr@externalize\if@fancyqr@image@\else\ifdefined\includegraphics\@tempswatrue\fi\fi\fi
      \if@tempswa\IfFileExists{\fancyqr@file.pdf}{\fancyqr@include}{\fancyqr@persist@rec}%
      \else\IfFileExists{\fancyqr@file.fqr}{\fancyqr@input{\fancyqr@file.fqr}}{\fancyqr@persist@rec}\fi
      \fancyqr@reseed
