   \fancyqr@ci=\numexpr#2+(#3-\@ne)/\tw@\relax
   \edef\@fq@t{\fpeval{\fancyqr@finder@thickness/2}}%
   \put(#2,\the\numexpr\@max@y-#1-#3+\@ne\relax){%
      \iffancyqr@inalign@\expandafter\fancyqr@alignringcolor\else\expandafter\fancyqr@fixedcolor\fi{%
         \linethickness{\fancyqr@finder@thickness\unitlength}%
         \fancyqr@shape\fancyqr@finder@style\@fq@t{\fpeval{#3-\@fq@t}}\strokepath}%
      \iffancyqr@inalign@\expandafter\fancyqr@aligncorecolor\else\expandafter\fancyqr@corecolor\fi{%
         \fancyqr@shape\fancyqr@effective@core{2}{\fpeval{#3-2}}\fillpath}%
   }%
