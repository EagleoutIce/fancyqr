}

% record the alignment patterns of every code, also of those `qrcode' prints
% on the first run
\let\fancyqr@orig@aligns\qr@placealignmentpatterns
\def\qr@placealignmentpatterns#1{%
   \gdef\fancyqr@alignlist{}%
   \begingroup
      \let\fancyqr@orig@align\qr@placealignmentpattern@int
