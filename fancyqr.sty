   \iffancyqr@gal@grid\kern-#4\FancyQrFigureModule{\unitlength\FancyQrFigureModule\color{black!18}\linethickness{.2pt}%
   \begin{picture}(#4,#3)\@tempcnta\z@\@whilenum\@tempcnta<\numexpr#4+1\relax\do{\moveto(\the\@tempcnta,0)\lineto(\the\@tempcnta,#3)\advance\@tempcnta\@ne}%
   \@tempcnta\z@\@whilenum\@tempcnta<\numexpr#3+1\relax\do{\moveto(0,\the\@tempcnta)\lineto(#4,\the\@tempcnta)\advance\@tempcnta\@ne}\strokepath\end{picture}}\fi}
