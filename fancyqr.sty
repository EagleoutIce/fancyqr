   \let\fancyqr@gal@mix\fancyqr@mixcolor\def\fancyqr@mixcolor##1{\fancyqr@gal@note{##1}\fancyqr@gal@mix{##1}}%
   \let\fancyqr@gal@col\color\def\color{\@ifnextchar[\fancyqr@gal@colm\fancyqr@gal@coln}%
   \aftergroup\fancyqr@gal@settle}
