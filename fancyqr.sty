\newcount\c@fancy@a \newcount\c@fancy@b
\def\fancy@qr@writedata#1#2{%
  % #1 the prepared matrix, #2 its bits as 0s and 1s
  \expandafter\c@fancy@a\the\numexpr\qr@numberofrowsinmatrix{#1}\relax
  \expandafter\c@fancy@b\the\numexpr\qr@numberofcolsinmatrix{#1}\relax
  \def\fancy@qr@writemat{#1}%
  \c@qr@i\@ne \c@qr@j\z@
  % the bits are read off the input one at a time, so the time stays linear
  \edef\qr@datatowrite{#2}%
  \expandafter\fancy@qr@writebit\qr@datatowrite\fancy@qr@writestop
}
\def\fancy@qr@writebit#1{%
  % #1 the bit for position (qr@i,qr@j)
  \advance\c@qr@j\@ne
  \ifnum#1=1
    \qr@storetomatrix\fancy@qr@writemat{\number\c@qr@i}{\number\c@qr@j}{\qr@black}%
  \else
    \qr@storetomatrix\fancy@qr@writemat{\number\c@qr@i}{\number\c@qr@j}{\qr@white}%
  \fi
  \ifnum\c@qr@j<\c@fancy@b\else \c@qr@j\z@ \advance\c@qr@i\@ne \fi
  \ifnum\c@qr@i>\c@fancy@a \expandafter\fancy@qr@writeend\else\expandafter\fancy@qr@writebit\fi
}%
\def\fancy@qr@writeend#1\fancy@qr@writestop{\c@qr@i\c@fancy@a \c@qr@j\c@fancy@b}

% each matrix is kept under a name derived from its content
\def\fancy@qr@printsavedbinarymatrix#1{%
   \iffancyqr@cache
      \edef\fancyqr@currmat{fq@\qr@texttoencode @\qr@version @\qr@level}%
   \else
      \def\fancyqr@currmat{@tmp}%
      \global\expandafter\let\csname @tmp@numrows\endcsname\@undefined
   \fi
   \ifcsname\fancyqr@currmat @numrows\endcsname
      \expandafter\let\expandafter\fancyqr@alignlist
         \csname fancyqr@align@\fancyqr@currmat\endcsname
   \else
      \def\qr@binarystring{#1\relax\relax}%
      \expandafter\fancy@qr@setup\expandafter{\fancyqr@currmat}%
      \expandafter\fancy@qr@writedata\expandafter{\fancyqr@currmat}{\qr@binarystring}%
      \global\expandafter\let\csname fancyqr@align@\fancyqr@currmat\endcsname
         \fancyqr@alignlist
   \fi
   \expandafter\fancy@qr@printmatrix\expandafter{\fancyqr@currmat}%
}%

