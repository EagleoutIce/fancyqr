\newif\iffancy@qr@do@print@
% the bounds are inclusive, so without a cut-out the center module must stay
\newif\iffancy@qr@cutout@
\def\qr@fancy@updateif#1#2{\fancy@qr@do@print@true
\ifdim\fancy@qr@donotprint@center@r\p@>\z@
   \ifnum#1>\@do@y@min\relax \ifnum#1<\@do@y@max\relax \ifnum#2>\@do@x@min\relax \ifnum#2<\@do@x@max\relax
      \ifdim\fpeval{max(abs(#2-\@half@max@x)-\@max@rcx,0)^2+max(abs(#1-\@half@max@y)-\@max@rcy,0)^2}\p@<\@max@rcrad\p@
         \fancy@qr@do@print@false
      \fi
   \fi\fi\fi\fi
\else
\ifnum#1>\@do@y@min\relax \ifnum#1<\@do@y@max\relax \ifnum#2>\@do@x@min\relax \ifnum#2<\@do@x@max\relax \fancy@qr@do@print@false \fi\fi\fi\fi\fi
}

\newif\iffancy@qr@roundcut@
\fancy@qr@roundcut@true
\let\FancyQrHardCut\fancy@qr@roundcut@false
\let\FancyQrRoundCut\fancy@qr@roundcut@true

\def\qr@fancy@clear@surround#1#2#3{%
   \qr@fancy@updateif{\the\numexpr#2-1}{#3}%
   \iffancy@qr@do@print@\else \expandafter\let\csname #1@\the\numexpr#2-1 @#3\endcsname\@undefined \fi
   \qr@fancy@updateif{\the\numexpr#2+1}{#3}%
   \iffancy@qr@do@print@\else \expandafter\let\csname #1@\the\numexpr#2+1 @#3\endcsname\@undefined \fi
   \qr@fancy@updateif{#2}{\the\numexpr#3-1}%
   \iffancy@qr@do@print@\else \expandafter\let\csname #1@#2@\the\numexpr#3-1\endcsname\@undefined \fi
   \qr@fancy@updateif{#2}{\the\numexpr#3+1}%
   \iffancy@qr@do@print@\else \expandafter\let\csname #1@#2@\the\numexpr#3+1\endcsname\@undefined \fi
}

% only look up a diagonal if both of its neighbours are black
\def\fancyqr@inner@check#1#2#3{%
   \edef\@tmp{\qr@matrixentry\fancyqr@currprint{#1}{#2}}%
   \ifnum\@tmp=\qr@white\relax \def#3{1}\fi
}
\def\fancyqr@setinner{% uses \@up\@left\@right\@down and the counters \i \j
   \def\fancyqr@inner@tl{0}\def\fancyqr@inner@tr{0}%
   \def\fancyqr@inner@bl{0}\def\fancyqr@inner@br{0}%
   \ifnum\@up=\qr@black\relax
      \ifnum\@left=\qr@black\relax
         \fancyqr@inner@check{\the\numexpr\i-\@ne\relax}{\the\numexpr\j-\@ne\relax}\fancyqr@inner@tl\fi
      \ifnum\@right=\qr@black\relax
         \fancyqr@inner@check{\the\numexpr\i-\@ne\relax}{\the\numexpr\j+\@ne\relax}\fancyqr@inner@tr\fi
   \fi
   \ifnum\@down=\qr@black\relax
      \ifnum\@left=\qr@black\relax
         \fancyqr@inner@check{\the\numexpr\i+\@ne\relax}{\the\numexpr\j-\@ne\relax}\fancyqr@inner@bl\fi
      \ifnum\@right=\qr@black\relax
         \fancyqr@inner@check{\the\numexpr\i+\@ne\relax}{\the\numexpr\j+\@ne\relax}\fancyqr@inner@br\fi
   \fi
}

% position patterns follow from the size, alignment patterns are recorded while
% `qrcode' places them (\fancy@qr@setup)
\newif\iffancyqr@fixed@      % the patterns are treated specially at all
\newif\iffancyqr@fixedshape@ % ... drawn as one shape instead of as modules
\newif\iffancyqr@fixedmap@   % ... only recolored, which needs a module map
\newif\iffancyqr@coreonly@   % ... left to the tiles except for their core
\def\fancyqr@finder@style{inherit}
\def\fancyqr@finder@core{auto}
\def\fancyqr@finder@color{}
\def\fancyqr@core@color{}  % the center block, defaults to \fancyqr@finder@color
\def\fancyqr@content@color{}% the data modules, i.e. everything but the patterns
\def\fancyqr@align@color{}    % the alignment patterns, default \fancyqr@finder@color
\def\fancyqr@aligncore@color{}% ... and their cores
\def\fancyqr@timing@color{}   % the dotted lines between the finder patterns
\newif\iffancyqr@inalign@     % the pattern at hand is an alignment pattern
\def\fancyqr@finder@radius{.5}   % corner radius, relative to the pattern
\def\fancyqr@finder@thickness{1}% ring width in modules
\def\fancyqr@star@ratio{.55}    % inner/outer radius of a star core
\def\fancyqr@star@boost{1.27}   % ... which is a single module on an alignment
                                % pattern and reads too small at that size
\gdef\fancyqr@alignlist{}
\def\fancyqr@do#1#2{}
\newif\iffancyqr@alignstyled@ % alignment patterns follow the position ones
\fancyqr@alignstyled@true
\newif\iffancyqr@alignhide@   % ... or are not drawn at all

\def\fancyqr@finder@none{none}\def\fancyqr@finder@auto{auto}
\def\fancyqr@finder@inherit{inherit}
% `inherit' (or `none') leaves the patterns to the tiles of the style; patterns
% colored apart from the data need a map of their modules
\def\fancyqr@finder@update{%
   \fancyqr@fixedshape@true
   \ifx\fancyqr@finder@style\fancyqr@finder@none\fancyqr@fixedshape@false\fi
   \ifx\fancyqr@finder@style\fancyqr@finder@inherit\fancyqr@fixedshape@false\fi
   \fancyqr@fixedmap@false \fancyqr@coreonly@false
   \iffancyqr@fixedshape@\else
      \ifx\fancyqr@finder@color\@empty\else\fancyqr@fixedmap@true\fi
      \ifx\fancyqr@content@color\@empty\else\fancyqr@fixedmap@true\fi
      \ifx\fancyqr@core@color\@empty\else\fancyqr@fixedmap@true\fi
      \ifx\fancyqr@align@color\@empty\else\fancyqr@fixedmap@true\fi
      \ifx\fancyqr@aligncore@color\@empty\else\fancyqr@fixedmap@true\fi
      % a core asked for by name is drawn even when the ring keeps its tiles
      \ifx\fancyqr@finder@core\fancyqr@finder@auto\else
         \ifx\fancyqr@finder@core\fancyqr@finder@inherit\else
            \fancyqr@coreonly@true\fi\fi
   \fi
   \iffancyqr@fixedshape@\fancyqr@fixed@true
   \else\iffancyqr@fixedmap@\fancyqr@fixed@true
      \else\iffancyqr@coreonly@\fancyqr@fixed@true\else\fancyqr@fixed@false\fi\fi\fi
   \iffancyqr@alignhide@\fancyqr@fixed@true\fi
}

% applies \fancyqr@fixed@action{top row}{left column}{size} to every pattern
\def\fancyqr@fixedpatterns{%
   \edef\fancyqr@fix@last{\the\numexpr\@max@x-6\relax}%
   \fancyqr@fixed@action{1}{1}{7}%
   \fancyqr@fixed@action{1}{\fancyqr@fix@last}{7}%
   \fancyqr@fixed@action{\fancyqr@fix@last}{1}{7}%
   \iffancyqr@alignstyled@\let\fancyqr@do\fancyqr@fixed@align \fancyqr@alignlist\fi
}
\def\fancyqr@fixed@align#1#2{\fancyqr@inalign@true
   \fancyqr@fixed@action{\the\numexpr#1-2\relax}{\the\numexpr#2-2\relax}{5}\fancyqr@inalign@false}

% walks the modules (#1,#2)--(#1+#3-1,#2+#4-1) applying \fancyqr@rect@action
\def\fancyqr@rect#1#2#3#4{%
   \qr@for \fancyqr@mi=#1 to \the\numexpr#1+#3-\@ne\relax by \@ne{%
      \qr@for \fancyqr@mj=#2 to \the\numexpr#2+#4-\@ne\relax by \@ne{%
         \fancyqr@rect@action}}%
}
\def\fancyqr@cell{\fancyqr@currprint @\the\fancyqr@mi @\the\fancyqr@mj}
% a module of a pattern that keeps its tiles is marked 1 (ring) or 2 (core), or 3
% and 4 in an alignment pattern
\def\fancyqr@mark{\iffancyqr@inalign@\let\@tempa\thr@@\else\let\@tempa\@ne\fi
   \global\expandafter\let\csname fancyqr@fix@\the\fancyqr@mi @\the\fancyqr@mj\endcsname\@tempa}
\def\fancyqr@markcore{\iffancyqr@inalign@\let\@tempa\fancyqr@four\else\let\@tempa\tw@\fi
   \global\expandafter\let\csname fancyqr@fix@\the\fancyqr@mi @\the\fancyqr@mj\endcsname\@tempa}
\chardef\fancyqr@four=4
\def\fancyqr@unmark{\global\expandafter\let
   \csname fancyqr@fix@\the\fancyqr@mi @\the\fancyqr@mj\endcsname\@undefined}
% a shape replaces the modules of its pattern, which leave the matrix
\def\fancyqr@clear{\global\expandafter\let\csname\fancyqr@cell\endcsname\@undefined}
% the matrix is shared between codes, so anything cleared has to come back
\def\fancyqr@save{\global\expandafter\let
   \csname fancyqr@sv@\the\fancyqr@mi @\the\fancyqr@mj\expandafter\endcsname
   \csname\fancyqr@cell\endcsname}
\def\fancyqr@restore{\global\expandafter\let\csname\fancyqr@cell\expandafter\endcsname
   \csname fancyqr@sv@\the\fancyqr@mi @\the\fancyqr@mj\endcsname}
\def\fancyqr@saveclear{\fancyqr@save\fancyqr@clear}
% ... except along the straight part of a ring: those stay black, so that
% neighbours merge into the ring, but are not drawn
\def\fancyqr@keep{\fancyqr@restore\global\expandafter\let
   \csname fancyqr@skip@\the\fancyqr@mi @\the\fancyqr@mj\endcsname\@ne}
\def\fancyqr@unkeep{\global\expandafter\let
   \csname fancyqr@skip@\the\fancyqr@mi @\the\fancyqr@mj\endcsname\@undefined}
\def\fancyqr@finder@square{square}\def\fancyqr@finder@circle{circle}
% #1 top row, #2 left column, #3 size; the curve of the ring takes the first
% \fancyqr@em modules of every side
\def\fancyqr@edges#1#2#3{%
   \edef\fancyqr@em{%
      \ifx\fancyqr@finder@style\fancyqr@finder@square 0%
      \else\ifx\fancyqr@finder@style\fancyqr@finder@circle\the\numexpr(#3-1)/2\relax
      \else\fpeval{min(floor(#3/2),ceil(\fancyqr@finder@radius*(#3-\fancyqr@finder@thickness)/2
         +\fancyqr@finder@thickness/2-.001))}\fi\fi}%
   \edef\fancyqr@el{\the\numexpr#3-2*\fancyqr@em\relax}%
   \ifnum\fancyqr@el>\z@
      \fancyqr@rect{#1}{\the\numexpr#2+\fancyqr@em\relax}\@ne\fancyqr@el
      \fancyqr@rect{\the\numexpr#1+#3-\@ne\relax}{\the\numexpr#2+\fancyqr@em\relax}\@ne\fancyqr@el
      \fancyqr@rect{\the\numexpr#1+\fancyqr@em\relax}{#2}\fancyqr@el\@ne
      \fancyqr@rect{\the\numexpr#1+\fancyqr@em\relax}{\the\numexpr#2+#3-\@ne\relax}\fancyqr@el\@ne
   \fi}

\def\fancyqr@block#1#2#3{\fancyqr@rect{#1}{#2}{#3}{#3}}
% the core of a pattern: 3x3 modules in a finder, one in an alignment pattern
\def\fancyqr@core#1#2#3{%
   \fancyqr@rect{\the\numexpr#1+\tw@\relax}{\the\numexpr#2+\tw@\relax}%
      {\the\numexpr#3-4\relax}{\the\numexpr#3-4\relax}}
% a hidden alignment pattern is filled with a fixed scatter of modules
\def\fancyqr@camo{\fancyqr@save
   \global\expandafter\edef\csname\fancyqr@cell\endcsname{%
      \ifnum\numexpr\fancyqr@camo@n-7*((\fancyqr@camo@n-3)/7)<3 \qr@black\else\qr@white\fi}}
\def\fancyqr@camo@n{(3*\fancyqr@mi*\fancyqr@mi+5*\fancyqr@mj+\fancyqr@mi*\fancyqr@mj)}
\def\fancyqr@hidealign#1{\iffancyqr@alignhide@
   \let\fancyqr@rect@action#1\let\fancyqr@do\fancyqr@hidealign@do\fancyqr@alignlist\fi}
\def\fancyqr@hidealign@do#1#2{%
   \fancyqr@block{\the\numexpr#1-2\relax}{\the\numexpr#2-2\relax}{5}}
\def\fancyqr@markfixed{%
   \fancyqr@hidealign\fancyqr@camo
   \iffancyqr@fixedshape@
      \let\fancyqr@rect@action\fancyqr@saveclear
      \let\fancyqr@fixed@action\fancyqr@block \fancyqr@fixedpatterns
      \let\fancyqr@rect@action\fancyqr@keep
      \let\fancyqr@fixed@action\fancyqr@edges \fancyqr@fixedpatterns
   \else
      \iffancyqr@fixedmap@
         \let\fancyqr@rect@action\fancyqr@mark
         \let\fancyqr@fixed@action\fancyqr@block \fancyqr@fixedpatterns
         \let\fancyqr@rect@action\fancyqr@markcore
         \let\fancyqr@fixed@action\fancyqr@core \fancyqr@fixedpatterns
      \fi
      \iffancyqr@coreonly@
         \let\fancyqr@rect@action\fancyqr@saveclear
         \let\fancyqr@fixed@action\fancyqr@core \fancyqr@fixedpatterns\fi
   \fi}
\def\fancyqr@unmarkfixed{%
   \fancyqr@hidealign\fancyqr@restore
   \iffancyqr@fixedshape@
      \let\fancyqr@rect@action\fancyqr@unkeep
      \let\fancyqr@fixed@action\fancyqr@edges \fancyqr@fixedpatterns
      \let\fancyqr@rect@action\fancyqr@restore
      \let\fancyqr@fixed@action\fancyqr@block \fancyqr@fixedpatterns
   \else
      \iffancyqr@fixedmap@
         \let\fancyqr@rect@action\fancyqr@unmark
         \let\fancyqr@fixed@action\fancyqr@block \fancyqr@fixedpatterns\fi
      \iffancyqr@coreonly@
         \let\fancyqr@rect@action\fancyqr@restore
         \let\fancyqr@fixed@action\fancyqr@core \fancyqr@fixedpatterns\fi
   \fi}
% the round cut only ever clears modules inside the hidden rectangle; it keeps
% its own copy, as the patterns may have cleared some of them already
\def\fancyqr@cutsave{\global\expandafter\let
   \csname fancyqr@cv@\the\fancyqr@mi @\the\fancyqr@mj\expandafter\endcsname
   \csname\ifcsname\fancyqr@cell\endcsname\fancyqr@cell\else @undefined\fi\endcsname}
\def\fancyqr@cutrestore{\global\expandafter\let\csname\fancyqr@cell\expandafter\endcsname
   \csname fancyqr@cv@\the\fancyqr@mi @\the\fancyqr@mj\endcsname}
\def\fancyqr@cutrect#1{\let\fancyqr@rect@action#1%
   \fancyqr@rect{\the\numexpr\@do@y@min+\@ne\relax}{\the\numexpr\@do@x@min+\@ne\relax}%
      {\the\numexpr\@do@y@max-\@do@y@min-\@ne\relax}{\the\numexpr\@do@x@max-\@do@x@min-\@ne\relax}}

% both hoisted once per code, so a tile pays nothing for them
\def\fancyqr@colorsetup{%
   \ifx\fancyqr@finder@color\@empty \let\fancyqr@fixedcolor\FancyQrColor
   \else \def\fancyqr@fixedcolor##1{{\color{\fancyqr@finder@color}##1}}\fi
   \ifx\fancyqr@content@color\@empty \let\fancyqr@tilecolor\FancyQrColor
   \else \def\fancyqr@tilecolor##1{{\color{\fancyqr@content@color}##1}}\fi
   \ifx\fancyqr@core@color\@empty \let\fancyqr@corecolor\fancyqr@fixedcolor
   \else \def\fancyqr@corecolor##1{{\color{\fancyqr@core@color}##1}}\fi
   \ifx\fancyqr@align@color\@empty \let\fancyqr@alignringcolor\fancyqr@fixedcolor
      \let\fancyqr@aligncorecolor\fancyqr@corecolor
   \else \def\fancyqr@alignringcolor##1{{\color{\fancyqr@align@color}##1}}%
      \let\fancyqr@aligncorecolor\fancyqr@alignringcolor\fi
   \ifx\fancyqr@aligncore@color\@empty\else
      \def\fancyqr@aligncorecolor##1{{\color{\fancyqr@aligncore@color}##1}}\fi
   \ifx\fancyqr@timing@color\@empty\else
      \let\fancyqr@datacolor\fancyqr@tilecolor
      \def\fancyqr@tilecolor##1{\ifnum\fancyqr@ontiming=\@ne{\color{\fancyqr@timing@color}##1}\else\fancyqr@datacolor{##1}\fi}\fi
}
% 1 for a module of the timing patterns: row or column 7 between the finders
\def\fancyqr@ontiming{\ifnum\i=7 \fancyqr@between\j\@max@x\else\ifnum\j=7 \fancyqr@between\i\@max@y\else0\fi\fi}
% \FancyQrIfTiming{true}{false} in a tile: is it part of a timing pattern?
\def\FancyQrIfTiming{\ifnum\fancyqr@ontiming=\@ne\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
\def\fancyqr@between#1#2{\ifnum#1>8 \ifnum#1<\numexpr#2-7\relax1\else0\fi\else0\fi}

% a shape is a path inscribed in (#1,#1)--(#2,#2) closed by #3, so the same five
% macros serve the stroked ring and the filled core
\def\fancyqr@shape@none#1#2#3{}
% a core can be left to the tiles too, unless its ring is a shape
\let\fancyqr@shape@inherit\fancyqr@shape@none
\def\fancyqr@shape@square#1#2#3{\moveto(#1,#1)\lineto(#2,#1)\lineto(#2,#2)\lineto(#1,#2)\closepath#3}
\def\fancyqr@shape@circle#1#2#3{%
   \edef\@fq@c{\fpeval{(#1+#2)/2}}%
   \circlearc[1]\@fq@c\@fq@c{\fpeval{(#2-#1)/2}}{0}{360}\closepath#3}
\def\fancyqr@shape@rounded#1#2#3{%
   \roundjoin
   \edef\@fq@r{\fpeval{\fancyqr@finder@radius*(#2-#1)/2}}%
   \moveto(\fpeval{#1+\@fq@r},#1)%
   \lineto(\fpeval{#2-\@fq@r},#1)\circlearc{\fpeval{#2-\@fq@r}}{\fpeval{#1+\@fq@r}}\@fq@r{270}{360}%
   \lineto(#2,\fpeval{#2-\@fq@r})\circlearc{\fpeval{#2-\@fq@r}}{\fpeval{#2-\@fq@r}}\@fq@r{0}{90}%
   \lineto(\fpeval{#1+\@fq@r},#2)\circlearc{\fpeval{#1+\@fq@r}}{\fpeval{#2-\@fq@r}}\@fq@r{90}{180}%
   \lineto(#1,\fpeval{#1+\@fq@r})\circlearc{\fpeval{#1+\@fq@r}}{\fpeval{#1+\@fq@r}}\@fq@r{180}{270}%
   \closepath#3}
% a thinner star breaks the 1:1:3:1:1 run a scanner looks for
\def\fancyqr@shape@star#1#2#3{%
   \roundjoin
   \edef\@fq@c{\fpeval{(#1+#2)/2}}%
   \edef\@fq@ro{\fpeval{(#2-#1)/2*((#2-#1)<2 ? \fancyqr@star@boost : 1)}}%
   \edef\@fq@ri{\fpeval{\fancyqr@star@ratio*\@fq@ro}}%
   \moveto(\fpeval{\@fq@c+\@fq@ro},\@fq@c)%
   \@tempcnta=\z@
   \loop\advance\@tempcnta45\relax
      \edef\@fq@rr{\ifodd\numexpr\@tempcnta/45\relax \@fq@ri\else\@fq@ro\fi}%
      \lineto(\fpeval{\@fq@c+\@fq@rr*cosd(\@tempcnta)},\fpeval{\@fq@c+\@fq@rr*sind(\@tempcnta)})%
   \ifnum\@tempcnta<360\relax\repeat
   \closepath#3}

% three lobes and a stem, with darker grooves
\def\fancyqr@pumpkin@lobe#1#2#3#4{% center x, center y, half width, half height
   \moveto(\fpeval{#1+#3},#2)%
   \curveto(\fpeval{#1+#3},\fpeval{#2+.5523*#4})(\fpeval{#1+.5523*#3},\fpeval{#2+#4})(#1,\fpeval{#2+#4})%
   \curveto(\fpeval{#1-.5523*#3},\fpeval{#2+#4})(\fpeval{#1-#3},\fpeval{#2+.5523*#4})(\fpeval{#1-#3},#2)%
   \curveto(\fpeval{#1-#3},\fpeval{#2-.5523*#4})(\fpeval{#1-.5523*#3},\fpeval{#2-#4})(#1,\fpeval{#2-#4})%
   \curveto(\fpeval{#1+.5523*#3},\fpeval{#2-#4})(\fpeval{#1+#3},\fpeval{#2-.5523*#4})(\fpeval{#1+#3},#2)%
   \closepath}
\def\fancyqr@shape@pumpkin#1#2#3{%
   \edef\@fq@s{\fpeval{(#2-#1)*((#2-#1)<2 ? \fancyqr@star@boost : 1)}}%
   \edef\@fq@c{\fpeval{(#1+#2)/2}}%
   \edef\@fq@y{\fpeval{\@fq@c-.04*\@fq@s}}%
   \fancyqr@pumpkin@lobe{\fpeval{\@fq@c-.2*\@fq@s}}\@fq@y{\fpeval{.3*\@fq@s}}{\fpeval{.42*\@fq@s}}#3%
   \fancyqr@pumpkin@lobe{\fpeval{\@fq@c+.2*\@fq@s}}\@fq@y{\fpeval{.3*\@fq@s}}{\fpeval{.42*\@fq@s}}#3%
   \fancyqr@pumpkin@lobe\@fq@c\@fq@y{\fpeval{.28*\@fq@s}}{\fpeval{.45*\@fq@s}}#3%
   {\color{.!55!black}\linethickness{\fpeval{.05*\@fq@s}\unitlength}%
    \moveto(\fpeval{\@fq@c-.08*\@fq@s},\fpeval{\@fq@y+.33*\@fq@s})%
    \curveto(\fpeval{\@fq@c-.2*\@fq@s},\fpeval{\@fq@y+.1*\@fq@s})(\fpeval{\@fq@c-.2*\@fq@s},\fpeval{\@fq@y-.1*\@fq@s})(\fpeval{\@fq@c-.08*\@fq@s},\fpeval{\@fq@y-.33*\@fq@s})\strokepath
    \moveto(\fpeval{\@fq@c+.08*\@fq@s},\fpeval{\@fq@y+.33*\@fq@s})%
    \curveto(\fpeval{\@fq@c+.2*\@fq@s},\fpeval{\@fq@y+.1*\@fq@s})(\fpeval{\@fq@c+.2*\@fq@s},\fpeval{\@fq@y-.1*\@fq@s})(\fpeval{\@fq@c+.08*\@fq@s},\fpeval{\@fq@y-.33*\@fq@s})\strokepath
    \moveto(\fpeval{\@fq@c-.05*\@fq@s},\fpeval{\@fq@y+.36*\@fq@s})%
    \lineto(\fpeval{\@fq@c-.03*\@fq@s},\fpeval{\@fq@c+.5*\@fq@s})%
    \lineto(\fpeval{\@fq@c+.07*\@fq@s},\fpeval{\@fq@c+.47*\@fq@s})%
    \lineto(\fpeval{\@fq@c+.05*\@fq@s},\fpeval{\@fq@y+.36*\@fq@s})\closepath\fillpath}}

\def\fancyqr@shape#1#2#3#4{%
   \ifcsname fancyqr@shape@#1\endcsname
      \csname fancyqr@shape@#1\endcsname{#2}{#3}{#4}%
   \else
