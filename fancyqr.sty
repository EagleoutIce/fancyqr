% for every extra of the loaded style, a small code with faint tiles that only
% draws that one
\newcommand\FancyQrExtraGallery[1][]{\par\begingroup\centering\fancyqr@faint@true
   \@for\@tempa:=\fancyqr@extras\do{\begin{tabular}{@{}c@{}}%
