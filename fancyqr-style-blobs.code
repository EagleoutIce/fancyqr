% style `blobs': every module is an irregular round blob
% the directions of the twelve vertices, computed once
\@tempcnta=\z@
\loop\advance\@tempcnta by 30
   \expandafter\edef\csname fancyqr@blob@cos\the\@tempcnta\endcsname{\fpeval{cos(\@tempcnta)}}%
   \expandafter\edef\csname fancyqr@blob@sin\the\@tempcnta\endcsname{\fpeval{sin(\@tempcnta)}}%
\ifnum\@tempcnta<360\relax\repeat
\def\@fancy@qr@blobb{%
\@tempcnta=\z@
\roundjoin
\roundcap
\moveto(.5,.5)%
\loop
\advance\@tempcnta by 30
\edef\rad{\fpeval{.3+.2*abs(rand())}}%
\lineto(\fpeval{\csname fancyqr@blob@cos\the\@tempcnta\endcsname*\rad+.5},%
        \fpeval{\csname fancyqr@blob@sin\the\@tempcnta\endcsname*\rad+.5})%
\ifnum\@tempcnta<360\relax
\repeat
\fillpath
}%
\newpattern0000{\@fancy@qr@blobb}%
\newpattern1000{\@fancy@qr@blobb}%
\newpattern0001{\@fancy@qr@blobb}%
\newpattern0100{\@fancy@qr@blobb}%
\newpattern0010{\@fancy@qr@blobb}%
\newpattern1100{\@fancy@qr@blobb}%
\newpattern1010{\@fancy@qr@blobb}%
\newpattern0101{\@fancy@qr@blobb}%
\newpattern0011{\@fancy@qr@blobb}%
\newpattern1001{\@fancy@qr@blobb}%
\newpattern0110{\@fancy@qr@blobb}%
\newpattern1111{\@fancy@qr@blobb}%
\newpattern0111{\@fancy@qr@blobb}%
\newpattern1011{\@fancy@qr@blobb}%
\newpattern1101{\@fancy@qr@blobb}%
\newpattern1110{\@fancy@qr@blobb}%
\FancyQrStyleSet{finder=circle}%
