% Text beyond ASCII: the same UTF-8 bytes, ECI header and code on every engine.
\input{regression-test}
\documentclass{article}
\usepackage{fancyqr}
\usepackage{fancyqrtest}
\makeatletter
\hfuzz=\maxdimen \hbadness=10000 % the reports name engine-specific fonts
\ExplSyntaxOn
\cs_new:Npn \Bytes { \seq_use:Nn \l__fancyqr_codes_seq { , } }
\ExplSyntaxOff
% the code words of the next full code that is computed
\let\OrigSplit\qr@splitcodetextintoblocks
\def\qr@splitcodetextintoblocks{\xdef\GotVersion{\qr@version}\xdef\GotTotal{\qr@totaldatacodewords}\xdef\GotCode{\qr@codetext}\OrigSplit}
\begin{document}
\START
\section*{Unicode}

\begingroup
  \def\qr@texttoencode{Grüße, 東京 €}\fancyqr@bytes
  \TestValue{utf8-bytes}{71,114,195,188,195,159,101,44,32,230,157,177,228,186,172,32,226,130,172}{\Bytes}
  \TestValue{utf8-eci}{on}{\iffancyqr@useeci@ on\else off\fi}
\endgroup

% 13 bytes: version 1-M holds 14, but only 12 next to the header
\setbox\z@\hbox{\fancyqr[level=M]{äöüäöüa}}%
\TestValue{utf8-version}{2}{\GotVersion}
% raised to level Q at no cost: 22 data codewords, 17 of them used
\TestValue{utf8-codewords}{22: 71a40dc3a4c3b6c3bcc3a4c3b6c3bc6100ec11ec11ec}{\GotTotal: \GotCode}
\setbox\z@\hbox{\fancyqr[level=M,eci=false]{äöüäöüb}}%
\TestValue{utf8-without-eci}{1}{\GotVersion}
\setbox\z@\hbox{\fancyqr[level=M]{plain text}}%
\TestValue{ascii-without-eci}{4}{\expandafter\@car\GotCode\@nil}


\TestSummary
\END
\end{document}
