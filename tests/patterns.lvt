% Styling of the position (finder) and alignment patterns. `version=7' is fixed
% so that the code always has three position and six alignment patterns.
\input{regression-test}
\documentclass{article}
\usepackage{fancyqr}
\usepackage{fancyqrtest}
\makeatletter
\def\Code{\fancyqr[size=3cm,tight,version=7,color=black]{abc}}
\begin{document}
\START
\section*{Patterns}

\FancyQrLoad{default}
\fancyqrtest@run{\Code}\edef\Plain{\fancyqrtest@n{P}}

% `inherit' is the default and leaves the patterns to the tiles of the style
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder=inherit]{abc}}%
\edef\Inherited{\fancyqrtest@n{P}}
\TestValue{inherit-keeps-tiles}{same}{\ifx\Plain\Inherited same\else different\fi}
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder=none]{abc}}%
\edef\NoneStyle{\fancyqrtest@n{P}}
\TestValue{none-is-a-synonym}{same}{\ifx\Plain\NoneStyle same\else different\fi}

% recoloring alone must not change what is drawn
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder color=red]{abc}}%
\edef\Recolored{\fancyqrtest@n{P}}
\TestValue{color-only-keeps-tiles}{same}{\ifx\Plain\Recolored same\else different\fi}

% a shape replaces the 3*49+6*25 modules of the nine patterns by nine shapes
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder=circle]{abc}}%
\edef\Shaped{\fancyqrtest@n{P}}
\TestValue{shape-replaces-tiles}{fewer}{\ifnum\Shaped<\Plain fewer\else not\fi}
% three position plus six alignment patterns, each a stroked ring and a
% filled core
\TestValue{pattern-rings}{9}{\fancyqrtest@n{S}}
\TestValue{pattern-shapes}{18}{\fancyqrtest@n{Z}}

\TestCounts{finder-circle}{P=812 M=803 L=4947 A+=959 A-=347 C=0 F=812 S=9 Z=18 O=0 o=0}{%
  \fancyqr[size=3cm,tight,version=7,color=black,finder=circle]{abc}}
\TestCounts{finder-square}{P=812 M=821 L=4991 A+=888 A-=345 C=0 F=812 S=9 Z=18 O=0 o=0}{%
  \fancyqr[size=3cm,tight,version=7,color=black,finder=square]{abc}}
\TestCounts{finder-rounded}{P=812 M=821 L=5019 A+=1013 A-=347 C=0 F=812 S=9 Z=18 O=0 o=0}{%
  \fancyqr[size=3cm,tight,version=7,color=black,finder=rounded]{abc}}
\TestCounts{finder-star}{P=812 M=821 L=5055 A+=977 A-=347 C=0 F=812 S=9 Z=18 O=0 o=0}{%
  \fancyqr[size=3cm,tight,version=7,color=black,finder=rounded,finder core=star]{abc}}
\TestCounts{finder-mixed}{P=812 M=812 L=4964 A+=897 A-=345 C=0 F=812 S=9 Z=18 O=0 o=0}{%
  \fancyqr[size=3cm,tight,version=7,color=black,finder=square,finder core=circle]{abc}}

% a core shape on its own leaves the ring to the tiles and replaces only the
% 3*9+6*1 modules of the nine cores
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder core=star]{abc}}%
\edef\CoreOnly{\fancyqrtest@n{P}}
\TestValue{core-only-draws-cores}{9}{\fancyqrtest@n{Z}}
\TestValue{core-only-keeps-rings}{0}{\fancyqrtest@n{S}}
\TestValue{core-only-replaces-modules}{fewer}{\ifnum\CoreOnly<\Plain fewer\else not\fi}

% ... and `inherit' asks for exactly what the tiles do anyway
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder core=inherit]{abc}}%
\edef\CoreInherit{\fancyqrtest@n{P}}
\TestValue{core-inherit-keeps-tiles}{same}{\ifx\Plain\CoreInherit same\else different\fi}

% a core color recolors, it does not change what is drawn
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder core color=red]{abc}}%
\edef\CoreRecolored{\fancyqrtest@n{P}}
\TestValue{core-color-keeps-tiles}{same}{\ifx\Plain\CoreRecolored same\else different\fi}
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder=circle,finder core color=red]{abc}}%
\TestValue{core-color-keeps-shapes}{18}{\fancyqrtest@n{Z}}

% `alignment=inherit' leaves the six alignment patterns to the tiles
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder=circle,alignment=inherit]{abc}}%
\TestValue{alignment-inherit-rings}{3}{\fancyqrtest@n{S}}
\TestValue{alignment-inherit-shapes}{6}{\fancyqrtest@n{Z}}
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder core=star,alignment=inherit]{abc}}%
\TestValue{alignment-inherit-cores}{3}{\fancyqrtest@n{Z}}
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder=circle,alignment=finder]{abc}}%
\TestValue{alignment-finder-rings}{9}{\fancyqrtest@n{S}}

% `alignment=hide' drops the 6*25 alignment modules without drawing anything
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,finder=circle,alignment=hide]{abc}}%
\TestValue{alignment-hide-rings}{3}{\fancyqrtest@n{S}}
\TestValue{alignment-hide-shapes}{6}{\fancyqrtest@n{Z}}
\fancyqrtest@run{\fancyqr[size=3cm,tight,version=7,color=black,alignment=hide]{abc}}%
\edef\Hidden{\fancyqrtest@n{P}}
\TestValue{alignment-hide-drops-tiles}{fewer}{\ifnum\Hidden<\Plain fewer\else not\fi}

% the map is torn down again, so the next code is unaffected
\fancyqrtest@run{\Code}\edef\After{\fancyqrtest@n{P}}
\TestValue{map-is-cleared}{same}{\ifx\Plain\After same\else different\fi}

\TestSummary
\END
\end{document}
