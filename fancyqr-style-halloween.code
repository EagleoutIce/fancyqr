      \fancyqr@hw@var{27}\ifnum\fancyqr@hw@h<\fancyqr@hw@webs\relax\fancyqr@hw@web
      \xdef\fancyqr@hw@skip{\the\i/\the\numexpr\j+\@ne}\fi\fi\fi}
   \ifnum\@down=\z@\ifcsname fancyqr@F@\the\numexpr\i+\@ne\relax @\the\j\endcsname\else
      \edef\fancyqr@hw@here{\the\i/\the\j}\ifx\fancyqr@hw@here\fancyqr@hw@skip\else
      \FancyQrExtra{web/thread}{\ifnum\j<\@max@x\ifnum\fancyqr@hw@free{\i+\@ne}\j=\@ne\fancyqr@hw@var{28}%
         \ifnum\fancyqr@hw@h<\fancyqr@hw@threads\relax\fancyqr@hw@hang\fi\fi\fi}%
      \FancyQrExtra{slime}{\ifnum\i<\@max@y\ifnum\j<\@max@x\fancyqr@hw@spy\ifnum\count@=\z@\fancyqr@slime#1#4\fi\fi\fi}\fi\fi\fi}% no slime onto a figure, into the web left of it or onto the thread of a spider
% 1 if the thread of a big spider below reaches this tile
\def\fancyqr@hw@spy{\count@\@ne\fancyqr@hw@dn
   \ifcsname fancyqr@F@\the\numexpr\i+\count@\relax @\the\j\endcsname
      \expandafter\expandafter\expandafter\fancyqr@hw@isspy\csname fancyqr@F@\the\numexpr\i+\count@\relax @\the\j\endcsname
   \else\count@\z@\fi}%
\def\fancyqr@hw@isspy#1#2{\def\@tempa{#1}\count@\ifx\@tempa\fancyqr@hw@spn\@ne\else\z@\fi}\def\fancyqr@hw@spn{spider}%
\def\fancyqr@hw@dn{\ifnum\count@<8 \ifnum\fancyqr@hw@free{\i+\count@}\j=\@ne\advance\count@\@ne\expandafter\expandafter\expandafter\fancyqr@hw@dn\fi\fi}%
\gdef\fancyqr@hw@skip{}%
% 1 for a light module at row #1, column #2 (expressions) that no pattern,
% hole, web or thread takes
\def\fancyqr@hw@free#1#2{\ifnum\numexpr#1\relax<1 0\else\ifnum\numexpr#1\relax>\@max@y\space 0\else
   \ifnum\numexpr#2\relax<1 0\else\ifnum\numexpr#2\relax>\@max@x\space 0\else
   \ifnum\qr@matrixentry\fancyqr@currprint{\the\numexpr#1}{\the\numexpr#2}=\z@
   \ifcsname fancyqr@B@\the\numexpr#1\relax @\the\numexpr#2\endcsname0\else
   \ifcsname fancyqr@W@\the\numexpr#1\relax @\the\numexpr#2\endcsname0\else1\fi\fi\else0\fi\fi\fi\fi\fi}%
\def\fancyqr@hw@dark#1#2{\ifnum\numexpr#1\relax<1 0\else\ifnum\numexpr#1\relax>\@max@y\space 0\else
   \ifnum\numexpr#2\relax<1 0\else\ifnum\numexpr#2\relax>\@max@x\space 0\else
   \ifnum\qr@matrixentry\fancyqr@currprint{\the\numexpr#1}{\the\numexpr#2}=\@ne1\else0\fi\fi\fi\fi\fi}%
% the big spider hangs on a thread from the first tile up to six modules above
% it, over free light modules; \count@ ends as their number plus one, or 0
\def\fancyqr@hw@up{\ifnum\count@>6 \count@\z@\else
   \ifnum\fancyqr@hw@dark{\i-\count@}\j=\@ne
      \ifcsname fancyqr@F@\the\numexpr\i-\count@\relax @\the\j\endcsname\count@\z@\fi
   \else\ifnum\fancyqr@hw@free{\i-\count@}\j=\@ne\advance\count@\@ne\expandafter\expandafter\expandafter\fancyqr@hw@up
   \else\count@\z@\fi\fi\fi}%
% the number of free light modules below, up to three, counted into \count@
\def\fancyqr@hw@kfree{\ifnum\count@<3 \ifnum\fancyqr@hw@free{\i+\numexpr\count@+1}\j=\@ne
   \advance\count@\@ne \expandafter\fancyqr@hw@kfree\fi\fi}%
% a thread that hangs from the lower edge of a tile into the light modules
% below (up to three, by the place), beside their centers, with a small spider
% at its end; not where a corner web may hang
\def\fancyqr@hw@hang{\ifnum\fancyqr@hw@dark\i{\j-\@ne}\fancyqr@hw@dark{\i+\@ne}{\j-\@ne}=11 \else
   \count@=\@ne \fancyqr@hw@kfree
   \edef\fancyqr@hw@k{\the\numexpr1+\fancyqr@hw@h-\count@*((\fancyqr@hw@h*2-\count@+1)/(2*\count@))}%
   \put(.5,0){\advance\unitlength-\fancyqr@edge@compensate\fancyqr@hw@webc\linethickness{\iffancyqr@hl@.09\else.03\fi\unitlength}%
   \moveto(0,.02)\lineto(0,\fpeval{.15-\fancyqr@hw@k})\strokepath
   \put(0,\fpeval{.15-\fancyqr@hw@k}){\fancyqr@hw@D{hangspider}{}{%
      {\K{.!60!black}\Q0{-.04}{.05}{.06}\F\T{.015}\R\M(-.04,-.02)\L(-.1,.02)\M(-.04,-.06)\L(-.1,-.1)%
      \M(.04,-.02)\L(.1,.02)\M(.04,-.06)\L(.1,-.1)\S}}}}\fi}%
% webs of up to 4x4 light modules, placed after the figures by the seeded
% generator, the larger first, where a square of free light modules ends
% (\fancyqr@S@ holds the side of the largest one): a quarter web in a corner of dark
% modules, a half web under a row of them or a full web in the open, held by
% longer threads to the dark modules beside its middle; more threads and rings
% the larger it is
\def\fancyqr@hw@S#1#2{\ifcsname fancyqr@S@\the\numexpr#1\relax @\the\numexpr#2\endcsname
   \csname fancyqr@S@\the\numexpr#1\relax @\the\numexpr#2\endcsname\else0\fi}%
\def\fancyqr@hw@webscan{\fancyqr@hw@cells{\ifnum\fancyqr@hw@free\fancyqr@hw@a\fancyqr@hw@b=\@ne
      \expandafter\edef\csname fancyqr@S@\the\fancyqr@hw@a @\the\fancyqr@hw@b\endcsname{\the\numexpr1+\fpeval{%
      min(\fancyqr@hw@S{\fancyqr@hw@a-1}\fancyqr@hw@b,\fancyqr@hw@S\fancyqr@hw@a{\fancyqr@hw@b-1},%
      \fancyqr@hw@S{\fancyqr@hw@a-1}{\fancyqr@hw@b-1})}}\fi}%
   \def\fancyqr@hw@k{4}\fancyqr@hw@cells\fancyqr@hw@square\def\fancyqr@hw@k{3}\fancyqr@hw@cells\fancyqr@hw@square
   \def\fancyqr@hw@k{2}\fancyqr@hw@cells\fancyqr@hw@square\def\fancyqr@hw@k{1}\fancyqr@hw@cells\fancyqr@hw@square}%
\def\fancyqr@hw@cells#1{\fancyqr@hw@a\@ne
   \@whilenum\fancyqr@hw@a<\numexpr\@max@y+\@ne\do{\fancyqr@hw@b\@ne
      \@whilenum\fancyqr@hw@b<\numexpr\@max@x+\@ne\do{#1\advance\fancyqr@hw@b\@ne}%
      \advance\fancyqr@hw@a\@ne}}%
\def\fancyqr@hw@square{\ifnum\fancyqr@hw@S\fancyqr@hw@a\fancyqr@hw@b<\fancyqr@hw@k\relax\else
   \ifnum\csname int_rand:nn\endcsname{1}{1000}>\numexpr\fancyqr@hw@bigwebs*\ifcase\fancyqr@hw@k\or1\or12\else40\fi\relax
   \else\@tempswatrue\fancyqr@hw@c\numexpr\fancyqr@hw@a-\fancyqr@hw@k\relax
      \@whilenum\fancyqr@hw@c<\fancyqr@hw@a\do{\advance\fancyqr@hw@c\@ne\@tempcnta\numexpr\fancyqr@hw@b-\fancyqr@hw@k\relax
         \@whilenum\@tempcnta<\fancyqr@hw@b\do{\advance\@tempcnta\@ne
            \ifcsname fancyqr@W@\the\fancyqr@hw@c @\the\@tempcnta\endcsname\@tempswafalse\fi}}%
      \if@tempswa\fancyqr@hw@bigweb\fi\fi\fi}%
\def\fancyqr@hw@bigweb{\edef\fancyqr@hw@r{\the\numexpr\fancyqr@hw@a-\fancyqr@hw@k+1}%
   \edef\fancyqr@hw@q{\the\numexpr\fancyqr@hw@b-\fancyqr@hw@k+1}\fancyqr@hw@c\fancyqr@hw@r
   \@whilenum\fancyqr@hw@c<\numexpr\fancyqr@hw@a+1\do{\@tempcnta\fancyqr@hw@q
      \@whilenum\@tempcnta<\numexpr\fancyqr@hw@b+1\do{%
         \expandafter\let\csname fancyqr@W@\the\fancyqr@hw@c @\the\@tempcnta\endcsname\@empty
         \advance\@tempcnta\@ne}\advance\fancyqr@hw@c\@ne}%
   \edef\fancyqr@hw@kind{\ifnum\fancyqr@hw@dark{\fancyqr@hw@r-1}\fancyqr@hw@q
      \fancyqr@hw@dark\fancyqr@hw@r{\fancyqr@hw@q-1}=11 q\else\ifnum\fancyqr@hw@dark{\fancyqr@hw@r-1}\fancyqr@hw@q
      \fancyqr@hw@dark{\fancyqr@hw@r-1}{\fancyqr@hw@q+\fancyqr@hw@k-1}=11 h\else f\fi\fi}%
   \edef\fancyqr@hw@x{\fpeval{\fancyqr@hw@q+(\if q\fancyqr@hw@kind0\else\fancyqr@hw@k/2\fi)}}%
   \edef\fancyqr@hw@y{\fpeval{\@max@y-\fancyqr@hw@r+1-(\if f\fancyqr@hw@kind\fancyqr@hw@k/2\else0\fi)}}%
   \edef\fancyqr@hw@g{fancyqr@hw@WB@\fancyqr@hw@kind\fancyqr@hw@k/\the\unitlength}%
   \iffancyqr@rec@\else\ifcsname\fancyqr@hw@g\endcsname\else\expandafter\newbox\csname\fancyqr@hw@g\endcsname
      \global\expandafter\setbox\csname\fancyqr@hw@g\endcsname\hbox{\begin{picture}(0,0)%
      \fancyqr@hw@webpath\end{picture}}\fi\fi
   \fancyqr@gradient@row{\the\numexpr\fancyqr@hw@r+\fancyqr@hw@k/2\relax}%
   \fancyqr@ci=\numexpr\fancyqr@hw@q+\fancyqr@hw@k/2\relax
   \fancyqr@tilecolor{\fancyqr@hw@webc\put(\fancyqr@hw@x,\fancyqr@hw@y){%
      \iffancyqr@rec@\fancyqr@hw@webpath\else\expandafter\usebox\csname\fancyqr@hw@g\endcsname\fi
      \if f\fancyqr@hw@kind\linethickness{.025\unitlength}\edef\fancyqr@hw@m{\the\numexpr(\fancyqr@hw@k-1)/2}%
         \fancyqr@hw@anchor{-1}\fancyqr@hw@m{0}{1}\fancyqr@hw@anchor\fancyqr@hw@k\fancyqr@hw@m{0}{-1}%
         \fancyqr@hw@anchor\fancyqr@hw@m{-1}{-1}{0}\fancyqr@hw@anchor\fancyqr@hw@m\fancyqr@hw@k{1}{0}\fi}}}%
% a thread from the full web to the edge of its square where a dark module
% lies beyond (#1, #2 its offset from the square in rows and columns, #3, #4
% the direction)
\def\fancyqr@hw@anchor#1#2#3#4{\ifnum\fancyqr@hw@dark{\fancyqr@hw@r+(#1)}{\fancyqr@hw@q+(#2)}=\@ne
   \moveto(\fpeval{.4*\fancyqr@hw@k*(#3)},\fpeval{.4*\fancyqr@hw@k*(#4)})%
   \lineto(\fpeval{.5*\fancyqr@hw@k*(#3)},\fpeval{.5*\fancyqr@hw@k*(#4)})\strokepath\fi}%
% the threads and rings of a web of kind q (from the corner, into the lower
% right), h (from the middle of the top edge, downwards) or f (all around), side
% \fancyqr@hw@k, kept as a path
\def\fancyqr@hw@webpath{\fancyqr@hw@D{webk\fancyqr@hw@kind\fancyqr@hw@k}{%
   \edef\h@n{\the\numexpr4+2*\fancyqr@hw@k}\edef\h@m{\the\numexpr2+\fancyqr@hw@k}%
   \edef\h@r{\fpeval{\fancyqr@hw@k*\if q\fancyqr@hw@kind.92\else\if h\fancyqr@hw@kind.47\else.44\fi\fi}}%
   \edef\h@a{\if q\fancyqr@hw@kind-6\else\if h\fancyqr@hw@kind-174\else0\fi\fi}%
   \edef\h@d{\fpeval{\if f\fancyqr@hw@kind360/\h@n\else(\if q\fancyqr@hw@kind-78\else168\fi)/(\h@n-1)\fi}}%
   % cosine and sine (in sp) of the angles at the thread j (c0, s0 at 3j),
   % and a third before and after it (3j-2, 3j-1), once for all rings
   \def\h@t##1##2{\expandafter\edef\csname h@c##1\endcsname{\number\dimexpr\fpeval{cosd(##2)}pt\relax}%
      \expandafter\edef\csname h@s##1\endcsname{\number\dimexpr\fpeval{sind(##2)}pt\relax}}%
   \@tempcnta\z@\h@t0\h@a
   \@whilenum\@tempcnta<\h@n\do{\advance\@tempcnta\@ne
      \h@t{\the\numexpr3*\@tempcnta-2}{\h@a+(\the\@tempcnta-.67)*\h@d}%
      \h@t{\the\numexpr3*\@tempcnta-1}{\h@a+(\the\@tempcnta-.33)*\h@d}%
      \h@t{\the\numexpr3*\@tempcnta}{\h@a+\the\@tempcnta*\h@d}}%
   \def\h@p##1##2{\fancyqr@sl@pt{\dimexpr##1 sp*\csname h@c##2\endcsname/65536\relax},%
      \fancyqr@sl@pt{\dimexpr##1 sp*\csname h@s##2\endcsname/65536\relax}}%
   \edef\h@R{\number\dimexpr\h@r pt\relax}%
   \let\h@acc\@empty\def\h@add##1{\edef\h@acc{\unexpanded\expandafter{\h@acc}##1}}%
   \@tempcnta\z@\@whilenum\@tempcnta<\h@n\do{%
      \h@add{\noexpand\moveto(0,0)\noexpand\lineto(\h@p\h@R{\the\numexpr3*\@tempcnta})}\advance\@tempcnta\@ne}%
   \@tempcntb\@ne\@whilenum\@tempcntb<\numexpr\h@m+1\do{%
      \edef\h@s{\number\dimexpr\h@R sp*\@tempcntb/\h@m\relax}\edef\h@u{\number\dimexpr\h@s sp*84/100\relax}%
      \h@add{\noexpand\moveto(\h@p\h@s0)}%
      \@tempcnta\@ne\@whilenum\@tempcnta<\numexpr\h@n+\if f\fancyqr@hw@kind1\else0\fi\do{%
         \h@add{\noexpand\curveto(\h@p\h@u{\the\numexpr3*\@tempcnta-2})%
            (\h@p\h@u{\the\numexpr3*\@tempcnta-1})(\h@p\h@s{\the\numexpr3*\@tempcnta})}%
         \advance\@tempcnta\@ne}\advance\@tempcntb\@ne}}{%
   \T{.025}\unexpanded\expandafter{\h@acc}\S}}%
% a spider web in the white module below and right of a tile that has dark
% modules to its right and below: radial threads from the inner corner (1,0)
% and three sagging rings, all thin and pale, so the module stays light;
% by the place it is larger or smaller and some hold a small spider near the
% corner. \h@r is its radius, \h@p the point at radius ##1 and angle ##2; the
% threads are kept in a box per kind and size (drawn directly while recording), in
% the pale tint
\def\fancyqr@hw@web{\edef\fancyqr@hw@k{fancyqr@hw@WB@\fancyqr@hw@key3/\the\unitlength}%
   \def\fancyqr@hw@webbody{\fancyqr@hw@D{web\fancyqr@hw@key3}{%
      \edef\h@r{\ifcase\fancyqr@hw@dig13 .85\or.9\else.95\fi}%
      \def\h@p####1####2{\fpeval{1+(####1)*cosd(####2)},\fpeval{-(####1)*sind(####2)}}%
      \def\h@k####1####2####3{\C(\h@p{.8*(####1)}{####2+(####3-####2)/3})(\h@p{.8*(####1)}{####3-(####3-####2)/3})(\h@p{####1}{####3})}%
      \def\h@a####1{\M(\h@p{####1}8)\h@k{####1}8{32}\h@k{####1}{32}{58}\h@k{####1}{58}{82}}}{%
      \T{.025}\M(1,0)\L(\h@p\h@r8)\M(1,0)\L(\h@p\h@r{32})\M(1,0)\L(\h@p\h@r{58})%
      \M(1,0)\L(\h@p\h@r{82})\h@a{.36*\h@r}\h@a{.68*\h@r}\h@a\h@r\S}}%
   \iffancyqr@rec@\else\ifcsname\fancyqr@hw@k\endcsname\else\expandafter\newbox\csname\fancyqr@hw@k\endcsname
      \global\expandafter\setbox\csname\fancyqr@hw@k\endcsname\hbox{\begin{picture}(0,0)%
      \fancyqr@hw@webbody\end{picture}}\fi\fi
   {\fancyqr@hw@webc\iffancyqr@rec@\fancyqr@hw@webbody\else\expandafter\usebox\csname\fancyqr@hw@k\endcsname\fi}%
   \ifnum\fancyqr@hw@dig{12}2=7 \fancyqr@hw@D{webspider}{}{{\K{.!80!black}\Q{1.19}{-.2}{.055}{.06}\F
      \Q{1.17}{-.13}{.035}{.035}\F\T{.015}\R\M(1.14,-.18)\L(1.07,-.14)\M(1.14,-.22)\L(1.08,-.27)%
      \M(1.24,-.18)\L(1.3,-.13)\M(1.24,-.22)\L(1.3,-.28)\S}}\fi}%
\def\fancyqr@hw@timing{\fancyqr@hw@tgo0{1}{1}{%
   \fancyqr@hw@var{26}\ifnum\fancyqr@hw@h<20 \fancyqr@hw@tghost\else\ifnum\fancyqr@hw@h<36 \fancyqr@hw@tsweet{\fancyqr@hw@dig14}%
   \else\edef\@tempa{\the\numexpr\fancyqr@hw@h-8*((\fancyqr@hw@h-4)/8)\relax}\expandafter\fancyqr@hw@ttiny\expandafter{\@tempa}\fi\fi}}%
\let\fancyqr@hw@tghost\fancyqr@ghost \let\fancyqr@hw@tsweet\fancyqr@hw@sweet
\let\fancyqr@hw@ttiny\fancyqr@hw@tiny \let\fancyqr@hw@hangbatx\fancyqr@hw@hangbat%
\let\fancyqr@style@begin\fancyqr@hw@begin
\FancyQrExtras{web/corner,web/sized,web/thread,slime,timing}%
% what another style gets with add=halloween
\FancyQrLend{begin}{\fancyqr@hw@begin}\FancyQrLend{tile}{\fancyqr@hw@extras}%
\FancyQrLend{extras}{web/corner,web/sized,web/thread,slime}%
\FancyQrRoundedPatterns\fancyqr@halloween@tile
\FancyQrInnerRoundings
\FancyQrStyleSet{%
   r color=orange!90!red,l color=violet!55!black,%
   finder=rounded,finder core=halloween%
}%
