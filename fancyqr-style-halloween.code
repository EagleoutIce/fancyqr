% figures are drawn at the size of a module, not of a tile (which overlaps its
% neighbours a little), the shift by #1 modules to the first x undone to match,
% and shrunk about the middle of their #2 x #3 block, so that they keep a margin
% of .02 modules more than drawn from every edge
\def\fancyqr@hw@go#1#2#3#4{{\advance\unitlength-\fancyqr@edge@compensate
   \edef\@fq@s{\fpeval{1-.04/min(#2,#3)}}%
   \put(\fpeval{#1*\fancyqr@edge@compensate/\unitlength+#2/2*(1-\@fq@s)},\fpeval{(1-#3/2)*(1-\@fq@s)}){%
      \unitlength=\@fq@s\unitlength#4}}}%
\let\fancyqr@hw@tgo\fancyqr@hw@go%
\def\fancyqr@hw@begin{%
   \edef\fancyqr@hw@webs{\iffancyqr@faint@40\else\fpeval{round(100*\fancyqr@web@chance)}\fi}%
   \edef\fancyqr@hw@bigwebs{\fpeval{round(1000*\fancyqr@bigweb@chance)}}%
   \edef\fancyqr@hw@threads{\iffancyqr@faint@40\else\fpeval{round(100*\fancyqr@thread@chance)}\fi}%
   \ifx\fancyqr@fig@scan\fancyqr@hw@scanw\else\let\fancyqr@hw@figscan\fancyqr@fig@scan\let\fancyqr@fig@scan\fancyqr@hw@scanw\fi}%
\def\fancyqr@hw@scanw{\fancyqr@hw@figscan\FancyQrExtra{web/sized}{\fancyqr@hw@webscan}}%
% the colors, mixed from the current one: pumpkins lean to orange, features
% are darker, eyes and carved faces glow
\def\fancyqr@hw@pk{\fancyqr@mixcolor{.!55!orange!80!black}}%
\def\fancyqr@hw@dk{\fancyqr@mixcolor{.!45!black}}%
% webs are pale to scan, but shown strongly where an extra is on display
\def\fancyqr@hw@webc{\fancyqr@mixcolor{\iffancyqr@hl@.!80!black\else.!22!white\fi}}%
\def\fancyqr@hw@dkk{\fancyqr@mixcolor{.!25!black}}%
\def\fancyqr@hw@stem{\fancyqr@mixcolor{.!50!black}}%
\def\fancyqr@hw@glow{\fancyqr@mixcolor{yellow!75!orange}}%
% ... in the cores a tinted ember and soft ribs, as light cut-outs or strong
% edges there keep scanners from finding the patterns
\def\fancyqr@hw@cglow{\fancyqr@mixcolor{.!60!red!72!black}}%
\def\fancyqr@hw@apk{\fancyqr@mixcolor{.!50!orange}}%
\def\fancyqr@hw@crib{\fancyqr@mixcolor{.!70!black}}%
% paths with computed points are kept under the name #1
\def\fancyqr@hw@P#1#2{\ifcsname fancyqr@hw@P@#1\endcsname\else
   \expandafter\xdef\csname fancyqr@hw@P@#1\endcsname{#2}\fi
   \csname fancyqr@hw@P@#1\endcsname}%
% an ellipse around (#1,#2) with the radii #3, #4, for \fancyqr@hw@P
% (in sp: \numexpr and \dimexpr instead of \fpeval, with the arcs at .5523 radii)
\def\fancyqr@hw@sp#1{\number\dimexpr\fpeval{#1}pt\relax}%
\def\fancyqr@hw@kk#1{\dimexpr#1sp*5523/10000\relax}%
\def\fancyqr@hw@ell#1#2#3#4{\fancyqr@hw@els{\fancyqr@hw@sp{#1}}{\fancyqr@hw@sp{#2}}{\fancyqr@hw@sp{#3}}{\fancyqr@hw@sp{#4}}}%
\def\fancyqr@hw@els#1#2#3#4{%
   \noexpand\moveto(\fancyqr@sl@pt{#1+#3},\fancyqr@sl@pt{#2})%
   \noexpand\curveto(\fancyqr@sl@pt{#1+#3},\fancyqr@sl@pt{#2+\fancyqr@hw@kk{#4}})(\fancyqr@sl@pt{#1+\fancyqr@hw@kk{#3}},\fancyqr@sl@pt{#2+#4})(\fancyqr@sl@pt{#1},\fancyqr@sl@pt{#2+#4})%
   \noexpand\curveto(\fancyqr@sl@pt{#1-\fancyqr@hw@kk{#3}},\fancyqr@sl@pt{#2+#4})(\fancyqr@sl@pt{#1-#3},\fancyqr@sl@pt{#2+\fancyqr@hw@kk{#4}})(\fancyqr@sl@pt{#1-#3},\fancyqr@sl@pt{#2})%
   \noexpand\curveto(\fancyqr@sl@pt{#1-#3},\fancyqr@sl@pt{#2-\fancyqr@hw@kk{#4}})(\fancyqr@sl@pt{#1-\fancyqr@hw@kk{#3}},\fancyqr@sl@pt{#2-#4})(\fancyqr@sl@pt{#1},\fancyqr@sl@pt{#2-#4})%
   \noexpand\curveto(\fancyqr@sl@pt{#1+\fancyqr@hw@kk{#3}},\fancyqr@sl@pt{#2-#4})(\fancyqr@sl@pt{#1+#3},\fancyqr@sl@pt{#2-\fancyqr@hw@kk{#4}})(\fancyqr@sl@pt{#1+#3},\fancyqr@sl@pt{#2})%
   \noexpand\closepath}%
% a figure #3 kept under the name #1, with the points #2 defined while it is
% built: \M, \L, \C, \Z move, line, curve, close, \F, \S fill, stroke, \T a
% thickness, \K a color, \R round caps, \E an ellipse, \O a circle; \P{x}{y}
% is a point through the map \fancyqr@hw@map{a}{b}{c}{d}{e}{f} (x'=ax+by+e,
% y'=cx+dy+f, set in #2), \Q{x}{y}{rx}{ry} an ellipse through it
\def\fancyqr@hw@map#1#2#3#4#5#6{%
   \def\@tempa{#2#3}\def\@tempb{00}%
   \ifx\@tempa\@tempb
      \def\@tempa{#1}\def\@tempb{1}\def\@tempc{#5}\def\@tempd{0}%
      \ifx\@tempa\@tempb\ifx\@tempc\@tempd\def\fancyqr@hw@px##1{\fpeval{##1}}\else
         \def\fancyqr@hw@px##1{\fpeval{(##1)+(#5)}}\fi
      \else\ifx\@tempc\@tempd\def\fancyqr@hw@px##1{\fpeval{(#1)*(##1)}}\else
         \def\fancyqr@hw@px##1{\fpeval{(#1)*(##1)+(#5)}}\fi\fi
      \def\@tempa{#4}\def\@tempc{#6}%
      \ifx\@tempa\@tempb\ifx\@tempc\@tempd\def\fancyqr@hw@py##1{\fpeval{##1}}\else
         \def\fancyqr@hw@py##1{\fpeval{(##1)+(#6)}}\fi
      \else\ifx\@tempc\@tempd\def\fancyqr@hw@py##1{\fpeval{(#4)*(##1)}}\else
         \def\fancyqr@hw@py##1{\fpeval{(#4)*(##1)+(#6)}}\fi\fi
      \def\P##1##2{\fancyqr@hw@px{##1},\fancyqr@hw@py{##2}}%
   \else
      \def\P##1##2{\fpeval{(#1)*(##1)+(#2)*(##2)+(#5)},\fpeval{(#3)*(##1)+(#4)*(##2)+(#6)}}\fi
   \edef\@tempa{#1#2#3#4#5#6}\def\@tempb{100100}\ifx\@tempa\@tempb\def\fancyqr@hw@id{1}\else\def\fancyqr@hw@id{0}\fi
   \let\Pn\P \def\fancyqr@hw@fast{1}\fancyqr@hw@chk{#1}\fancyqr@hw@chk{#2}\fancyqr@hw@chk{#3}\fancyqr@hw@chk{#4}%
   \if1\fancyqr@hw@fast
      \def\Pn##1##2{\fancyqr@hw@Pn{#1}{#2}{#3}{#4}{#5}{#6}{##1}{##2}}%
      \def\Pp##1##2{\fancyqr@sl@pt{(#1)*(##1)+(#2)*(##2)+\fancyqr@hw@sp{#5}},\fancyqr@sl@pt{(#3)*(##1)+(#4)*(##2)+\fancyqr@hw@sp{#6}}}\fi}%
% a point of plain numbers through the map (kept as it is by the identity)
\def\fancyqr@hw@Pn#1#2#3#4#5#6#7#8{\if1\fancyqr@hw@id #7,#8\else
   \fancyqr@sl@pt{(#1)*\dimexpr#7pt\relax+(#2)*\dimexpr#8pt\relax+\dimexpr#5pt\relax},%
   \fancyqr@sl@pt{(#3)*\dimexpr#7pt\relax+(#4)*\dimexpr#8pt\relax+\dimexpr#6pt\relax}\fi}%
% 0 unless the coefficient #1 is 0, 1 or -1
\def\fancyqr@hw@chk#1{\def\@tempa{#1}\def\@tempb{0}\ifx\@tempa\@tempb\else\def\@tempb{1}\ifx\@tempa\@tempb\else
   \def\@tempb{-1}\ifx\@tempa\@tempb\else\def\fancyqr@hw@fast{0}\fi\fi\fi}%
\def\fancyqr@hw@Qf#1#2#3#4{\M(\P{(#1)+(#3)}{#2})\C(\P{(#1)+(#3)}{(#2)+.5523*(#4)})(\P{(#1)+.5523*(#3)}{(#2)+(#4)})%
   (\P{#1}{(#2)+(#4)})\C(\P{(#1)-.5523*(#3)}{(#2)+(#4)})(\P{(#1)-(#3)}{(#2)+.5523*(#4)})(\P{(#1)-(#3)}{#2})%
   \C(\P{(#1)-(#3)}{(#2)-.5523*(#4)})(\P{(#1)-.5523*(#3)}{(#2)-(#4)})(\P{#1}{(#2)-(#4)})%
   \C(\P{(#1)+.5523*(#3)}{(#2)-(#4)})(\P{(#1)+(#3)}{(#2)-.5523*(#4)})(\P{(#1)+(#3)}{#2})\Z}%
\def\fancyqr@hw@Q#1#2#3#4{\if1\fancyqr@hw@fast
   \expandafter\fancyqr@hw@Qs\else\expandafter\fancyqr@hw@Qf\fi{#1}{#2}{#3}{#4}}%
\def\fancyqr@hw@Qs#1#2#3#4{\fancyqr@hw@Qp{\fancyqr@hw@sp{#1}}{\fancyqr@hw@sp{#2}}{\fancyqr@hw@sp{#3}}{\fancyqr@hw@sp{#4}}}%
\def\fancyqr@hw@Qp#1#2#3#4{\M(\Pp{#1+#3}{#2})\C(\Pp{#1+#3}{#2+\fancyqr@hw@kk{#4}})(\Pp{#1+\fancyqr@hw@kk{#3}}{#2+#4})%
   (\Pp{#1}{#2+#4})\C(\Pp{#1-\fancyqr@hw@kk{#3}}{#2+#4})(\Pp{#1-#3}{#2+\fancyqr@hw@kk{#4}})(\Pp{#1-#3}{#2})%
   \C(\Pp{#1-#3}{#2-\fancyqr@hw@kk{#4}})(\Pp{#1-\fancyqr@hw@kk{#3}}{#2-#4})(\Pp{#1}{#2-#4})%
   \C(\Pp{#1+\fancyqr@hw@kk{#3}}{#2-#4})(\Pp{#1+#3}{#2-\fancyqr@hw@kk{#4}})(\Pp{#1+#3}{#2})\Z}%
\def\fancyqr@hw@D#1#2#3{\ifcsname fancyqr@hw@P@#1\endcsname\else\begingroup
   \fancyqr@hw@map100100\let\Q\fancyqr@hw@Q
   \def\M{\noexpand\moveto}\def\L{\noexpand\lineto}\def\C{\noexpand\curveto}%
   \def\Z{\noexpand\closepath}\def\F{\noexpand\fillpath}\def\S{\noexpand\strokepath}%
   \def\T##1{\noexpand\linethickness{##1\noexpand\unitlength}}%
   \def\K##1{\noexpand\fancyqr@mixcolor{##1}}\def\R{\noexpand\roundcap\noexpand\roundjoin}%
   \let\E\fancyqr@hw@ell\def\O##1##2##3{\Q{##1}{##2}{##3}{##3}}%
   #2\expandafter\xdef\csname fancyqr@hw@P@#1\endcsname{#3}\endgroup\fi
   \csname fancyqr@hw@P@#1\endcsname}%
% figures are drawn from their top left module into the block below and to the
% right of it, in the tile color with darker features; no light feature lies on
% the center of a module
\def\fancyqr@skull{%
   \fancyqr@hw@P{c1/.18/.8}{\fancyqr@hw@ell{1}{.18}{.8}{.8}}\fillpath
   \moveto(.4,-.2)\lineto(1.6,-.2)\lineto(1.5,-.76)\curveto(1.47,-.9)(1.4,-.96)(1.28,-.96)%
   \lineto(.72,-.96)\curveto(.6,-.96)(.53,-.9)(.5,-.76)\closepath\fillpath
   {\fancyqr@hw@dk
   \fancyqr@hw@P{c.66/.12/.25}{\fancyqr@hw@ell{.66}{.12}{.25}{.25}}\fillpath
   \fancyqr@hw@P{c1.34/.12/.25}{\fancyqr@hw@ell{1.34}{.12}{.25}{.25}}\fillpath
   \moveto(1,-.14)\lineto(1.12,-.4)\lineto(.88,-.4)\closepath\fillpath
   \linethickness{.07\unitlength}\roundcap
   \moveto(.66,-.64)\lineto(1.34,-.64)\strokepath
   \moveto(.84,-.52)\lineto(.84,-.9)\strokepath
   \moveto(1,-.52)\lineto(1,-.9)\strokepath
   \moveto(1.16,-.52)\lineto(1.16,-.9)\strokepath}}%
% a jack-o'-lantern on a 2x2 block, #1 names it, #2 tilts it, #3 the face: 0 triangle
% eyes and a zigzag grin, 1 round eyes and a wide mouth
\def\fancyqr@hw@jack#1#2#3{\fancyqr@hw@D{jack#1}{#2}{%
   \K{.!55!orange!80!black}\Q{.6}{-.12}{.54}{.8}\F\Q{1.4}{-.12}{.54}{.8}\F\Q{1}{-.12}{.48}{.84}\F
   {\K{.!50!black}\M(\P{.94}{.66})\C(\P{.96}{.8})(\P{1}{.88})(\P{.96}{.96})\L(\P{1.1}{.96})%
   \C(\P{1.12}{.86})(\P{1.08}{.76})(\P{1.08}{.66})\Z\F
   \K{.!45!black}\T{.04}\M(\P{.7}{.62})\C(\P{.56}{.3})(\P{.56}{-.6})(\P{.7}{-.88})\S
   \M(\P{1.3}{.62})\C(\P{1.44}{.3})(\P{1.44}{-.6})(\P{1.3}{-.88})\S
   \K{.!25!black}\ifnum#3=\z@
   \M(\P{.64}{.1})\L(\P{.86}{.1})\L(\P{.77}{.28})\Z\M(\P{1.14}{.1})\L(\P{1.36}{.1})\L(\P{1.23}{.28})\Z
   \M(\P{.94}{-.06})\L(\P{1.06}{-.06})\L(\P{1}{.04})\Z
   \M(\P{.62}{-.26})\L(\P{.74}{-.33})\L(\P{.84}{-.26})\L(\P{.92}{-.33})\L(\P{1}{-.26})%
   \L(\P{1.08}{-.33})\L(\P{1.16}{-.26})\L(\P{1.26}{-.33})\L(\P{1.38}{-.26})%
   \C(\P{1.3}{-.52})(\P{1.16}{-.58})(\P{1}{-.58})\C(\P{.84}{-.58})(\P{.7}{-.52})(\P{.62}{-.26})\Z\F
   \else\Q{.7}{.14}{.13}{.15}\F\Q{1.3}{.14}{.13}{.15}\F\M(\P{1}{.04})\L(\P{1.08}{-.1})\L(\P{.92}{-.1})\Z
   \M(\P{.66}{-.28})\C(\P{.8}{-.66})(\P{1.2}{-.66})(\P{1.34}{-.28})\C(\P{1.15}{-.4})(\P{.85}{-.4})(\P{.66}{-.28})\Z\F\fi}}}%
% the grim reaper: a hooded robe with a dark void for a face and glowing eyes,
% holding a scythe whose handle and blade stand out from the robe; #1 is the
% bottom of the robe, #2 its zigzag, #3 the folds, #4 the scythe, #5 1 for a
% fourth row
\def\fancyqr@reaper{\fancyqr@reaper@draw{-1.97}{-1.8}{-1.82}{-1.88}0}%
\def\fancyqr@reaper@tall{\fancyqr@reaper@draw{-2.97}{-2.8}{-2.82}{-2.88}1}%
\def\fancyqr@reaper@draw#1#2#3#4#5{%
   \moveto(.05,#1)\lineto(.38,#2)\lineto(.7,#1)\lineto(1.02,#2)\lineto(1.34,#1)%
   \lineto(1.66,#2)\lineto(1.98,#1)\lineto(2.3,#2)\lineto(2.62,#1)\lineto(2.95,#2)%
   \curveto(2.97,-1)(2.97,0)(2.97,.52)\curveto(2.6,.7)(2.1,.68)(1.86,.62)%
   \curveto(1.9,.86)(1.5,.95)(1.12,.94)\curveto(.7,.93)(.36,.84)(.34,.62)%
   \curveto(.2,.64)(.08,.6)(.03,.52)\curveto(.03,-.4)(.04,-1.2)(.05,#1)\closepath\fillpath
   {\fancyqr@hw@dk\linethickness{.06\unitlength}\roundcap
   \moveto(.62,-.3)\curveto(.52,-.9)(.56,-1.4)(.62,#3)\strokepath
   \moveto(1.7,-.3)\curveto(1.9,-.8)(1.86,-1.3)(1.94,#3)\strokepath
   \ifnum#5>\z@\moveto(1.16,-1.2)\curveto(1.06,-1.8)(1.1,-2.3)(1.2,-2.82)\strokepath\fi
   \moveto(1.8,.45)\curveto(2.05,.15)(2.25,-.2)(2.45,-.38)\strokepath
   \moveto(.62,-.16)\curveto(.48,.3)(.6,.96)(1.1,.96)\curveto(1.6,.96)(1.72,.3)(1.58,-.16)\strokepath
   \fancyqr@hw@dkk
   \moveto(1.1,.88)\curveto(1.5,.86)(1.62,.46)(1.52,.12)\curveto(1.42,-.12)(.78,-.12)(.68,.12)%
   \curveto(.58,.46)(.72,.88)(1.1,.88)\closepath\fillpath
   \fancyqr@hw@glow
   \fancyqr@hw@P{c.94/.42/.07}{\fancyqr@hw@ell{.94}{.42}{.07}{.07}}\fillpath
   \fancyqr@hw@P{c1.26/.42/.07}{\fancyqr@hw@ell{1.26}{.42}{.07}{.07}}\fillpath
   \fancyqr@mixcolor{.!30!black}\linethickness{.11\unitlength}%
   \moveto(2.72,#4)\lineto(2.31,.87)\strokepath
   \fancyqr@hw@P{c2.45/-.4/.13}{\fancyqr@hw@ell{2.45}{-.4}{.13}{.13}}\fillpath}%
   {\fancyqr@mixcolor{.!25!white}%
   \moveto(2.33,.88)\curveto(2.05,.93)(1.72,.89)(1.55,.56)\curveto(1.78,.74)(2.05,.76)(2.29,.73)%
   \closepath\fillpath
   \fancyqr@mixcolor{.!40!black}\linethickness{.03\unitlength}%
   \moveto(2.33,.88)\curveto(2.05,.93)(1.72,.89)(1.55,.56)\curveto(1.78,.74)(2.05,.76)(2.29,.73)%
   \closepath\strokepath}}%
\def\fancyqr@hw@stemat#1#2#3{\put(#1,#2){\unitlength=#3\unitlength\moveto(-.08,0)\curveto(-.06,.12)(-.02,.2)(-.08,.28)%
   \lineto(.1,.28)\curveto(.12,.16)(.1,.08)(.08,0)\closepath\fillpath}}%
\def\fancyqr@hw@widejack{%
   {\fancyqr@hw@pk
   \fancyqr@hw@P{wj}{\fancyqr@hw@ell{.78}{-.08}{.75}{.86}\fancyqr@hw@ell{2.22}{-.08}{.75}{.86}%
      \fancyqr@hw@ell{1.13}{-.08}{.62}{.88}\fancyqr@hw@ell{1.87}{-.08}{.62}{.88}%
      \fancyqr@hw@ell{1.5}{-.06}{.6}{.86}}\fillpath
   {\fancyqr@hw@dk\linethickness{.04\unitlength}%
   \moveto(1.02,.74)\curveto(.8,.4)(.8,-.6)(1.02,-.9)\strokepath
   \moveto(1.98,.74)\curveto(2.2,.4)(2.2,-.6)(1.98,-.9)\strokepath
   \moveto(.4,.56)\curveto(.22,.24)(.22,-.44)(.4,-.74)\strokepath
   \moveto(2.6,.56)\curveto(2.78,.24)(2.78,-.44)(2.6,-.74)\strokepath}%
   {\fancyqr@hw@stem\fancyqr@hw@stemat{1.5}{.68}{1.05}}%
   \fancyqr@hw@glow
   \moveto(.74,.1)\lineto(1.26,.1)\lineto(1.02,.5)\closepath
   \moveto(1.74,.1)\lineto(2.26,.1)\lineto(1.98,.5)\closepath
   \moveto(1.4,-.14)\lineto(1.6,-.14)\lineto(1.5,.04)\closepath
   \moveto(.6,-.18)\lineto(.96,-.3)\lineto(1.06,-.46)\lineto(1.16,-.3)\lineto(1.84,-.3)%
   \lineto(1.94,-.46)\lineto(2.04,-.3)\lineto(2.4,-.18)\curveto(2.32,-.58)(2,-.78)(1.66,-.8)%
   \lineto(1.62,-.36)\lineto(1.38,-.36)\lineto(1.34,-.8)\curveto(1,-.78)(.68,-.58)(.6,-.18)%
   \closepath\fillpath}}%
\def\fancyqr@hw@bigjack{%
   {\fancyqr@hw@pk
   \fancyqr@hw@P{bj}{\fancyqr@hw@ell{.8}{-.55}{.77}{1.36}\fancyqr@hw@ell{2.2}{-.55}{.77}{1.36}%
      \fancyqr@hw@ell{1.13}{-.55}{.62}{1.39}\fancyqr@hw@ell{1.87}{-.55}{.62}{1.39}%
      \fancyqr@hw@ell{1.5}{-.55}{.6}{1.4}}\fillpath
   {\fancyqr@hw@dk\linethickness{.05\unitlength}%
   \moveto(1.02,.7)\curveto(.76,.2)(.76,-1.3)(1.02,-1.8)\strokepath
   \moveto(1.98,.7)\curveto(2.24,.2)(2.24,-1.3)(1.98,-1.8)\strokepath
   \moveto(.42,.44)\curveto(.2,-.06)(.2,-1.04)(.42,-1.54)\strokepath
   \moveto(2.58,.44)\curveto(2.8,-.06)(2.8,-1.04)(2.58,-1.54)\strokepath}%
   {\fancyqr@hw@stem\fancyqr@hw@stemat{1.5}{.68}{1}}%
   \fancyqr@hw@glow
   \moveto(.7,-.16)\lineto(1.3,-.16)\lineto(1.04,.34)\closepath
   \moveto(1.7,-.16)\lineto(2.3,-.16)\lineto(1.96,.34)\closepath
   \moveto(1.39,-.34)\lineto(1.61,-.34)\lineto(1.5,-.14)\closepath
   \moveto(.62,-.7)\lineto(.92,-.82)\lineto(1.02,-1)\lineto(1.12,-.84)\lineto(1.88,-.84)%
   \lineto(1.98,-1)\lineto(2.08,-.82)\lineto(2.38,-.7)\curveto(2.3,-1.1)(1.98,-1.3)(1.64,-1.32)%
   \lineto(1.58,-1.1)\lineto(1.42,-1.1)\lineto(1.36,-1.32)\curveto(1.02,-1.3)(.7,-1.1)(.62,-.7)%
   \closepath\fillpath}}%
% ghosts: a round head (its sides \h@w in from \h@L and \h@R, from \h@S up to
% \h@T) on a body that widens to a hem of \h@n waves or points (bottom \h@B),
% eyes with thin lighter rims \h@es apart at \h@E and a mouth (\h@mo: none, o, smile,
% frown) at \h@M; #1 names the drawing, #2 sets the points
\def\fancyqr@hw@spook#1#2{\fancyqr@hw@D{#1}{#2\def\h@m{(\h@L+\h@R)/2}%
   \def\h@X##1{\fpeval{\h@L+(\h@R-\h@L)*(##1)/\h@n}}%
   \def\h@s##1{\ifnum\h@pt=\z@\C(\P{\h@X{##1-.2}}{\h@B+\h@h})(\P{\h@X{##1-.8}}{\h@B+\h@h})(\P{\h@X{##1-1}}\h@B)%
      \else\C(\P{\h@X{##1-.25}}{\h@B+.5*\h@h})(\P{\h@X{##1-.4}}{\h@B+\h@h})(\P{\h@X{##1-.5}}{\h@B+\h@h})%
      \C(\P{\h@X{##1-.6}}{\h@B+\h@h})(\P{\h@X{##1-.75}}{\h@B+.5*\h@h})(\P{\h@X{##1-1}}\h@B)\fi}%
   \def\h@e##1##2{\Q{\h@m##1\h@es}\h@E{\h@erx##2}{\h@ery##2}\F}%
   \def\h@f##1{\M(\P{\h@m-\h@mw}\h@M)\C(\P{\h@m-.5*\h@mw}{\h@M##1\h@mh})(\P{\h@m+.5*\h@mw}{\h@M##1\h@mh})%
      (\P{\h@m+\h@mw}\h@M)\C(\P{\h@m+.5*\h@mw}{\h@M##1.4*\h@mh})(\P{\h@m-.5*\h@mw}{\h@M##1.4*\h@mh})%
      (\P{\h@m-\h@mw}\h@M)\Z\F}}{%
   \M(\P\h@L\h@B)\C(\P{\h@L+.01}{\h@B+.45*(\h@S-\h@B)})(\P{\h@L+\h@w}{\h@S-.35*(\h@S-\h@B)})(\P{\h@L+\h@w}\h@S)%
   \C(\P{\h@L+\h@w}{\h@S+.5523*(\h@T-\h@S)})(\P{\h@m-.5523*(\h@m-\h@L-\h@w)}\h@T)(\P\h@m\h@T)%
