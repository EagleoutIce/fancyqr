\fancyqr@hw@L{minipumpkin/C}{.025}{\fancyqr@hw@pump d}%
\fancyqr@hw@L{minijack/A}{.025}{\fancyqr@hw@pump b}%
\def\fancyqr@hw@L#1#2#3{\FancyQrFigure{#1}{\fancyqr@candy@chance*.034}{.0./0x0/.0.}{\fancyqr@hw@go{0}{1}{1}{\fancyqr@hw@var{14}\fancyqr@hw@sweet#3}}}%
\fancyqr@hw@L{bonbon}{}0%
\fancyqr@hw@L{swirl}{}1%
\fancyqr@hw@L{candycorn}{}2%
\fancyqr@hw@L{toffee}{}3%
\fancyqr@hw@L{peppermint}{}4%
