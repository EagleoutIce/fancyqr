% style `halloween': the default tiles in orange and purple, with slime that
% drips from lower edges and figures in place of blocks of dark modules; every
% object is a figure of its own, listed by \FancyQrFigureGallery (variants of one
% object are named object/variant). Extras (see \FancyQrExtras): slime, the
% spider webs (web/corner, web/sized, web/thread) and the small figures on the
% timing patterns. The finder rings follow the gradient around pumpkins,
% jack-o'-lanterns, ghosts and skulls in its tint. Tunables, the chance of a
% group of figures: \fancyqr@slime@chance, \fancyqr@slime@length,
% \fancyqr@reaper@chance (3x3, 3x4), \fancyqr@big@chance (3x2, 2x3),
% \fancyqr@skull@chance (skulls and jack-o'-lanterns, the share of the latter is
% \fancyqr@pumpkin@chance), \fancyqr@ghost@chance (lone modules), \fancyqr@hat@chance,
% \fancyqr@bat@chance, \fancyqr@spider@chance, \fancyqr@cross@chance,
% \fancyqr@candy@chance, \fancyqr@lamp@chance (lamps, candles), \fancyqr@broom@chance,
% \fancyqr@scythe@chance, \fancyqr@bone@chance, \fancyqr@web@chance (corner webs)
\FancyQrSince{2.5}%
\@ifundefined{fancyqr@slime@chance}{\def\fancyqr@slime@chance{.35}}{}%
\@ifundefined{fancyqr@slime@length}{\def\fancyqr@slime@length{.47}}{}%
\@ifundefined{fancyqr@reaper@chance}{\def\fancyqr@reaper@chance{1}}{}%
\@ifundefined{fancyqr@big@chance}{\def\fancyqr@big@chance{.6}}{}%
\@ifundefined{fancyqr@skull@chance}{\def\fancyqr@skull@chance{.82}}{}%
\@ifundefined{fancyqr@pumpkin@chance}{\def\fancyqr@pumpkin@chance{.5}}{}%
\@ifundefined{fancyqr@ghost@chance}{\def\fancyqr@ghost@chance{.4}}{}%
\@ifundefined{fancyqr@hat@chance}{\def\fancyqr@hat@chance{.22}}{}%
\@ifundefined{fancyqr@bat@chance}{\def\fancyqr@bat@chance{.2}}{}%
\@ifundefined{fancyqr@spider@chance}{\def\fancyqr@spider@chance{.17}}{}%
\@ifundefined{fancyqr@cross@chance}{\def\fancyqr@cross@chance{.275}}{}%
\@ifundefined{fancyqr@web@chance}{\def\fancyqr@web@chance{.4}}{}%
\@ifundefined{fancyqr@bigweb@chance}{\def\fancyqr@bigweb@chance{.008}}{}%
\@ifundefined{fancyqr@thread@chance}{\def\fancyqr@thread@chance{.08}}{}%
\@ifundefined{fancyqr@hw@a}{\newcount\fancyqr@hw@a\newcount\fancyqr@hw@b\newcount\fancyqr@hw@c}{}%
\@ifundefined{fancyqr@candy@chance}{\def\fancyqr@candy@chance{.3}}{}%
\@ifundefined{fancyqr@broom@chance}{\def\fancyqr@broom@chance{.2}}{}%
\@ifundefined{fancyqr@lamp@chance}{\def\fancyqr@lamp@chance{.5}}{}%
\@ifundefined{fancyqr@scythe@chance}{\def\fancyqr@scythe@chance{1}}{}%
\@ifundefined{fancyqr@bone@chance}{\def\fancyqr@bone@chance{.5}}{}%
% slime flows out of the straight part of a lower edge (#1, #2: the bottom
% right and left corners are round) with a wide base; every drop has its own
% width, length, tip and lean, a few split into two tips; it never reaches the
% center of the white module below; one path per drop. Lengths are integers in
% sp (65536 is a module), so \numexpr does the work; \int_rand:nn draws from the
% same seeded generator as rand()
\def\fancyqr@sl@r{\csname int_rand:nn\endcsname{0}{65535}}%
\def\fancyqr@sl@set#1#2{\edef#1{\the\numexpr#2\relax}}%
\def\fancyqr@sl@pt#1{\strip@pt\dimexpr\numexpr#1\relax sp\relax}%
\def\fancyqr@slime#1#2{%
\ifdim\fpeval{rand()}\p@<\fancyqr@slime@chance\p@
   \fancyqr@sl@set\fancyqr@sl@lo{\ifnum#2=\@ne\dimexpr\fancyqr@rounding@factor\p@\relax\else0\fi}%
   \fancyqr@sl@set\fancyqr@sl@hi{65536-\ifnum#1=\@ne\dimexpr\fancyqr@rounding@factor\p@\relax\else0\fi}%
   % half width of the base, from narrow trickles to wide sheets; a round end
   % gets a centered one, wide and without a neck, so that it hangs on
   \ifnum\numexpr\fancyqr@sl@hi-\fancyqr@sl@lo<17039
      \fancyqr@sl@set\fancyqr@sl@c{(\fancyqr@sl@lo+\fancyqr@sl@hi)/2}\def\fancyqr@sl@b{11000}%
      \let\fancyqr@sl@round\@ne
      \edef\fancyqr@sl@ys{\number\dimexpr\fpeval{\fancyqr@rounding@factor-sqrt(max(0,\fancyqr@rounding@factor^2-(11000/65536)^2))}pt\relax}%
   \else\let\fancyqr@sl@round\z@
      \fancyqr@sl@set\fancyqr@sl@b{7864+\fancyqr@sl@r*13107/65536}%
      \ifnum\fancyqr@sl@b>\numexpr(\fancyqr@sl@hi-\fancyqr@sl@lo)/2\relax
         \fancyqr@sl@set\fancyqr@sl@b{(\fancyqr@sl@hi-\fancyqr@sl@lo)/2}\fi
      \fancyqr@sl@set\fancyqr@sl@c{\fancyqr@sl@lo+\fancyqr@sl@b
         +(\fancyqr@sl@hi-\fancyqr@sl@lo-2*\fancyqr@sl@b)*\fancyqr@sl@r/65536}%
   \fi
   \fancyqr@sl@set\fancyqr@sl@x{\fancyqr@sl@c-\fancyqr@sl@b}%
   \fancyqr@sl@set\fancyqr@sl@X{\fancyqr@sl@c+\fancyqr@sl@b}%
   \ifnum\fancyqr@sl@round=\@ne\expandafter\fancyqr@sl@lift\else\expandafter\fancyqr@sl@body\fi\fi}%
% on a round dot the drop starts on the circle, \fancyqr@sl@ys above the lower edge, and
% is drawn from there: it leaves the circle in a fillet, a neck and a drop of .25 to .35
\def\fancyqr@sl@lift{\put(0,\fancyqr@sl@pt\fancyqr@sl@ys){\fancyqr@sl@body}}%
\def\fancyqr@sl@body{%
   \moveto(\fancyqr@sl@pt\fancyqr@sl@x,.15)\lineto(\fancyqr@sl@pt\fancyqr@sl@x,0)%
   \ifnum\numexpr\csname int_rand:nn\endcsname{0}{99}<22 \ifnum\fancyqr@sl@b>11141
      \@tempswatrue\else\@tempswafalse\fi\else\@tempswafalse\fi
   \if@tempswa
      \fancyqr@sl@set\fancyqr@sl@p{\fancyqr@sl@c-1966}\fancyqr@sl@set\fancyqr@sl@q{\fancyqr@sl@c+1966}%
      \fancyqr@slime@tip\fancyqr@sl@x\fancyqr@sl@p{32768+\fancyqr@sl@r/2}%
      \fancyqr@slime@tip\fancyqr@sl@q\fancyqr@sl@X{32768+\fancyqr@sl@r/2}%
   \else
      \fancyqr@slime@tip\fancyqr@sl@x\fancyqr@sl@X{65536}%
   \fi
   \lineto(\fancyqr@sl@pt\fancyqr@sl@X,.15)\closepath\fillpath}%
% a tip that leaves the edge at #1 and comes back at #2; #3 scales its length
\def\fancyqr@slime@tip#1#2#3{%
   \fancyqr@sl@set\fancyqr@sl@h{(#2-#1)/2}% half width
   % short drops end in a fat round tip, long ones in a thin one; the tip leans
   \fancyqr@sl@set\fancyqr@sl@u{\fancyqr@sl@r}\fancyqr@sl@set\fancyqr@sl@u{\fancyqr@sl@u*(131072-\fancyqr@sl@u)/65536}%
   \fancyqr@sl@set\fancyqr@sl@rr{11141-\fancyqr@sl@u*6554/65536+\fancyqr@sl@r*1966/65536}%
   \ifnum\fancyqr@sl@rr>\numexpr\fancyqr@sl@h*9/10\relax\fancyqr@sl@set\fancyqr@sl@rr{\fancyqr@sl@h*9/10}\fi
   \fancyqr@sl@set\fancyqr@sl@l{(#3)*(6554+(\dimexpr\fancyqr@slime@length\p@\relax-6554)*\fancyqr@sl@u/65536)/65536
      -\fancyqr@sl@rr}%
   \ifnum\fancyqr@sl@l<\numexpr\fancyqr@sl@rr*3/5\relax\fancyqr@sl@set\fancyqr@sl@l{\fancyqr@sl@rr*3/5}\fi
   \fancyqr@sl@set\fancyqr@sl@m{(#1+#2)/2+(\fancyqr@sl@r-32768)*(\fancyqr@sl@h-\fancyqr@sl@rr)/65536}%
   % the flanks flare from the edge into a neck of half width w at depth n,
   % which swells into the tip (a neck as wide as the tip makes a blob); the
   % base sags by v before it narrows
   \fancyqr@sl@set\fancyqr@sl@w{\fancyqr@sl@rr*(29491+\fancyqr@sl@r/2)/65536}%
   \ifnum\fancyqr@sl@round=\@ne\fancyqr@sl@set\fancyqr@sl@w{\fancyqr@sl@rr*(39000+\fancyqr@sl@r*8000/65536)/65536}%
      \fancyqr@sl@set\fancyqr@sl@l{19000+\fancyqr@sl@r*6554/65536-\fancyqr@sl@rr}\fi
   \fancyqr@sl@set\fancyqr@sl@n{\fancyqr@sl@l*(19661+\fancyqr@sl@r*19661/65536)/65536}%
   \fancyqr@sl@set\fancyqr@sl@v{\fancyqr@sl@r}\fancyqr@sl@set\fancyqr@sl@v{\fancyqr@sl@v*\fancyqr@sl@v/65536}%
   \ifnum\fancyqr@sl@round=\@ne\fancyqr@sl@set\fancyqr@sl@v{3000}\fi
   \fancyqr@slime@flank#1{-1}%
   \curveto(\fancyqr@sl@pt{\fancyqr@sl@m-\fancyqr@sl@w},\fancyqr@sl@pt{-\fancyqr@sl@n-\fancyqr@sl@k})%
      (\fancyqr@sl@pt{\fancyqr@sl@m-\fancyqr@sl@rr},\fancyqr@sl@pt{-\fancyqr@sl@l+\fancyqr@sl@rr*11/20})%
      (\fancyqr@sl@pt{\fancyqr@sl@m-\fancyqr@sl@rr},\fancyqr@sl@pt{-\fancyqr@sl@l})%
   \circlearc{\fancyqr@sl@pt\fancyqr@sl@m}{\fancyqr@sl@pt{-\fancyqr@sl@l}}{\fancyqr@sl@pt\fancyqr@sl@rr}{180}{360}%
   \curveto(\fancyqr@sl@pt{\fancyqr@sl@m+\fancyqr@sl@rr},\fancyqr@sl@pt{-\fancyqr@sl@l+\fancyqr@sl@rr*11/20})%
      (\fancyqr@sl@pt{\fancyqr@sl@m+\fancyqr@sl@w},\fancyqr@sl@pt{-\fancyqr@sl@n-\fancyqr@sl@k})%
      (\fancyqr@sl@pt{\fancyqr@sl@m+\fancyqr@sl@w},\fancyqr@sl@pt{-\fancyqr@sl@n})%
   \fancyqr@slime@flank#2{1}}%
% the part of a flank between the edge point #1 and the neck, #2 is -1 on the
% left (drawn down) and 1 on the right (drawn up)
\def\fancyqr@slime@flank#1#2{%
   \fancyqr@sl@set\fancyqr@sl@k{(\fancyqr@sl@l-\fancyqr@sl@n)*9/20}%
   \edef\@tempa{(\fancyqr@sl@pt{#1+(65536-\fancyqr@sl@v)*(\fancyqr@sl@m+#2*\fancyqr@sl@w-#1)/163840},
      \fancyqr@sl@pt{-\fancyqr@sl@v*\fancyqr@sl@n/65536})%
      (\fancyqr@sl@pt{\fancyqr@sl@m+#2*\fancyqr@sl@w},\fancyqr@sl@pt{-\fancyqr@sl@n*2/5})}%
   \ifnum#2<\z@
      \expandafter\curveto\@tempa(\fancyqr@sl@pt{\fancyqr@sl@m-\fancyqr@sl@w},\fancyqr@sl@pt{-\fancyqr@sl@n})%
   \else
      \expandafter\fancyqr@slime@up\@tempa(\fancyqr@sl@pt{#1},0)%
   \fi}%
\def\fancyqr@slime@up(#1)(#2){\curveto(#2)(#1)}%
% every object is a figure of its own (see \FancyQrFigureGallery); the chances
% are shares of the tunables, so that the counts per code stay about the same
\FancyQrFigure*{skull}{\fancyqr@skull@chance*(1-\fancyqr@pumpkin@chance)}{xx/xx}{\fancyqr@hw@go{0}{2}{2}{\fancyqr@skull}}%
% J: a jack-o'-lantern on a 2x2 block (#1 its name)
\def\fancyqr@hw@J#1#2#3#4{\FancyQrFigure*{jack/#1}{\fancyqr@skull@chance*\fancyqr@pumpkin@chance*.25}{xx/xx}{\fancyqr@hw@go{0}{2}{2}{\fancyqr@hw@jack{#1}{#2}{#3}}}}%
\fancyqr@hw@J A{}0{}%
\fancyqr@hw@J B{}1{}%
\fancyqr@hw@J C{\fancyqr@hw@map{.9903}{-.1392}{.1392}{.9903}{.0097}{-.1392}}0{}%
\fancyqr@hw@J D{\fancyqr@hw@map{.9903}{.1392}{-.1392}{.9903}{-.0097}{.1392}}1{}%
\FancyQrFigure*{bigeyeball}{\fancyqr@skull@chance*.12}{xx/xx}{\fancyqr@hw@go{0}{2}{2}{\fancyqr@hw@bigeyeball}}%
\FancyQrFigure{reaper}{\fancyqr@reaper@chance*.33}{xxx/xxx/xxx}{\fancyqr@hw@go{0}{3}{3}{\fancyqr@reaper}}%
\FancyQrFigure{bigjack}{\fancyqr@reaper@chance*.33}{xxx/xxx/xxx}{\fancyqr@hw@go{0}{3}{3}{\fancyqr@hw@bigjack}}%
\FancyQrFigure{bigghost}{\fancyqr@reaper@chance}{xxx/xxx/xxx}{\fancyqr@hw@go{0}{3}{3}{\fancyqr@hw@bigghost}}%
\FancyQrFigure{tallreaper}{\fancyqr@reaper@chance}{xxx/xxx/xxx/xxx}{\fancyqr@hw@go{0}{3}{4}{\fancyqr@reaper@tall}}%
\FancyQrFigure{widejack}{\fancyqr@big@chance}{xxx/xxx}{\fancyqr@hw@go{0}{3}{2}{\fancyqr@hw@widejack}}%
\FancyQrFigure{fence/H}{\fancyqr@big@chance*.1}{xxx/xxx}{\fancyqr@hw@go{0}{3}{2}{\fancyqr@hw@fence{H}{}}}%
\FancyQrFigure{candelabra}{\fancyqr@big@chance*.58}{xxx/xxx}{\fancyqr@hw@go{0}{3}{2}{\fancyqr@hw@candelabra}}%
\FancyQrFigure{grave/A}{\fancyqr@big@chance*.21}{xx/xx/xx}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@tomb0}}%
\FancyQrFigure{grave/B}{\fancyqr@big@chance*.21}{xx/xx/xx}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@tomb1}}%
\FancyQrFigure{tallghost}{\fancyqr@big@chance*.63}{xx/xx/xx}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@tallghost}}%
\FancyQrFigure{witch/R}{\fancyqr@big@chance*.3}{xx/xx/xx}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@witch{R}{}}}%
\FancyQrFigure{witch/L}{\fancyqr@big@chance*.3}{xx/xx/xx}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@witch{L}{\fancyqr@hw@mm}}}%
\FancyQrFigure{fence/V}{\fancyqr@big@chance*.1}{xx/xx/xx}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@fence{V}{\fancyqr@hw@map{0}{1}{1}{0}{1}{-2}}}}%
\FancyQrFigure{hat}{\fancyqr@hat@chance}{0x0/xxx}{\fancyqr@hw@go{1}{3}{2}{\fancyqr@hw@hat}}%
\FancyQrFigure{batbranch}{\fancyqr@bat@chance*.85}{xxx/.x.}{\fancyqr@hw@go{0}{3}{2}{\fancyqr@hw@roost}}%
\FancyQrFigure{spider}{\fancyqr@spider@chance}{.x./xxx}{\fancyqr@hw@go{1}{3}{2}{\fancyqr@hw@spider}}%
\FancyQrFigure{cross}{\fancyqr@cross@chance}{.x./xxx/.x./.x.}{\fancyqr@hw@go{1}{3}{4}{\fancyqr@hw@cross}}%
\def\fancyqr@hw@mm{\fancyqr@hw@map{-1}00{1}{2}0}%
\def\fancyqr@hw@mu{\fancyqr@hw@map0{1}{-1}0{0}{1}}%
\def\fancyqr@hw@mv{\fancyqr@hw@map0{1}{1}0{0}{-1}}%
\def\fancyqr@hw@mw{\fancyqr@hw@map0{1}{1}0{0}{-2}}%
% shorthands for figures by the shape of their block (#1 name, #2 chance, #3
% drawing): H horizontal pair, V vertical pair, R row of three, C column of
% three, L lone module
\def\fancyqr@hw@H#1#2#3{\FancyQrFigure{#1}{#2}{.00./0xx0/.00.}{\fancyqr@hw@go{0}{2}{1}{#3}}}%
\def\fancyqr@hw@V#1#2#3{\FancyQrFigure{#1}{#2}{.0./0x0/0x0/.0.}{\fancyqr@hw@go{0}{1}{2}{#3}}}%
\fancyqr@hw@H{candy}{\fancyqr@candy@chance*.3}{\fancyqr@hw@candy{}{}0}%
\fancyqr@hw@H{toffeebar}{\fancyqr@candy@chance*.3}{\fancyqr@hw@candy{}{}1}%
\fancyqr@hw@H{lollipop/left}{\fancyqr@candy@chance*.27}{\fancyqr@hw@candy{}{}2}%
\fancyqr@hw@H{lollipop/right}{\fancyqr@candy@chance*.27}{\fancyqr@hw@candy{m}{\fancyqr@hw@mm}2}%
\fancyqr@hw@H{eyes}{\fancyqr@ghost@chance*.03}{\fancyqr@hw@eyes}%
\fancyqr@hw@H{candycane}{\fancyqr@candy@chance*.4}{\fancyqr@hw@cane{}{}}%
\fancyqr@hw@V{hangbat}{\fancyqr@bat@chance*.4}{\fancyqr@hw@hangbat}%
\fancyqr@hw@V{candle}{\fancyqr@lamp@chance*.08}{\fancyqr@hw@tallcandle}%
\fancyqr@hw@V{lantern}{\fancyqr@lamp@chance*.08}{\fancyqr@hw@lantern{2}}%
\fancyqr@hw@V{candy/up}{\fancyqr@candy@chance*.13}{\fancyqr@hw@candy{u}{\fancyqr@hw@mu}0}%
\fancyqr@hw@V{toffeebar/up}{\fancyqr@candy@chance*.13}{\fancyqr@hw@candy{u}{\fancyqr@hw@mu}1}%
\fancyqr@hw@V{lollipop/up}{\fancyqr@candy@chance*.13}{\fancyqr@hw@candy{v}{\fancyqr@hw@mv}2}%
\fancyqr@hw@V{candycane/up}{\fancyqr@candy@chance*.13}{\fancyqr@hw@cane{v}{\fancyqr@hw@mv}}%
\FancyQrFigure{bone/A}{\fancyqr@bone@chance}{.00./0xx0/0x0./.0..}{\fancyqr@hw@go{0}{2}{2}{\fancyqr@hw@bone{a}{}}}%
\FancyQrFigure{bone/B}{\fancyqr@bone@chance}{.00./0xx0/.0x0/..0.}{\fancyqr@hw@go{0}{2}{2}{\fancyqr@hw@bone{b}{\fancyqr@hw@mm}}}%
\FancyQrFigure{bone/C}{\fancyqr@bone@chance}{.0../0x0./0xx0/.00.}{\fancyqr@hw@go{0}{2}{2}{\fancyqr@hw@bone{c}{\fancyqr@hw@map{1}00{-1}00}}}%
\FancyQrFigure{bone/D}{\fancyqr@bone@chance}{..0./.0x0/0xx0/.00.}{\fancyqr@hw@go{1}{2}{2}{\fancyqr@hw@bone{d}{\fancyqr@hw@map{-1}00{-1}{2}0}}}%
\def\fancyqr@hw@R#1#2#3{\FancyQrFigure{#1}{#2}{.000./0xxx0/.000.}{\fancyqr@hw@go{0}{3}{1}{#3}}}%
\def\fancyqr@hw@C#1#2#3{\FancyQrFigure{#1}{#2}{.0./0x0/0x0/0x0/.0.}{\fancyqr@hw@go{0}{1}{3}{#3}}}%
\fancyqr@hw@R{flyingwitch}{\fancyqr@bat@chance*.45}{\fancyqr@hw@witchfly}%
\fancyqr@hw@R{flyingbat}{\fancyqr@bat@chance*.65}{\fancyqr@hw@bat}%
\fancyqr@hw@R{broom/left}{\fancyqr@broom@chance*.25}{\fancyqr@hw@broom{A}{}}%
\fancyqr@hw@R{broom/right}{\fancyqr@broom@chance*.25}{\fancyqr@hw@broom{B}{\fancyqr@hw@map{-1}00{1}{3}0}}%
\fancyqr@hw@R{wholebone/lying}{\fancyqr@bone@chance*.1}{\fancyqr@hw@bonewhole{E}{}}%
\fancyqr@hw@C{lanternlong}{\fancyqr@lamp@chance*.4}{\fancyqr@hw@lantern{3}}%
\fancyqr@hw@C{streetlamp}{\fancyqr@lamp@chance*.16}{\fancyqr@hw@streetlamp}%
\fancyqr@hw@C{jacklamp}{\fancyqr@lamp@chance*.36}{\fancyqr@hw@jacklamp}%
\fancyqr@hw@C{broom/up}{\fancyqr@broom@chance*.8}{\fancyqr@hw@broom{up}{\fancyqr@hw@mw}}%
\fancyqr@hw@C{wholebone/standing}{\fancyqr@bone@chance*.24}{\fancyqr@hw@bonewhole{F}{\fancyqr@hw@mw}}%
\FancyQrFigure{scythe/A}{\fancyqr@scythe@chance}{.00./0xx0/0x0./0x0./.0..}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@scythe{A}{}}}%
\FancyQrFigure{scythe/B}{\fancyqr@scythe@chance}{.00./0xx0/.0x0/.0x0/..0.}{\fancyqr@hw@go{0}{2}{3}{\fancyqr@hw@scythe{B}{\fancyqr@hw@mm}}}%
\def\fancyqr@hw@L#1#2#3{\FancyQrFigure{#1}{\fancyqr@ghost@chance*#2}{.0./0x0/.0.}{\fancyqr@hw@go{0}{1}{1}{\fancyqr@hw@var{14}#3}}}%
\fancyqr@hw@L{ghost}{.5}{\fancyqr@ghost}%
\fancyqr@hw@L{bat}{.025}{\fancyqr@hw@openbat}%
\fancyqr@hw@L{devil}{.025}{\fancyqr@hw@devil}%
\fancyqr@hw@L{miniskull}{.025}{\fancyqr@hw@tiny0}%
