      \Q{.88}{.24}{.08}{.08}\F\Q{.76}{.12}{.08}{.08}\F\fi}\fi\fi}%
% candies on a lone bar of two, #1 the name, #2 the map (as it is, mirrored,
% turned upright), #3 the kind: 0 a striped candy, 1 a toffee bar, both wrapped
% with darker twists (stripes and bands end on the straight edges \h@b, \h@t),
% 2 a lollipop with its stick to the left
\def\fancyqr@hw@candy#1#2#3{\fancyqr@hw@D{candy#1#3}{#2\def\h@b{.28}\def\h@t{.72}}{%
   \ifnum#3<\tw@
   \M(\P{.5}{\h@b})\L(\P{1.5}{\h@b})\C(\P{1.64}{\h@b})(\Pn{1.74}{.38})(\Pn{1.74}{.5})%
   \C(\Pn{1.74}{.62})(\P{1.64}{\h@t})(\P{1.5}{\h@t})\L(\P{.5}{\h@t})\C(\P{.36}{\h@t})(\Pn{.26}{.62})(\Pn{.26}{.5})%
   \C(\Pn{.26}{.38})(\P{.36}{\h@b})(\P{.5}{\h@b})\Z\F
   {\K{.!70!black}\M(\Pn{.3}{.5})\L(\Pn{.06}{.76})\C(\Pn{.03}{.6})(\Pn{.03}{.4})(\Pn{.06}{.24})\Z\F
   \M(\Pn{1.7}{.5})\L(\Pn{1.94}{.76})\C(\Pn{1.97}{.6})(\Pn{1.97}{.4})(\Pn{1.94}{.24})\Z\F
   \ifnum#3=\z@\M(\P{.62}{\h@b})\L(\P{.76}{\h@b})\L(\P{.9}{\h@t})\L(\P{.76}{\h@t})\Z\F
   \M(\P{1.06}{\h@b})\L(\P{1.2}{\h@b})\L(\P{1.34}{\h@t})\L(\P{1.2}{\h@t})\Z\F
   \else\M(\P{.6}{\h@b})\L(\P{.68}{\h@b})\L(\P{.68}{\h@t})\L(\P{.6}{\h@t})\Z\F
   \M(\P{1.32}{\h@b})\L(\P{1.4}{\h@b})\L(\P{1.4}{\h@t})\L(\P{1.32}{\h@t})\Z\F
   \K{.!65!white}\M(\Pn{.8}{.6})\L(\Pn{1.2}{.6})\L(\Pn{1.2}{.64})\L(\Pn{.8}{.64})\Z\F\fi}%
   \else\M(\Pn{.06}{.4})\L(\Pn{1.12}{.4})\L(\Pn{1.12}{.6})\L(\Pn{.06}{.6})\Z\F\Q{1.5}{.5}{.44}{.44}\F
   {\K{.!60!black}\T{.06}\R\M(\Pn{1.5}{.5})\C(\Pn{1.66}{.5})(\Pn{1.66}{.72})(\Pn{1.5}{.72})%
   \C(\Pn{1.26}{.72})(\Pn{1.22}{.4})(\Pn{1.5}{.34})\C(\Pn{1.8}{.28})(\Pn{1.86}{.72})(\Pn{1.6}{.86})\S}\fi}}%
% a bone broken on an L of three modules, drawn for xx/x. and mirrored (#1 the
% name, #2 the map): an upright half with knobs at its foot and a jagged top over
% the corner, and a lying half with knobs at its end and a jagged end apart from
% it; the shafts run from \h@l to \h@h. By the place: the top at height \h@t
% slants by \h@s, the end at \h@j by \h@u (up to 45 degrees), the jags of depth
% \h@a follow one of four splinter shapes, the gap between the halves varies
\def\fancyqr@hw@bone#1#2{\fancyqr@hw@var{16}\edef\fancyqr@hw@k{\fancyqr@hw@key{48}}\fancyqr@hw@var{22}%
   \fancyqr@hw@D{bone#1\fancyqr@hw@k/\fancyqr@hw@key{48}}{#2\def\h@l{.29}\def\h@h{.71}%
   \edef\h@a{\ifnum\fancyqr@hw@dig{12}2=\z@.08\else.06\fi}\edef\h@t{\ifnum\fancyqr@hw@dig{24}2=\z@.64\else.68\fi}%
   \ifcase\fancyqr@hw@dig14\fancyqr@hw@bk{-.5}{.6}{-.7}{.8}{-.6}{.2}\or\fancyqr@hw@bk{.3}{-.8}{.9}{-.3}{.6}{-.5}%
   \or\fancyqr@hw@bk0{.4}{-.2}1{-.4}0\else\fancyqr@hw@bk{-.3}{.3}{-.3}{.3}{-.3}{.3}\fi
   \edef\h@g{\ifcase\fancyqr@hw@dig43 .04\or.1\else.18\fi}%
   \def\h@d##1##2{\fpeval{floor(\fancyqr@hw@k/##1)-##2*floor(\fancyqr@hw@k/(##1*##2))}}%
   \edef\h@s{\fpeval{(\h@d32=0?1:-1)*(\h@d13=0?.15:(\h@d13=1?.36:.7))}}%
   \edef\h@u{\fpeval{(\h@d{24}2=0?1:-1)*(\h@d64=0?.27:(\h@d64=1?.47:(\h@d64=2?.7:1)))}}%
   \edef\h@j{\fpeval{min(1.12,.74+abs(\h@u)*.21+\h@a+\h@g)}}%
   \def\h@y##1##2{\P{##1}{\fpeval{\h@t+\h@s*(##1-.5)+\h@a*(##2)}}}%
   \def\h@x##1##2{\P{\fpeval{\h@j+\h@u*(##1-.5)+\h@a*(##2)}}{##1}}}{%
   \M(\P\h@l{-.7})\L(\h@y\h@l\h@pa)\L(\h@y{.37}\h@pb)\L(\h@y{.45}\h@pc)\L(\h@y{.54}\h@pd)\L(\h@y{.62}\h@pe)%
   \L(\h@y\h@h\h@pf)\L(\P\h@h{-.7})\Z\F
   \M(\P{1.7}\h@l)\L(\h@x\h@l\h@pf)\L(\h@x{.37}\h@pe)\L(\h@x{.46}\h@pd)\L(\h@x{.55}\h@pc)\L(\h@x{.63}\h@pb)%
   \L(\h@x\h@h\h@pa)\L(\P{1.7}\h@h)\Z\F
   \Q{1.71}{.67}{.19}{.19}\F\Q{1.71}{.33}{.19}{.19}\F\Q{.33}{-.71}{.19}{.19}\F\Q{.67}{-.71}{.19}{.19}\F}}%
\def\fancyqr@hw@bk#1#2#3#4#5#6{\def\h@pa{#1}\def\h@pb{#2}\def\h@pc{#3}\def\h@pd{#4}\def\h@pe{#5}\def\h@pf{#6}}%
% a spider on a module over a row of three, the abdomen up, the head below it,
% four arched legs to a side, one of them over the center of the side module; it
% hangs on a thread from a dark tile right above it, else it sits. By the place
% the legs arch higher or lower (\h@p), the abdomen is wider (\h@r), a second
% pair of eyes shows, and the spider sits a little aside or lower (\h@dx, \h@dy)
\def\fancyqr@hw@spider{\fancyqr@hw@var{21}%
   \edef\h@dx{\ifcase\fancyqr@hw@dig{12}3 0\or.04\else-.04\fi}\edef\h@dy{\ifcase\fancyqr@hw@dig{36}3 0\or-.06\else.02\fi}%
   \count@\@ne\fancyqr@hw@up
   \ifnum\count@>\z@{\linethickness{.04\unitlength}\moveto(\fpeval{1.5+\h@dx},\the\numexpr\count@\relax.4)%
      \lineto(\fpeval{1.5+\h@dx},.6)\strokepath}\fi
   \fancyqr@hw@D{spider\fancyqr@hw@h}{\fancyqr@hw@map100{1}\h@dx\h@dy\def\h@x##1##2{(##1##2)}%
   \edef\h@p{\ifcase\fancyqr@hw@dig13 0\or.03\else-.06\fi}\edef\h@r{\ifnum\fancyqr@hw@dig32=\z@.34\else.4\fi}%
   \def\h@y##1{(##1+\h@p)}%
   \def\h@l##1{\M(\P{\h@x{##1}{1.26}}{-.3})\C(\P{\h@x{##1}1}{\h@y{-.14}})(\P{\h@x{##1}{.4}}{\h@y{-.14}})(\P{\h@x{##1}{.17}}{-.34})%
      \M(\P{\h@x{##1}{1.24}}{-.4})\C(\P{\h@x{##1}{.9}}{\h@y{-.17}})(\P{\h@x{##1}{.4}}{\h@y{-.2}})(\P{\h@x{##1}{.17}}{-.62})%
      \M(\P{\h@x{##1}{1.24}}{-.5})\C(\P{\h@x{##1}{.9}}{\h@y{-.32}})(\P{\h@x{##1}{.5}}{\h@y{-.36}})(\P{\h@x{##1}{.24}}{-.84})%
      \M(\P{\h@x{##1}{1.27}}{-.58})\C(\P{\h@x{##1}1}{\h@y{-.55}})(\P{\h@x{##1}{.75}}{\h@y{-.6}})(\P{\h@x{##1}{.62}}{-.86})}}{%
   \T{.12}\R\h@l{}\h@l{3-}\S
   \Q{1.5}{.28}\h@r{.45}\F\Q{1.5}{-.42}{.3}{.3}\F
   {\K{.!65!black}\M(\Pn{1.38}{.5})\L(\Pn{1.62}{.5})\L(\Pn{1.5}{.3})\Z\M(\Pn{1.5}{.24})\L(\Pn{1.62}{.04})\L(\Pn{1.38}{.04})\Z\F
   \K{.!45!yellow}\Q{1.4}{-.5}{.05}{.05}\F\Q{1.6}{-.5}{.05}{.05}\F
   \ifnum\fancyqr@hw@dig62=\z@\else\Q{1.44}{-.36}{.035}{.035}\F\Q{1.56}{-.36}{.035}{.035}\F\fi}}}%
% the cores of the finder and alignment patterns, drawn in [-.5,.5] and scaled:
% a pumpkin, a jack-o'-lantern, a ghost or a skull, drawn at random for each
% pattern (\fancyqr@hw@coredraw); all of them dark and without strong edges
% inside, so that they read as a block
\def\fancyqr@shape@halloween#1#2#3{%
   \edef\@fq@s{\fpeval{(#2-#1)*((#2-#1)<2 ? \fancyqr@star@boost : 1)}}%
   \edef\@fq@c{\fpeval{(#1+#2)/2}}%
   % only the alignment patterns get a tint inside: in a finder it costs scanners;
   % none in the galleries, where the faint ring would make it look filled
   \iffancyqr@faint@\else\ifdim\fpeval{#2-#1}\p@<2\p@\ifx\fancyqr@finder@style\fancyqr@hw@rounded
      {\fancyqr@hw@tint\fancyqr@hw@inner{#2}\fillpath}\fi\fi\fi
   \put(\@fq@c,\@fq@c){\unitlength=\@fq@s\unitlength
      \ifdim\@fq@s\p@<2\p@\fancyqr@mixcolor{.!70!orange}\let\fancyqr@hw@pk\fancyqr@hw@apk\fi
      \ifcase\fancyqr@hw@coredraw\relax
         \fancyqr@hw@cpumpkin\or\fancyqr@hw@cjack\or\fancyqr@hw@cghost\else\fancyqr@hw@cskull\fi}}%
% the inside of a rounded ring around a core that ends at #1 (the pattern is
% #1+2 wide), for a pale tint (\fancyqr@hw@tint): the inner edge of the ring,
% corners and all
\def\fancyqr@hw@rounded{rounded}%
\def\fancyqr@hw@tint{\fancyqr@mixcolor{.!12!white}}%
\def\fancyqr@hw@inner#1{%
   \edef\@fq@l{\fancyqr@finder@thickness}\edef\@fq@h{\fpeval{#1+2-\@fq@l}}%
   \edef\@fq@r{\fpeval{max(0,\fancyqr@finder@radius*(#1+2-\@fq@l)/2-\@fq@l/2)}}%
   \edef\@fq@k{\fpeval{.4477*\@fq@r}}%
   \moveto(\fpeval{\@fq@l+\@fq@r},\@fq@l)\lineto(\fpeval{\@fq@h-\@fq@r},\@fq@l)%
   \curveto(\fpeval{\@fq@h-\@fq@k},\@fq@l)(\@fq@h,\fpeval{\@fq@l+\@fq@k})(\@fq@h,\fpeval{\@fq@l+\@fq@r})%
   \lineto(\@fq@h,\fpeval{\@fq@h-\@fq@r})%
   \curveto(\@fq@h,\fpeval{\@fq@h-\@fq@k})(\fpeval{\@fq@h-\@fq@k},\@fq@h)(\fpeval{\@fq@h-\@fq@r},\@fq@h)%
   \lineto(\fpeval{\@fq@l+\@fq@r},\@fq@h)%
   \curveto(\fpeval{\@fq@l+\@fq@k},\@fq@h)(\@fq@l,\fpeval{\@fq@h-\@fq@k})(\@fq@l,\fpeval{\@fq@h-\@fq@r})%
   \lineto(\@fq@l,\fpeval{\@fq@l+\@fq@r})%
   \curveto(\@fq@l,\fpeval{\@fq@l+\@fq@k})(\fpeval{\@fq@l+\@fq@k},\@fq@l)(\fpeval{\@fq@l+\@fq@r},\@fq@l)\closepath}%
\def\fancyqr@hw@coredraw{\csname int_rand:nn\endcsname{0}{3}}%
% a value mod 4, #1 an expression that is not negative
\def\fancyqr@hw@mod#1{(#1-4*((#1-2)/4))}%
\def\fancyqr@hw@cbody{\fancyqr@hw@pk
   \fancyqr@hw@P{cp}{\fancyqr@hw@ell{-.2}{-.04}{.3}{.43}\fancyqr@hw@ell{.2}{-.04}{.3}{.43}%
      \fancyqr@hw@ell{0}{-.04}{.28}{.46}}\fillpath
   {\fancyqr@hw@stem\fancyqr@hw@stemat{0}{.34}{.5}}}%
\def\fancyqr@hw@cpumpkin{{\fancyqr@hw@cbody
   \fancyqr@hw@crib\linethickness{.04\unitlength}%
   \moveto(-.08,.34)\curveto(-.22,.12)(-.22,-.24)(-.08,-.44)\strokepath
   \moveto(.08,.34)\curveto(.22,.12)(.22,-.24)(.08,-.44)\strokepath
   \moveto(-.3,.3)\curveto(-.44,.1)(-.44,-.22)(-.3,-.4)\strokepath
   \moveto(.3,.3)\curveto(.44,.1)(.44,-.22)(.3,-.4)\strokepath}}%
% the jack-o'-lantern core: triangular eyes (inner x \h@i, outer \h@o, base
% \h@y, tip \h@t) and a grin from corner to corner (\h@c) with two teeth
% (\h@d to \h@e) hanging from its top
\def\fancyqr@hw@cjack{{\fancyqr@hw@cbody\fancyqr@hw@cglow
   \fancyqr@hw@D{cjack}{\def\h@i{.07}\def\h@o{.33}\def\h@y{.05}\def\h@t{.27}\def\h@c{.32,-.1}%
      \def\h@d{.05}\def\h@e{.14}\def\h@f{-.16}\def\h@g{-.25}}{%
   \M(-\h@o,\h@y)\L(-\h@i,\h@y)\L(-.2,\h@t)\Z\M(\h@o,\h@y)\L(\h@i,\h@y)\L(.2,\h@t)\Z
   \M(-\h@c)\L(-\h@e,\h@f)\L(-\h@e,\h@g)\L(-\h@d,\h@g)\L(-\h@d,\h@f)\L(\h@d,\h@f)%
   \L(\h@d,\h@g)\L(\h@e,\h@g)\L(\h@e,\h@f)\L(\h@c)\C(.26,-.36)(.14,-.42)(0,-.42)%
   \C(-.14,-.42)(-.26,-.36)(-\h@c)\Z\F}}}%
\def\fancyqr@hw@cghost{%
   \moveto(-.47,-.46)\lineto(-.47,0)\curveto(-.47,.32)(-.26,.49)(0,.49)\curveto(.26,.49)(.47,.32)(.47,0)%
   \lineto(.47,-.46)\curveto(.4,-.36)(.32,-.36)(.24,-.48)\curveto(.16,-.36)(.08,-.36)(0,-.48)%
   \curveto(-.08,-.36)(-.16,-.36)(-.24,-.48)\curveto(-.32,-.36)(-.4,-.36)(-.47,-.46)\closepath\fillpath
   {\fancyqr@hw@dkk
   \fancyqr@hw@P{cg}{\fancyqr@hw@ell{-.17}{.1}{.09}{.13}\fancyqr@hw@ell{.17}{.1}{.09}{.13}}\fillpath}}%
\def\fancyqr@hw@cskull{\fancyqr@hw@D{cskull}{}{%
   \O0{.02}{.48}\F\M(-.34,-.16)\L(.34,-.16)\L(.3,-.42)\C(.29,-.47)(.25,-.49)(.2,-.49)%
   \L(-.2,-.49)\C(-.25,-.49)(-.29,-.47)(-.3,-.42)\Z\F
   {\K{.!55!black}\O{-.18}{.04}{.13}\F\O{.18}{.04}{.13}\F\M(0,-.1)\L(.06,-.22)\L(-.06,-.22)\Z\F
   \T{.04}\R\M(-.09,-.31)\L(-.09,-.44)\M(0,-.31)\L(0,-.44)\M(.09,-.31)\L(.09,-.44)\S}}}%
\def\fancyqr@halloween@tile#1#2#3#4{\FancyQrFigureTile{%
   \FancyQrIfTiming{\ifnum\@up\@left\@right\@down=\z@\FancyQrIfExtra{timing}{\fancyqr@hw@timing}{\fancyqr@rounded@rect#1#2#3#4}\else
      \fancyqr@hw@tile#1#2#3#4\fi}{\fancyqr@hw@tile#1#2#3#4}}}%
