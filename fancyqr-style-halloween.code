      \Q{.54}{.24}{.03}{.03}\F\Q{.36}{.46}{.05}{.07}\F}%
   \else\T{.14}\R\M(.2,.2)\L(.8,.8)\M(.2,.8)\L(.8,.2)\S\Q{.12}{.24}{.08}{.08}\F\Q{.24}{.12}{.08}{.08}\F
