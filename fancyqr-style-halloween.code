      \T{.025}\M(.5,.63)\L(.5,.7)\S\K{.!45!yellow}\M(.5,.7)\C(.56,.76)(.56,.84)(.5,.95)\C(.44,.84)(.44,.76)(.5,.7)\Z\F}%
