   \M(.1,.76)\L(.1,-.7)\C(.1,-.88)(.55,-.97)(1,-.97)\C(1.45,-.97)(1.9,-.88)(1.9,-.7)\L(1.9,.76)\Z\F
   \K\h@r\M(.1,-.58)\C(.1,-.76)(.55,-.85)(1,-.85)\C(1.45,-.85)(1.9,-.76)(1.9,-.58)\L(1.9,-.7)%
   \C(1.9,-.88)(1.45,-.97)(1,-.97)\C(.55,-.97)(.1,-.88)(.1,-.7)\Z
   \M(.1,.77)\L(.1,.6)\C(.1,.48)(.55,.42)(1,.42)\C(1.45,.42)(1.9,.48)(1.9,.6)\L(1.9,.77)\Z\F
   \K{gold}\T{.045}\R\M(.12,.46)\L(1,-.83)\L(1.88,.46)\M(.14,-.64)\L(1,.42)\L(1.86,-.64)\S
   \K{cream!80!fancyqr@xm@fur}\E(1,.77){.9}{.17}\F\K\h@r\T{.04}\E(1,.77){.9}{.17}\S
   \K{bark}\T{.07}\M(.42,.7)\L(1.38,.9)\M(1.58,.7)\L(.62,.9)\S\K{cream}\O(1.38,.9){.06}\O(.62,.9){.06}\F}}}%
