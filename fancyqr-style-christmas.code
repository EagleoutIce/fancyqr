   \K{gold}\T{.05}\M(.2,-.3)\L(2.3,-.3)\C(2.5,-.3)(2.6,-.2)(2.64,0)\S
   \M(2.86,.52)\C(2.8,.62)(2.66,.62)(2.62,.52)\S
   \K{fur}\M(.12,0)\C(.04,.5)(.24,.84)(.62,.86)\C(1,.84)(1.28,.5)(1.22,0)\Z
   \M(.56,.84)\C(.5,.92)(.54,.97)(.62,.96)\L(.74,.94)\C(.8,.9)(.74,.84)(.68,.82)\Z\F
   \K{fur!70!black}\M(1.2,.4)\C(1.16,.2)(.9,.06)(.6,.08)\C(.9,.14)(1.1,.26)(1.2,.4)\Z\F
   \K\h@p\B(1.3,0)(2.25,.8)\F
   \K{gold}\B(1.73,0)(1.82,.8)\B(1.3,.62)(2.25,.7)\F
   \M(1.775,.8)\C(1.66,.96)(1.5,.96)(1.52,.86)\C(1.54,.8)(1.66,.8)(1.775,.8)\Z
   \M(1.775,.8)\C(1.89,.96)(2.05,.96)(2.03,.86)\C(2.01,.8)(1.89,.8)(1.775,.8)\Z\F}}}%
