   \K\h@c\M(.16,.7)\L(.84,.7)\L(.84,-.1)\C(.86,-.14)(.95,-.14)(1.05,-.14)\L(1.62,-.14)%
   \C(1.84,-.14)(1.95,-.32)(1.95,-.54)\C(1.95,-.78)(1.8,-.95)(1.56,-.95)\L(.48,-.95)%
   \C(.22,-.95)(.05,-.8)(.05,-.56)\C(.05,-.4)(.1,-.28)(.16,-.2)\Z\F
   \K{cream}\M(.05,-.56)\C(.05,-.8)(.22,-.95)(.48,-.95)\C(.34,-.9)(.14,-.78)(.05,-.56)\Z
   \M(1.62,-.14)\C(1.84,-.14)(1.95,-.32)(1.95,-.54)\C(1.95,-.78)(1.8,-.95)(1.56,-.95)%
