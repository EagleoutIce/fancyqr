\def\fancyqr@xm@sock{\fancyqr@xm@fit{\edef\fancyqr@xm@v{\fancyqr@xm@var{41}4}%
   \fancyqr@xm@D{sock\fancyqr@xm@v}{\ifodd\fancyqr@xm@v\relax\fancyqr@xm@mirror1\fi
      \def\h@c{\ifnum\fancyqr@xm@v<2 red\else berry\fi}}{%
   \K\h@c\M(.22,.72)\L(.7,.72)\L(.7,-.38)\C(.7,-.46)(.76,-.5)(.84,-.54)\C(.97,-.6)(.98,-.9)(.8,-.95)%
   \L(.38,-.95)\C(.24,-.95)(.18,-.84)(.2,-.7)\Z\F
   \K{cream}\M(.84,-.54)\C(.97,-.6)(.98,-.9)(.8,-.95)\C(.87,-.82)(.88,-.66)(.84,-.54)\Z
   \M(.38,-.95)\C(.24,-.95)(.18,-.84)(.2,-.7)\C(.25,-.8)(.32,-.85)(.42,-.86)\Z
   \B(.22,.28)(.7,.36)\B(.22,.1)(.7,.18)%
   \M(.22,.66)\L(.7,.66)\A(.7,.73){.07}{-90}{0}\L(.77,.88)\A(.7,.88){.07}{0}{90}%
   \L(.22,.95)\A(.22,.88){.07}{90}{180}\L(.15,.73)\A(.22,.73){.07}{180}{270}\Z\F}}}%
% the timing patterns are decorated where a dark module stands alone (one that
% joins its neighbours keeps its tile; no figure takes a module of a timing
% pattern): by the seeded generator a round or a pointed bulb, a bauble, a
% small gift or a star, in a soft glow, in the tile color (always if there is a
% timing color), cranberry, red or dark gold
\def\fancyqr@xm@light#1#2#3#4{\ifnum#1#2#3#4=1111
      \edef\@tempa{\fancyqr@xm@rand5\ifx\fancyqr@timing@color\@empty\fancyqr@xm@rand4\else0\fi}%
      \fancyqr@xm@fit{\fancyqr@xm@D{t\@tempa}{}{{\K{gold!12!white}\O(.5,.5){.47}\F}%
         {\expandafter\fancyqr@xm@item\@tempa}%
         \ifcase\expandafter\@firstoftwo\@tempa\space\fancyqr@xm@cap{.31,.6}\or\fancyqr@xm@cap{.4,.6}%
         \or\fancyqr@xm@cap{.34,.58}\fi}}%
   \else\fancyqr@rounded@rect#1#2#3#4\fi}%
\def\fancyqr@xm@rand#1{\the\numexpr\csname int_rand:nn\endcsname{0}{#1-1}\relax}%
\def\fancyqr@xm@cap#1{\K{gold}\M(.39,.78)\L(.61,.78)\L(.59,.9)\L(.41,.9)\Z\F\K{cream!65!.}\O(#1){.06}\F}%
\def\fancyqr@xm@item#1#2{\ifcase#2 \KK{.}\or\K{berry}\or\K{red}\else\K{deepgold!70!black}\fi
   \ifcase#1
      \M(.38,.8)\L(.62,.8)\C(.66,.7)(.9,.62)(.9,.42)\A(.5,.42){.4}{0}{-180}\C(.1,.62)(.34,.7)(.38,.8)\Z\F
   \or
      \M(.39,.8)\L(.61,.8)\C(.68,.68)(.8,.5)(.76,.3)\C(.72,.12)(.58,.03)(.5,.02)%
      \C(.42,.03)(.28,.12)(.24,.3)\C(.2,.5)(.32,.68)(.39,.8)\Z\F
   \or\O(.5,.4){.38}\F
   \or\B(.14,.06)(.86,.68)\F\ifnum#2=\z@\K{berry}\else\K{pine}\fi\B(.44,.06)(.56,.68)\B(.14,.3)(.86,.42)\F
      \K{gold}\M(.5,.68)\C(.4,.86)(.24,.86)(.26,.76)\C(.28,.68)(.4,.68)(.5,.68)\Z
      \M(.5,.68)\C(.6,.86)(.76,.86)(.74,.76)\C(.72,.68)(.6,.68)(.5,.68)\Z\F
   \else\M(.5,.92)\fancyqr@xm@pt{126}{.45}\fancyqr@xm@pt{162}1\fancyqr@xm@pt{198}{.45}\fancyqr@xm@pt{234}1%
      \fancyqr@xm@pt{270}{.45}\fancyqr@xm@pt{306}1\fancyqr@xm@pt{342}{.45}\fancyqr@xm@pt{18}1%
      \fancyqr@xm@pt{54}{.45}\Z\F
   \fi}%
\def\fancyqr@xm@pt#1#2{\L({.5+.47*#2*cosd(#1)},{.45+.47*#2*sind(#1)})}%
\def\fancyqr@christmas@tile#1#2#3#4{\FancyQrFigureTile{\FancyQrIfTiming
   {\FancyQrIfExtra{timing}{\fancyqr@xm@light#1#2#3#4}{\fancyqr@rounded@rect#1#2#3#4}}{\fancyqr@rounded@rect#1#2#3#4}}}%
% the finder patterns are wreaths: a soft texture of needles in a darker
% green, a few gold lights and a bow, around a core that the seeded generator
% picks for each finder (see \fancyqr@xm@core); #1 top row, #2 left column, #3
% size
\def\fancyqr@xm@pattern#1#2#3{%
   \iffancyqr@inalign@\else
   \put(#2,\the\numexpr\@max@y-#1-#3+\@ne\relax){%
      \fancyqr@fixedcolor{\roundcap
         {\fancyqr@mixcolor{.!80!black}\linethickness{.035\unitlength}%
         \fancyqr@xm@path{w#3}{\fancyqr@xm@needles{#3}}\strokepath}%
         \color{fancyqr@xm@gold}\linethickness{.17\unitlength}%
         \fancyqr@xm@path{g#3}{\fancyqr@xm@dot{2}{#3-.5}\fancyqr@xm@dot{#3-2}{#3-.5}\fancyqr@xm@dot{.5}{2}%
            \fancyqr@xm@dot{.5}{#3-2}\fancyqr@xm@dot{#3-.5}{2}\fancyqr@xm@dot{#3-.5}{#3-2}}%
         \strokepath
         \color{fancyqr@xm@berry!85!black}\linethickness{.18\unitlength}%
         \fancyqr@xm@path{o#3}{\fancyqr@xm@bow{#3/2}}\strokepath
         \buttcap}%
      \put(\fpeval{#3/2},\fpeval{#3/2}){\unitlength\fpeval{(#3-4)/3}\unitlength\fancyqr@xm@core}%
   }\fi}%
% the cores, around (0,0) in the 3x3 modules of a finder's core: a bauble, a
% ring of light, a gift, a small wreath, a snowflake or two candy canes in a
% knot, all in dark tones (a light line in a core keeps scanners from
% finding the pattern)
\def\fancyqr@xm@core{\edef\fancyqr@xm@v{\fancyqr@xm@rand6}%
   \fancyqr@xm@D{core\fancyqr@xm@v}{\def\h@b##1{\M(0,1.2)\C(##1*.3,1.46)(##1*.7,1.45)(##1*.64,1.3)%
      \C(##1*.58,1.2)(##1*.3,1.19)(0,1.2)\Z}}{%
   \ifcase\fancyqr@xm@v\relax
      \K{berry!62!black}\O(0,0){1.5}\F\K{berry}\O(-.1,.1){1.32}\F
      \K{berry!72!fancyqr@xm@cream}\O(-.62,.62){.13}\F\K{deepgold!50!black}\B(-.13,1.27)(.13,1.45)\F
   \or\K{deep}\O(0,0){1.5}\F\K{gold!40!fancyqr@xm@deep}\T{.26}\O(0,0){1.2}\S
      \K{gold!25!fancyqr@xm@deep}\T{.12}\O(0,0){.62}\S\K{gold!55!fancyqr@xm@deep}\fancyqr@xm@studs0{8}{1.2}{.06}{22.5}\F
   \or\K{berry}\B(-1.5,-1.5)(1.5,1.5)\F\K{berry!78!black}\B(-1.5,.86)(1.5,1.18)\F
      \K{pine}\B(-.17,-1.5)(.17,1.5)\B(-1.5,-.17)(1.5,.17)\F\K{gold}\h@b{-1}\h@b1\F
   \or\K{pine!80!black}\O(0,0){1.5}\F\K{teal!80!black}\T{.06}\R
      \fancyqr@xm@spk0{20}{.9}{1.38}0\fancyqr@xm@spk0{20}{.8}{1.2}{9}\S
      \K{berry}\O(0,0){.62}\F\K{gold!45!fancyqr@xm@pine}\fancyqr@xm@studs0{6}{1.12}{.08}{30}\F
   \or\K{teal!60!black}\O(0,0){1.5}\F\K{frost!65!black}\T{.1}\R\fancyqr@xm@spk0{6}{0}{1.22}{90}%
      \fancyqr@xm@twig{90}\fancyqr@xm@twig{150}\fancyqr@xm@twig{210}\fancyqr@xm@twig{270}%
      \fancyqr@xm@twig{330}\fancyqr@xm@twig{30}\S
   \else\K{pine!65!black}\O(0,0){1.5}\F
   \fi}%
   \ifnum\fancyqr@xm@v=5 \fancyqr@xm@D{core5a}{\fancyqr@xm@turn{-28}}{\fancyqr@xm@kcane}%
      \fancyqr@xm@D{core5b}{\fancyqr@xm@map{-cosd(28)}{-sind(28)}{-sind(28)}{cosd(28)}00}{\fancyqr@xm@kcane}%
      \fancyqr@xm@D{core5c}{}{\K{berry!70!black}\M(0,0)\C(-.2,.3)(-.5,.3)(-.45,.08)%
      \C(-.42,-.08)(-.2,-.05)(0,0)\C(.2,-.05)(.42,-.08)(.45,.08)\C(.5,.3)(.2,.3)(0,0)\Z\F\O(0,0){.1}\F}\fi}%
% a candy cane leaning by the map, shaft and crook, stripes clear of the
% module centers
\def\fancyqr@xm@kcane{\K{red}\T{.42}\R\M(0,-1.06)\L(0,.5)\A(.34,.5){.34}{180}{0}\L(.68,.32)\S
   \K{berry!55!black}\T{.07}\M(-.21,-.78)\L(.21,-.62)\M(-.21,-.36)\L(.21,-.2)\M(-.21,.18)\L(.21,.34)\S}%
\def\fancyqr@xm@turn#1{\fancyqr@xm@map{cosd(#1)}{-sind(#1)}{sind(#1)}{cosd(#1)}00}%
% #2 strokes (from #1 on) from radius #3 to #4, turned by #5 and leaning by
% 12 degrees; dots of radius #4 on radius #3; the 5-pointed star outline
% from the top with radii #1, #2; a branch pair on the arm at #1 degrees
\def\fancyqr@xm@spk#1#2#3#4#5{\ifnum#1<#2
   \M({#3*cosd(360*#1/#2+#5)},{#3*sind(360*#1/#2+#5)})%
   \L({#4*cosd(360*#1/#2+#5+(#3>0)*12)},{#4*sind(360*#1/#2+#5+(#3>0)*12)})%
   \expandafter\fancyqr@xm@spk\expandafter{\the\numexpr#1+1\relax}{#2}{#3}{#4}{#5}\fi}%
\def\fancyqr@xm@studs#1#2#3#4#5{\ifnum#1<#2
   \O({#3*cosd(360*#1/#2+#5)},{#3*sind(360*#1/#2+#5)}){#4}%
   \expandafter\fancyqr@xm@studs\expandafter{\the\numexpr#1+1\relax}{#2}{#3}{#4}{#5}\fi}%
\def\fancyqr@xm@spt#1#2#3{\fancyqr@xm@rp{#2}{#3+36}\fancyqr@xm@rp{#1}{#3+72}\fancyqr@xm@rp{#2}{#3+108}%
   \fancyqr@xm@rp{#1}{#3+144}\fancyqr@xm@rp{#2}{#3+180}\fancyqr@xm@rp{#1}{#3+216}\fancyqr@xm@rp{#2}{#3+252}%
   \fancyqr@xm@rp{#1}{#3+288}\fancyqr@xm@rp{#2}{#3+324}\Z}%
\def\fancyqr@xm@rp#1#2{\L({#1*cosd(#2)},{#1*sind(#2)})}%
\def\fancyqr@xm@twig#1{\M({.72*cosd(#1)},{.72*sind(#1)})\L({1.02*cosd(#1+22)},{1.02*sind(#1+22)})%
   \M({.72*cosd(#1)},{.72*sind(#1)})\L({1.02*cosd(#1-22)},{1.02*sind(#1-22)})}%
\def\fancyqr@xm@dot#1#2{\noexpand\moveto\fancyqr@xm@p{#1}{#2}\noexpand\lineto\fancyqr@xm@p{#1}{#2}}%
% fine needles along the straight parts of the ring, leaning back from its
% middle line
\def\fancyqr@xm@needles#1{\fancyqr@xm@nz{#1}1.75/2.05/2.35/2.65/2.95/3.25/3.55/3.85/4.15/4.45/4.75/5.05/\relax/}%
\def\fancyqr@xm@nz#1#2/{\ifx\relax#2\else\fancyqr@xm@nd{#1}{#2}\expandafter\fancyqr@xm@nz\expandafter{\expandafter#1\expandafter}\fi}%
\def\fancyqr@xm@nd#1#2{%
   \fancyqr@xm@ndl{#2}{.55}{#2-.16}{.8}\fancyqr@xm@ndl{#2+.15}{.45}{#2-.01}{.2}%
   \fancyqr@xm@ndl{#1-#2}{#1-.55}{#1-#2+.16}{#1-.8}\fancyqr@xm@ndl{#1-#2-.15}{#1-.45}{#1-#2+.01}{#1-.2}%
   \fancyqr@xm@ndl{.55}{#1-#2}{.8}{#1-#2+.16}\fancyqr@xm@ndl{.45}{#1-#2-.15}{.2}{#1-#2+.01}%
   \fancyqr@xm@ndl{#1-.55}{#2}{#1-.8}{#2-.16}\fancyqr@xm@ndl{#1-.45}{#2+.15}{#1-.2}{#2-.01}}%
\def\fancyqr@xm@ndl#1#2#3#4{\noexpand\moveto\fancyqr@xm@p{#1}{#2}\noexpand\lineto\fancyqr@xm@p{#3}{#4}}%
% a bow at the bottom of the ring around x=#1: two loops (#2 the sign of the
% side) and the tails
\def\fancyqr@xm@wing#1#2{\noexpand\moveto\fancyqr@xm@p{#1}{.5}\noexpand\curveto\fancyqr@xm@p{#1#2.25}{.85}\fancyqr@xm@p{#1#2.6}{.8}%
      \fancyqr@xm@p{#1#2.58}{.5}\noexpand\curveto\fancyqr@xm@p{#1#2.56}{.22}\fancyqr@xm@p{#1#2.25}{.2}%
      \fancyqr@xm@p{#1}{.5}\noexpand\closepath\noexpand\fillpath}%
\def\fancyqr@xm@bow#1{\fancyqr@xm@wing{#1}-\fancyqr@xm@wing{#1}+
   \noexpand\moveto\fancyqr@xm@p{#1-.08}{.5}\noexpand\lineto\fancyqr@xm@p{#1-.3}{.02}%
      \noexpand\lineto\fancyqr@xm@p{#1-.12}{.06}\noexpand\lineto\fancyqr@xm@p{#1}{.4}%
      \noexpand\lineto\fancyqr@xm@p{#1+.12}{.06}\noexpand\lineto\fancyqr@xm@p{#1+.3}{.02}%
      \noexpand\lineto\fancyqr@xm@p{#1+.08}{.5}\noexpand\closepath\noexpand\fillpath
   \noexpand\moveto\fancyqr@xm@p{#1}{.5}\noexpand\lineto\fancyqr@xm@p{#1}{.5}}%
% snow lies on the tiles and wreaths as in the style `snow', but not on or under
% figures
\let\fancyqr@xm@lend\FancyQrLend\let\FancyQrLend\@gobbletwo
\input{fancyqr-style-snow.code}\fancyqr@style@undo\let\FancyQrLend\fancyqr@xm@lend
% ... no figure takes a module of the timing patterns
\let\fancyqr@xm@snowbegin\fancyqr@style@begin
\def\fancyqr@style@begin{\fancyqr@xm@snowbegin
   \fancyqr@fig@block7\@ne\@ne\@max@x\fancyqr@fig@block\@ne7\@max@y\@ne}%
% ... the outline only follows the top of the snow, so that it lies flush on
% the tile
\def\fancyqr@snow@draw#1#2{%
   \unitlength\qr@modulesize
   \fancyqr@snow@waves{#1}{#2}%
   \roundjoin\roundcap\linethickness{.05\unitlength}%
   \color{\fancyqr@snow@color}\fancyqr@snow@path\lineto\fillpath
   \color{\fancyqr@snow@line}%
   \ifnum\fancyqr@snow@l=\@ne\expandafter\moveto\fancyqr@snow@end\fancyqr@snow@lc
   \else\moveto(0,\fancyqr@snow@tl)\fi
   \fancyqr@snow@up
   \ifnum\fancyqr@snow@r=\@ne\expandafter\fancyqr@xm@first\fancyqr@snow@rc\@nil\fi\strokepath
   \ifnum\fancyqr@xm@rand3=\z@\fancyqr@xm@glint{\fpeval{\fancyqr@snow@xl+(\fancyqr@snow@xr-\fancyqr@snow@xl)%
      *\fancyqr@xm@rand{60}/100+.2*(\fancyqr@snow@xr-\fancyqr@snow@xl)}}%
      {\fpeval{\fancyqr@snow@one+.5*\fancyqr@snow@height}}\fi}%
\def\fancyqr@xm@first#1#2#3#4#5#6#7\@nil{#1{#2}{#3}{#4}{#5}{#6}}%
% no glints any more; the draw stays so that the seeded sequence keeps its place
\def\fancyqr@xm@glint#1#2{}%
\let\fancyqr@xm@snowrings\fancyqr@fixed@extra
\def\fancyqr@fixed@extra{\fancyqr@drawpatterns\fancyqr@xm@pattern\fancyqr@xm@snowrings\fancyqr@xm@decor}%
\def\fancyqr@xm@snowtile#1#2#3#4{\ifnum\fancyqr@pass=\@ne\fancyqr@christmas@tile#1#2#3#4%
   \else\edef\@tempa{\FancyQrFigureAt{\the\i}{\the\j}\fancyqr@xm@figabove{\the\j}}%
      \ifx\@tempa\@empty\FancyQrIfTiming{}{\fancyqr@xm@snowcap}\fi\fi}%
% the figures in the row above, at column #1 and next to it (a figure may reach
% into the light modules beside it)
\def\fancyqr@xm@figabove#1{\FancyQrFigureAt{\the\numexpr\i-\@ne}{\the\numexpr#1-\@ne}%
   \FancyQrFigureAt{\the\numexpr\i-\@ne}{#1}\FancyQrFigureAt{\the\numexpr\i-\@ne}{\the\numexpr#1+\@ne}}%
% as in `snow', but a lone round top gets a crescent that hugs it, and an end
% next to a tile without snow (near a figure or in a timing pattern) tapers off
% over the module
\def\fancyqr@xm@snowcap{\ifnum\@up\ifnum\i=\@ne1\fi=\z@\fancyqr@snow@run{\the\i}{\the\j}\iffancyqr@snow@
   \edef\fancyqr@snow@fl{\fancyqr@xm@end{\the\numexpr\j-\@ne}\@left}%
   \edef\fancyqr@snow@fr{\fancyqr@xm@end{\the\numexpr\j+\@ne}\@right}%
   \ifnum\fancyqr@snow@fl\fancyqr@snow@fr=11 \fancyqr@xm@crescent\else
      \let\fancyqr@snow@one\fancyqr@snow@scale
      \fancyqr@snow@setup1\fancyqr@rounding@factor\fancyqr@snow@fl\fancyqr@snow@fr
      \fancyqr@snow@draw{\the\j}{\the\i}\fi\fi\fi}%
% the end toward column #1, #2 the neighbour there: 1 free, 0 on or at a wall,
% 2 tapered
\def\fancyqr@xm@end#1#2{\ifnum#2=\@ne
   \if\relax\detokenize\expandafter{\expanded{\fancyqr@xm@figabove{#1}}}\relax
   \ifnum\qr@matrixentry\fancyqr@currprint{\the\numexpr\i-\@ne}{#1}=\@ne 0\else
   \ifnum\i=7 \fancyqr@between{#1}\@max@x\else\ifnum#1=7 \fancyqr@between\i\@max@y\else0\fi\fi\fi
   \else2\fi\else1\fi}%
\def\fancyqr@snow@wave@at#1#2#3{\ifcase#1
      \edef\fancyqr@snow@h{\fancyqr@snow@wave*\fancyqr@snow@sin{23*#2+17*#3}}%
      \edef\fancyqr@snow@s{2.3*\fancyqr@snow@wave*\fancyqr@snow@sin{23*#2+17*#3+16}}%
   \or\def\fancyqr@snow@h{0}\def\fancyqr@snow@s{0}%
   \else\edef\fancyqr@snow@h{-\fancyqr@snow@height}\def\fancyqr@snow@s{0}\fi}%
% the crescent rises tangent from the round top at 30 and 150 degrees
\def\fancyqr@xm@crescent{{\unitlength\qr@modulesize
   \fancyqr@xm@D{cr\fancyqr@snow@scale/\fancyqr@snow@height}{%
      \edef\h@r{\fpeval{.5*\fancyqr@snow@scale}}\edef\h@t{\fpeval{2*\h@r+.6*\fancyqr@snow@height}}%
      \def\h@u{\M({1.866*\h@r},{1.5*\h@r})\C({1.866*\h@r-.12},{1.5*\h@r+.208})(1.45*\h@r,\h@t)(\h@r,\h@t)%
         \C(.55*\h@r,\h@t)({.134*\h@r+.12},{1.5*\h@r+.208})({.134*\h@r},{1.5*\h@r})}}{%
   \noexpand\color{\noexpand\fancyqr@snow@color}\h@u\A(\h@r,\h@r){\h@r}{150}{30}\Z\F
   \noexpand\color{\noexpand\fancyqr@snow@line}\T{.05}\R\h@u\S}}}%
% decorations in white modules that no figure, pattern or timing line takes: a
% light chain sagging across a white gap of up to four modules between two
% tiles, one draped over the top of a horizontal run of dark tiles, and, in open
% white, a glowing star, a snowflake or a candle on holly; all of them stay in
% their modules, off the module centers, in pale colors, and vary by position
% and seed
\def\fancyqr@xm@at#1#2{\qr@matrixentry\fancyqr@currprint{\the\numexpr#1}{\the\numexpr#2}}%
\def\fancyqr@xm@fr#1#2{\ifcsname fancyqr@B@\the\numexpr#1@\the\numexpr#2\endcsname0\else
   \ifcsname fancyqr@F@\the\numexpr#1@\the\numexpr#2\endcsname0\else1\fi\fi}%
% 1 if (#1,#2) is a free module of color #3 (0 white, 1 dark) off the timing lines
\def\fancyqr@xm@m#1#2#3{\ifnum\numexpr#1\relax=7 0\else\ifnum\numexpr#2\relax=7 0\else
   \ifnum\fancyqr@xm@at{#1}{#2}=#3 \fancyqr@xm@fr{#1}{#2}\else0\fi\fi\fi}%
\def\fancyqr@xm@lt#1#2{\ifnum#1<#2 1\else0\fi}%
% which of the three small decorations a module gets: by its place, in the gallery
% always the one shown
\def\fancyqr@xm@kind{\iffancyqr@faint@\ifx\fancyqr@gal@e\fancyqr@xm@kS 0\else
   \ifx\fancyqr@gal@e\fancyqr@xm@kF 1\else\ifx\fancyqr@gal@e\fancyqr@xm@kC 2\else\numexpr\fancyqr@xm@h-3*((\fancyqr@xm@h-1)/3)\fi\fi\fi
   \else\numexpr\fancyqr@xm@h-3*((\fancyqr@xm@h-1)/3)\fi\relax}%
\def\fancyqr@xm@kS{stars}\def\fancyqr@xm@kF{snowflakes}\def\fancyqr@xm@kC{candles}%
\def\fancyqr@xm@th#1{\iffancyqr@faint@101\else#1\fi}%
% the white run from here to the right (at most 6), its modules free above and
% below
\def\fancyqr@xm@scan#1{\ifnum\fancyqr@xm@c<6 \ifnum\numexpr\@tempcntb+\fancyqr@xm@c\relax<\@max@x
   \ifnum\numexpr#1{\@tempcnta}{\@tempcntb+\fancyqr@xm@c}\relax=\@ne\edef\fancyqr@xm@c{\the\numexpr\fancyqr@xm@c+1}\fancyqr@xm@scan#1\fi\fi\fi}%
\def\fancyqr@xm@cw#1#2{\fancyqr@xm@m{#1}{#2}0*\fancyqr@xm@fr{#1-1}{#2}*\fancyqr@xm@fr{#1+1}{#2}}%
\def\fancyqr@xm@decor{{\unitlength\qr@modulesize
   \iffancyqr@faint@\else\blendcolors{!\fancyqr@xm@opacity!\ifx\fancyqr@background\@empty white\else\fancyqr@background\fi}\fi
   \edef\fancyqr@xm@salt{\csname int_rand:nn\endcsname{0}{99}}%
   \@tempcnta\@ne\@whilenum\@tempcnta<\numexpr\@max@y-1\relax\do{\advance\@tempcnta\@ne
   \@tempcntb\@ne\@whilenum\@tempcntb<\numexpr\@max@x-1\relax\do{\advance\@tempcntb\@ne
      \ifnum\fancyqr@xm@m\@tempcnta\@tempcntb0=\@ne\fancyqr@xm@one\fi}}}}%
\def\fancyqr@xm@one{%
   \count@\numexpr\@tempcnta*131+\@tempcntb*71+\@tempcnta*\@tempcntb*17+\fancyqr@xm@salt\relax
   \count@\numexpr\count@-100*((\count@-50)/100)\relax
   \edef\fancyqr@xm@h{\the\numexpr\@tempcnta*37+\@tempcntb*91+\@tempcnta*\@tempcntb*7+3*\fancyqr@xm@salt\relax}%
   \edef\fancyqr@xm@h{\the\numexpr\fancyqr@xm@h-100*((\fancyqr@xm@h-50)/100)\relax}%
   \def\fancyqr@xm@c{0}\fancyqr@xm@scan\fancyqr@xm@cw\edef\fancyqr@xm@l{\fancyqr@xm@c}%
   \def\fancyqr@xm@put{\put(\the\@tempcntb,\the\numexpr\@max@y-\@tempcnta\relax)}%
   \ifnum\numexpr\fancyqr@xm@m\@tempcnta{\@tempcntb-1}1*\fancyqr@xm@m\@tempcnta{\@tempcntb+\fancyqr@xm@l}1%
         *\fancyqr@xm@lt{\fancyqr@xm@l}5*\fancyqr@xm@lt\count@{\fancyqr@xm@th{30}}\relax=\@ne
      \fancyqr@xm@put{\FancyQrExtra{lights}{\fancyqr@xm@swag{\fancyqr@xm@l}{.84}{\fpeval{.1+.04*\fancyqr@xm@l}}{\the\numexpr2*\fancyqr@xm@l}0}}%
   \else\ifnum\numexpr\fancyqr@xm@m\@tempcnta\@tempcntb0*\fancyqr@xm@lt\count@{\fancyqr@xm@th{34}}%
         *\fancyqr@xm@m{\@tempcnta-1}\@tempcntb0*\fancyqr@xm@m{\@tempcnta+1}\@tempcntb0%
         *\fancyqr@xm@m\@tempcnta{\@tempcntb-1}0*\fancyqr@xm@m\@tempcnta{\@tempcntb+1}0\relax=\@ne
      \ifcase\fancyqr@xm@kind
         \fancyqr@xm@put{\FancyQrExtra{stars}\fancyqr@xm@star}\or
         \fancyqr@xm@put{\FancyQrExtra{snowflakes}\fancyqr@xm@flake}\or
         \fancyqr@xm@put{\FancyQrExtra{candles}\fancyqr@xm@candle}\fi
   \fi\fi}%
\def\fancyqr@xm@opacity{45}%
\def\fancyqr@xm@mv#1#2{\moveto(\fpeval{#1},\fpeval{#2})}%
\def\fancyqr@xm@ln#1#2{\lineto(\fpeval{#1},\fpeval{#2})}%
\def\fancyqr@xm@cu#1#2#3#4#5#6{\curveto(\fpeval{#1},\fpeval{#2})(\fpeval{#3},\fpeval{#4})(\fpeval{#5},\fpeval{#6})}%
\def\fancyqr@xm@dc#1#2#3{\moveto(\fpeval{#1+#3},\fpeval{#2})\circlearc{\fpeval{#1}}{\fpeval{#2}}{\fpeval{#3}}{0}{360}}%
\def\fancyqr@xm@disc#1#2#3#4{\fancyqr@mixcolor{#4}\fancyqr@xm@dc{#1}{#2}{#3}\fillpath}%
% a soft glow: discs of the color #4 with more of the warm light toward the middle
\def\fancyqr@xm@glow#1#2#3#4{\fancyqr@xm@disc{#1}{#2}{#3}{#4!9!fancyqr@xm@halo}%
   \fancyqr@xm@disc{#1}{#2}{.72*#3}{#4!18!fancyqr@xm@halo}\fancyqr@xm@disc{#1}{#2}{.46*#3}{#4!30!fancyqr@xm@halo}}%
% a chain of length #1 from height #2, sagging by #3, with #4 bulbs (the
% colors by the place and #5)
\def\fancyqr@xm@swag#1#2#3#4#5{{\fancyqr@mixcolor{fancyqr@xm@wire}\linethickness{.04\unitlength}\roundcap
   \fancyqr@xm@mv0{#2}\fancyqr@xm@cu{.3*#1}{#2-#3}{.7*#1}{#2-#3}{#1}{#2}\strokepath}%
   \@for\@tempa:=1,2,3,4,5,6,7,8\do{\ifnum\@tempa>#4 \else
      \edef\@tempb{\fpeval{\@tempa/(#4+1)}}%
      \fancyqr@xm@lamp{#1*(.9*(1-\@tempb)^2*\@tempb+2.1*(1-\@tempb)*\@tempb^2+\@tempb^3)}{#2-3*#3*\@tempb*(1-\@tempb)}%
         {\numexpr\count@+#5+\@tempa\relax}\fi}}%
\def\fancyqr@xm@lamp#1#2#3{{\edef\@tempc{fancyqr@xm@b\ifcase\numexpr#3-5*((#3-2)/5)\relax Y\or R\or B\or G\else O\fi}%
   \fancyqr@xm@glow{#1}{#2-.11}{.16}\@tempc
   \fancyqr@mixcolor{fancyqr@xm@gold}\fancyqr@xm@mv{#1-.03}{#2}\fancyqr@xm@ln{#1+.03}{#2}%
      \fancyqr@xm@ln{#1+.03}{#2-.05}\fancyqr@xm@ln{#1-.03}{#2-.05}\closepath\fillpath
   \fancyqr@xm@disc{#1}{#2-.11}{.075}\@tempc
   \fancyqr@xm@disc{#1-.025}{#2-.09}{.022}{white}}}%
\def\fancyqr@xm@star{{\fancyqr@xm@glow{.5}{.5}{.49}{fancyqr@xm@gold}%
   \edef\fancyqr@xm@rot{\fpeval{.3*\fancyqr@xm@h}}%
   \edef\fancyqr@xm@pn{\ifcase\numexpr\fancyqr@xm@h-3*((\fancyqr@xm@h-1)/3)\relax 5\or4\else8\fi}%
   \edef\fancyqr@xm@pi{\ifnum\fancyqr@xm@pn=4 .1\else\ifnum\fancyqr@xm@pn=8 .19\else.15\fi\fi}%
   \fancyqr@mixcolor{fancyqr@xm@spark}\fancyqr@xm@poly\fillpath
   \fancyqr@mixcolor{fancyqr@xm@deepgold}\linethickness{.04\unitlength}\roundjoin\fancyqr@xm@poly\strokepath}}%
% a star of \fancyqr@xm@pn points, the inner radius \fancyqr@xm@pi
\def\fancyqr@xm@poly{\fancyqr@xm@mv{.5+.36*sind(\fancyqr@xm@rot)}{.5+.36*cosd(\fancyqr@xm@rot)}%
   \@tempcnta\z@\@whilenum\@tempcnta<\numexpr2*\fancyqr@xm@pn-1\relax\do{\advance\@tempcnta\@ne
      \fancyqr@xm@ln{.5+(\ifodd\@tempcnta\fancyqr@xm@pi\else.36\fi)*sind(180/\fancyqr@xm@pn*\the\@tempcnta+\fancyqr@xm@rot)}%
      {.5+(\ifodd\@tempcnta\fancyqr@xm@pi\else.36\fi)*cosd(180/\fancyqr@xm@pn*\the\@tempcnta+\fancyqr@xm@rot)}}\closepath}%
\def\fancyqr@xm@flake{{\fancyqr@mixcolor{fancyqr@xm@ice}\linethickness{.05\unitlength}\roundcap
   \edef\fancyqr@xm@rot{\fpeval{.3*\fancyqr@xm@h}}%
   \edef\fancyqr@xm@fv{\the\numexpr\fancyqr@xm@h/3-3*((\fancyqr@xm@h/3-1)/3)\relax}%
   \@for\@tempa:=0,1,2,3,4,5\do{\edef\@tempb{\fpeval{60*\@tempa+\fancyqr@xm@rot}}%
      \fancyqr@xm@mv{.5+.14*cosd(\@tempb)}{.5+.14*sind(\@tempb)}\fancyqr@xm@ln{.5+.44*cosd(\@tempb)}{.5+.44*sind(\@tempb)}%
      \ifcase\fancyqr@xm@fv\fancyqr@xm@fk{\@tempb}{.27}{.14}\fancyqr@xm@fk{\@tempb}{.27}{-.14}%
      \or\fancyqr@xm@fk{\@tempb}{.36}{.1}\fancyqr@xm@fk{\@tempb}{.36}{-.1}\fancyqr@xm@fk{\@tempb}{.22}{.1}\fancyqr@xm@fk{\@tempb}{.22}{-.1}\fi
      \strokepath\ifnum\fancyqr@xm@fv>\@ne\fancyqr@xm@dc{.5+.44*cosd(\@tempb)}{.5+.44*sind(\@tempb)}{.04}\fillpath\fi}}}%
\def\fancyqr@xm@fk#1#2#3{\fancyqr@xm@mv{.5+#2*cosd(#1)}{.5+#2*sind(#1)}%
   \fancyqr@xm@ln{.5+#2*cosd(#1)+.12*cosd(#1+(#3)*400)}{.5+#2*sind(#1)+.12*sind(#1+(#3)*400)}}%
\def\fancyqr@xm@candle{{\fancyqr@xm@glow{.5}{.78}{.21}{fancyqr@xm@flame}%
   \fancyqr@mixcolor{fancyqr@xm@pine}\moveto(.5,.17)\curveto(.4,.32)(.1,.26)(.08,.1)\curveto(.3,.03)(.45,.08)(.5,.17)\closepath\fillpath
   \moveto(.5,.17)\curveto(.6,.32)(.9,.26)(.92,.1)\curveto(.7,.03)(.55,.08)(.5,.17)\closepath\fillpath
   \edef\fancyqr@xm@cv{\the\numexpr\fancyqr@xm@h/9-3*((\fancyqr@xm@h/9-1)/3)\relax}%
   \fancyqr@mixcolor{fancyqr@xm@\ifcase\fancyqr@xm@cv cream\or red\else gold\fi}%
      \moveto(.41,.12)\lineto(.59,.12)\lineto(.59,.62)\lineto(.41,.62)\closepath\fillpath
   \fancyqr@mixcolor{fancyqr@xm@\ifcase\fancyqr@xm@cv berry\or cream\else red\fi}%
      \moveto(.41,.2)\lineto(.59,.2)\lineto(.59,.3)\lineto(.41,.3)\closepath\fillpath
   \fancyqr@xm@disc{.34}{.12}{.045}{fancyqr@xm@red}\fancyqr@xm@disc{.66}{.12}{.045}{fancyqr@xm@red}%
   \fancyqr@mixcolor{fancyqr@xm@flame}\moveto(.5,.92)\curveto(.6,.83)(.63,.76)(.5,.67)\curveto(.37,.76)(.4,.83)(.5,.92)\closepath\fillpath
   \fancyqr@mixcolor{fancyqr@xm@spark}\moveto(.5,.84)\curveto(.55,.79)(.56,.76)(.5,.72)\curveto(.44,.76)(.45,.79)(.5,.84)\closepath\fillpath}}%
\FancyQrExtras{timing,lights,stars,snowflakes,candles}%
% what another style gets with add=christmas
\FancyQrLend{after}{\fancyqr@xm@decor}\FancyQrLend{extras}{lights,stars,snowflakes,candles}%
\FancyQrRoundedPatterns\fancyqr@xm@snowtile
\FancyQrInnerRoundings
\FancyQrStyleSet{%
   r color=fancyqr@xm@teal,l color=fancyqr@xm@pine,%
   finder=rounded,finder core=circle,%
   finder core color=fancyqr@xm@berry%
}%
