   \K{gold}\B(2.12,.26)(2.18,.64)\B(2.64,.26)(2.7,.64)\F
   \K{coal}\B(1.36,.84)(1.98,.94)\B(1.28,.3)(1.44,.36)\M(2.48,.62)\L(2.62,.62)\L(2.68,.88)\L(2.42,.88)\Z
   \M(2.8,.3)\L(2.95,.08)\L(2.72,.08)\Z\O(.38,.17){.13}\O(.98,.17){.13}\O(1.62,.17){.13}%
