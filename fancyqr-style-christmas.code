   \fancyqr@xm@D{soldier\fancyqr@xm@v}{\def\h@c{\ifodd\fancyqr@xm@v\space teal\else red\fi}}{%
   \K\h@c\M(.25,.2)\L(.75,.2)\L(.78,-.46)\L(.22,-.46)\Z\F\T{.12}\R\M(.21,.12)\L(.19,-.34)\M(.79,.12)\L(.81,-.34)\S
   \K{skin}\E(.5,.29){.15}{.14}\O(.19,-.4){.06}\O(.81,-.4){.06}\F
