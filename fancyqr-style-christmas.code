   \L(.15,.95)\A(.15,.88){.07}{90}{180}\L(.08,.73)\A(.15,.73){.07}{180}{270}\Z
   \ifnum\fancyqr@xm@var{38}4<2 \B(.16,.24)(.84,.34)\B(.16,.02)(.84,.12)\else
   \O(.3,.25){.05}\O(.7,.12){.05}\O(.46,-.06){.05}\O(1.1,-.42){.05}\O(1.32,-.76){.05}\fi\F}}}%
